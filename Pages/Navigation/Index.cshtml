        padding: 4px 2px 0;
    }

    .pm-page-title {
        font-size: 24px;
    }

    .nav-engine-badge {
        min-height: 26px;
        font-size: 8px;
    }

    .navigation-map-shell {
        height: 58dvh;
        min-height: 390px;

        border-radius: 14px;
    }

    .nav-next-overlay {
        top: 58px;

        width: calc(100% - 14px);

        grid-template-columns: 42px minmax(0, 1fr) auto;

        gap: 8px;

        padding: 8px;
    }

    .nav-next-icon {
        width: 42px;
        height: 42px;

        flex-basis: 42px;

        font-size: 22px;
    }

    .nav-next-copy small {
        font-size: 7px;
    }

    .nav-next-copy strong {
        font-size: 13px;
    }

    .nav-next-copy span {
        font-size: 9px;
    }

    #nextInstructionDistance {
        font-size: 11px;
    }

    .nav-map-route-card {
        padding: 10px;
    }

    .nav-map-route-card-head strong {
        font-size: 12px;
    }

    .nav-map-route-stats strong {
        font-size: 10px;
    }

    .nav-map-route-stats span {
        font-size: 7px;
    }

    .nav-control-card {
        padding: 12px;
    }

    .nav-control-card-header h2 {
        font-size: 15px;
    }

    .nav-map-pick-row {
        grid-template-columns: 1fr;
    }

    .nav-result-distance strong {
        font-size: 22px;
    }

    .nav-summary-grid {
        grid-template-columns: 1fr 1fr;
    }

    .nav-summary-grid > div:last-child {
        grid-column: 1 / -1;
    }

    .nav-diagnostics-grid {
        grid-template-columns: 1fr 1fr;
    }
