                    setResolvedUi(
                        els.startResolved,
                        true,
                        "Izabrano sa mape"
                    );

                } else {

                    state.destination = point;
                    state.destinationResolved = true;

                    els.end.value =
                        point.label;

                    setResolvedUi(
                        els.endResolved,
                        true,
                        "Izabrano sa mape"
                    );
