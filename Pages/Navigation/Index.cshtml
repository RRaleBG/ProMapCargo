            /*
             * ============================================================
             * ROUTING
             * ============================================================
             */

            async function calculateRoute() {

                if (state.isRouting) {
                    return;
                }


                hideError();


                if (
                    !state.startResolved ||
                    !state.destinationResolved
                ) {

                    showError(
                        "Start i odredište moraju biti potvrđeni. Izaberite rezultat iz geocoding liste ili kliknite tačke na mapi."
                    );

                    return;
                }


                if (
                    !validPoint(state.start) ||
                    !validPoint(state.destination)
                ) {

                    showError(
                        "Start i odredište moraju sadržati validne geografske koordinate."
                    );

                    return;
                }


                if (
                    samePoint(
                        state.start,
                        state.destination
                    )
                ) {

                    showError(
                        "Start i odredište ne mogu biti ista lokacija."
                    );

                    return;
                }


                const request =
                    buildRouteRequest();


                state.isRouting = true;

                setRoutingUi(true);


                try {

                    const response =
                        await fetch(
                            "/api/route",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json",
                                    "Accept":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify(
                                        request
                                    )
                            }
                        );


                    const payload =
                        await response.json()
                            .catch(
                                () => ({})
                            );


                    if (!response.ok) {

                        const message =
                            payload.message ??
                            payload.title ??
                            `Routing API HTTP ${response.status}`;

                        throw new Error(
                            message
                        );
                    }


                    if (
                        !payload ||
                        payload.code &&
                        String(payload.code)
                            .toLowerCase() !== "ok"
                    ) {

                        throw new Error(
                            payload.message ??
                            "Routing servis nije pronašao rutu."
                        );
                    }


                    if (
                        !Array.isArray(
                            payload.routes
                        ) ||
                        payload.routes.length === 0
                    ) {

                        throw new Error(
                            "Routing servis nije vratio nijednu rutu."
                        );
                    }


                    state.routeResponse =
                        payload;


                    state.selectedRouteIndex =
                        Number.isInteger(
                            payload.selectedRouteIndex
                        )
                            ? payload.selectedRouteIndex
                            : 0;


                    renderRouteResponse();


                } catch (error) {

                    console.error(
                        "Navigation routing error:",
                        error
                    );


                    clearRouteVisuals();


                    updateEngineUi(
                        "ERROR"
                    );


                    showError(
                        formatRoutingError(
                            error
                        )
                    );


                } finally {

                    state.isRouting = false;

                    setRoutingUi(false);
                }
            }


            function buildRouteRequest() {

                const request = {

                    start: {
                        latitude: state.start.lat,
                        longitude: state.start.lon
                    },

                    destination: {
                        latitude: state.destination.lat,
                        longitude: state.destination.lon
                    },

                    profile:
                        state.profile,

                    avoidRestricted:
                        Boolean(
                            els.avoid.checked
                        ),

                    departureAt:
                        new Date().toISOString()
                };


                if (
                    state.profile === "truck"
                ) {

                    request.truck = {

                        grossWeightT:
                            numberValue(
                                els.weight,
                                40
                            ),

                        heightM:
                            numberValue(
                                els.height,
                                4
                            ),

                        widthM:
                            numberValue(
                                els.width,
                                2.55
                            ),

                        lengthM:
                            numberValue(
                                els.length,
                                16.5
                            ),

                        axleLoadT:
                            numberValue(
                                els.axleLoad,
                                10
                            ),

                        axles:
                            integerValue(
                                els.axles,
                                5
                            ),

                        maxSpeedKmh:
                            numberValue(
                                els.maxSpeed,
                                90
                            ),

                        commercial:
                            true,

                        isHgv:
                            true,

                        hazmat:
                            Boolean(
                                els.hazmat.checked
                            ),

                        adrClass:
                            els.adrClass.value.trim() ||
                            null,

                        vehicleClass:
                            "HeavyGoods"
                    };
                }


                return request;
            }


            function renderRouteResponse() {

                clearRouteVisuals();


                const response =
                    state.routeResponse;


                const routes =
                    response.routes ?? [];


                if (!routes.length) {
                    return;
                }


                const selected =
                    clamp(
                        state.selectedRouteIndex,
                        0,
                        routes.length - 1
                    );


                state.selectedRouteIndex =
                    selected;


                routes.forEach(
                    (route, index) => {

                        const layer =
                            createRouteLayer(
                                route,
                                index === selected
                            );

                        if (layer) {

                            layer.addTo(
                                state.map
                            );

                            state.routeLayers.push(
                                layer
                            );
                        }
                    }
                );


                drawPointMarkers();


                const activeRoute =
                    routes[selected];


                renderSummary(
                    activeRoute,
                    response
                );


                renderAlternatives(
                    routes,
                    selected
                );


                renderWarnings(
                    response
                );


                renderManeuvers(
                    response.maneuvers
                );


                renderDiagnostics(
                    response
                );


                renderMapSummary(
                    activeRoute,
                    response
                );


                renderNextInstruction(
                    response.maneuvers
                );


                updateEngineUi(
                    response.diagnostics?.engine ??
                    "POSTGIS"
                );


                fitRoute();


                if (
                    state.currentPosition
                ) {
                    updateOffRouteState();
                }
            }


            function createRouteLayer(
                route,
                selected
            ) {

                const geometry =
                    route?.geometry;


                if (!geometry) {
                    return null;
                }


                try {

                    const geoJson =
                        normalizeGeoJson(
                            geometry
                        );


                    if (!geoJson) {
                        return null;
                    }


                    const layer =
                        L.geoJSON(
                            geoJson,
                            {
                                style: {

                                    color:
                                        selected
                                            ? "#061b16"
                                            : "#4b8175",

                                    weight:
                                        selected
                                            ? 11
                                            : 7,

                                    opacity:
                                        selected
                                            ? .90
                                            : .30,

                                    lineCap: "round",
                                    lineJoin: "round"
                                }
                            }
                        );


                    if (selected) {

                        const activeLayer =
                            L.geoJSON(
                                geoJson,
                                {
                                    style: {

                                        color:
                                            "#2dd4bf",

                                        weight:
                                            6,

                                        opacity:
                                            1,

                                        lineCap:
                                            "round",

                                        lineJoin:
                                            "round"
                                    }
                                }
                            );


                        const glowLayer =
                            L.geoJSON(
                                geoJson,
                                {
                                    style: {

                                        color:
                                            "#10b981",

                                        weight:
                                            12,

                                        opacity:
                                            .18,

                                        lineCap:
                                            "round",

                                        lineJoin:
                                            "round"
                                    }
                                }
                            );


                        const group =
                            L.layerGroup([
                                glowLayer,
                                layer,
                                activeLayer
                            ]);


                        return group;
                    }


                    return layer;

                } catch (error) {

                    console.warn(
                        "Route geometry error:",
                        error
                    );

                    return null;
                }
            }


            function normalizeGeoJson(
                geometry
            ) {

                if (!geometry) {
                    return null;
                }


                if (
                    geometry.type &&
                    geometry.coordinates
                ) {

                    return geometry;
                }


                if (
                    geometry.geojson
                ) {

                    return geometry.geojson;
                }


                if (
                    geometry.geometry
                ) {

                    return geometry.geometry;
                }


                return null;
            }


            function clearRouteVisuals() {

                if (!state.map) {
                    return;
                }


                state.routeLayers.forEach(
                    layer => {

                        try {
                            state.map.removeLayer(
                                layer
                            );
                        } catch {
                        }
                    }
                );


                state.routeLayers = [];


                els.mapRouteCard.hidden =
                    true;

                els.nextInstruction.hidden =
                    true;
            }


            /*
             * ============================================================
             * SUMMARY
             * ============================================================
             */

            function renderSummary(
                route,
                response
            ) {

                const distance =
                    Number(
                        route.distance ??
                        0
                    );


                const duration =
                    Number(
                        route.duration ??
                        0
                    );


                els.summaryDistance.textContent =
                    formatDistance(
                        distance
                    );


                els.summaryDuration.textContent =
                    formatDuration(
                        duration
                    );


                const eta =
                    response.summary?.estimatedArrival ??
                    calculateEta(
                        duration
                    );


                els.summaryEta.textContent =
                    formatEta(
                        eta
                    );


                const safe =
                    Boolean(
                        response.isTruckSafe
                    );


                els.summarySafety.className =
                    safe
                        ? "pm-badge pm-badge-success"
                        : "pm-badge pm-badge-danger";


                els.summarySafety.innerHTML =
                    safe
                        ? "✓ SAFE"
                        : "⚠ WARNING";


                els.summaryEngine.textContent =
                    response.diagnostics?.engine ??
                    "PostGIS";


                const violationCount =
                    Array.isArray(
                        response.violations
                    )
                        ? response.violations.length
                        : 0;


                els.summaryDiagnostics.textContent =
                    violationCount === 0
                        ? "0"
                        : String(
                            violationCount
                        );
            }


            function renderMapSummary(
                route,
                response
            ) {

                const distance =
                    Number(
                        route.distance ??
                        0
                    );


                const duration =
                    Number(
                        route.duration ??
                        0
                    );


                els.mapRouteTitle.textContent =
                    `${state.start.label} → ${state.destination.label}`;


                els.mapDistance.textContent =
                    formatDistance(
                        distance
                    );


                els.mapDuration.textContent =
                    formatDuration(
                        duration
                    );


                const eta =
                    response.summary?.estimatedArrival ??
                    calculateEta(
                        duration
                    );


                els.mapEta.textContent =
                    formatEta(
                        eta
                    );


                const safe =
                    Boolean(
                        response.isTruckSafe
                    );


                els.mapRouteStatus.className =
                    safe
                        ? "pm-badge pm-badge-success"
                        : "pm-badge pm-badge-danger";


                els.mapRouteStatus.textContent =
                    safe
                        ? "Bezbedna"
                        : "Restrikcije";


                els.mapRouteCard.hidden =
                    false;


                els.routeSafeBadge.textContent =
                    safe
                        ? "TRUCK SAFE"
                        : "TRUCK WARNING";


                const mapEngine =
                    els.routeSafeBadge
                        .closest(
                            ".nav-map-engine"
                        );


                if (mapEngine) {

                    mapEngine.classList.toggle(
                        "danger",
                        !safe
                    );
                }
            }


            /*
             * ============================================================
             * ALTERNATIVES
             * ============================================================
             */

            function renderAlternatives(
                routes,
                selected
            ) {

                els.routeAlternatives.innerHTML = "";


                els.alternativeCount.textContent =
                    String(
                        routes.length
                    );


                routes.forEach(
                    (route, index) => {

                        const button =
                            document.createElement(
                                "button"
                            );


                        button.type = "button";

                        button.className =
                            "nav-alternative" +
                            (
                                index === selected
                                    ? " active"
                                    : ""
                            );


                        button.innerHTML = `

                            <span class="nav-alternative-index">
                                ${index + 1}
                            </span>

                            <span>
                                <strong>
                                    ${index === selected
                                ? "Preporučena ruta"
                                : "Alternativa " + index}
                                </strong>

                                <small>
                                    ${formatDuration(
                                    Number(
                                        route.duration ?? 0
                                    )
                                )}
                                </small>
                            </span>

                            <span class="nav-alternative-distance">
                                ${formatDistance(
                                    Number(
                                        route.distance ?? 0
                                    )
                                )}
                            </span>
                        `;


                        button.addEventListener(
                            "click",
                            () => {

                                selectRoute(
                                    index
                                );
                            }
                        );


                        els.routeAlternatives
                            .appendChild(
                                button
                            );
                    }
                );


                els.alternativesCard.hidden =
                    routes.length <= 1;
            }


            function selectRoute(
                index
            ) {

                const routes =
                    state.routeResponse?.routes ??
                    [];


                if (
                    index < 0 ||
                    index >= routes.length
                ) {
                    return;
                }


                state.selectedRouteIndex =
                    index;


                renderRouteResponse();
            }


            /*
             * ============================================================
             * WARNINGS
             * ============================================================
             */

            function renderWarnings(
                response
            ) {

                const warnings =
                    Array.isArray(
                        response.violations
                    )
                        ? response.violations
                        : [];


                els.routeWarnings.innerHTML = "";


                els.warningCount.textContent =
                    String(
                        warnings.length
                    );


                warnings.forEach(
                    warning => {

                        const item =
                            document.createElement(
                                "div"
                            );


                        item.className =
                            "nav-warning " +
                            (
                                warning.type ===
                                    "Danger"
                                    ? "danger"
                                    : ""
                            );


                        item.innerHTML = `

                            <div class="nav-warning-icon">
                                ${warning.type === "Danger"
                                ? "!"
                                : "△"}
                            </div>

                            <div>
                                <strong>
                                    ${escapeHtml(
                                    warning.name ??
                                    warning.id ??
                                    "Ograničenje"
                                )}
                                </strong>

                                <small>
                                    ${escapeHtml(
                                    warning.reason ??
                                    warning.type ??
                                    "Ograničenje na ruti"
                                )}
                                </small>
                            </div>
                        `;


                        els.routeWarnings.appendChild(
                            item
                        );
                    }
                );


                els.warningsCard.hidden =
                    warnings.length === 0;
            }


            /*
             * ============================================================
             * MANEUVERS
             * ============================================================
             */

            function renderManeuvers(
                maneuvers
            ) {

                if (
                    !Array.isArray(
                        maneuvers
                    )
                ) {

                    els.maneuversCard.hidden =
                        true;

                    return;
                }


                els.maneuverList.innerHTML =
                    "";


                els.maneuverCount.textContent =
                    String(
                        maneuvers.length
                    );


                maneuvers
                    .slice(
                        0,
                        30
                    )
                    .forEach(
                        (maneuver, index) => {

                            const item =
                                document.createElement(
                                    "div"
                                );


                            item.className =
                                "nav-maneuver";


                            item.innerHTML = `

                                <div class="nav-maneuver-icon">
                                    ${maneuverIcon(
                                maneuver.type
                            )}
                                </div>

                                <div>
                                    <strong>
                                        ${escapeHtml(
                                maneuver.instruction ??
                                "Nastavite rutom"
                            )}
                                    </strong>

                                    <small>
                                        ${escapeHtml(
                                maneuver.roadName ??
                                maneuver.roadRef ??
                                ""
                            )}
                                    </small>
                                </div>

                                <div class="nav-maneuver-distance">
                                    ${formatDistance(
                                Number(
                                    maneuver.distanceFromPreviousMeters ??
                                    0
                                )
                            )}
                                </div>

                            `;


                            els.maneuverList.appendChild(
                                item
                            );
                        }
                    );


                els.maneuversCard.hidden =
                    maneuvers.length === 0;
            }


            function renderNextInstruction(
                maneuvers
            ) {

                if (
                    !Array.isArray(
                        maneuvers
                    ) ||
                    !maneuvers.length
                ) {

                    els.nextInstruction.hidden =
                        true;

                    return;
                }


                const next =
                    maneuvers[0];


                els.nextInstructionIcon.textContent =
                    maneuverIcon(
                        next.type
                    );


                els.nextInstructionText.textContent =
                    next.instruction ??
                    "Nastavite rutom";


                els.nextInstructionDistance.textContent =
                    formatDistance(
                        Number(
                            next.distanceFromPreviousMeters ??
                            0
                        )
                    );


                els.nextInstruction.hidden =
                    false;
            }


            function maneuverIcon(
                type
            ) {

                const value =
                    String(
                        type ?? ""
                    ).toLowerCase();


                if (
                    value.includes("left")
                ) {
                    return "↰";
                }

                if (
                    value.includes("right")
                ) {
                    return "↱";
                }

                if (
                    value.includes("uturn") ||
                    value.includes("u-turn")
                ) {
                    return "↶";
                }

                if (
                    value.includes("roundabout")
                ) {
                    return "⟳";
                }

                if (
                    value.includes("destination")
                ) {
                    return "◎";
                }

                return "↑";
            }


            /*
             * ============================================================
             * DIAGNOSTICS
             * ============================================================
             */

            function renderDiagnostics(
                response
            ) {

                const diagnostics =
                    response.diagnostics ??
                    {};


                els.diagnosticEngine.textContent =
                    diagnostics.engine ??
                    "—";


                els.diagnosticGraph.textContent =
                    diagnostics.graphVersion ??
                    "—";


                els.diagnosticStates.textContent =
                    diagnostics.expandedStates ??
                    "—";


                els.diagnosticFallback.textContent =
                    diagnostics.usedFallback
                        ? "YES"
                        : "NO";
            }


            /*
             * ============================================================
             * GPS
             * ============================================================
             */

            function useCurrentLocation() {

                if (
                    !navigator.geolocation
                ) {

                    showError(
                        "Ovaj browser ne podržava GPS geolocation."
                    );

                    return;
                }


                navigator.geolocation.getCurrentPosition(
                    position => {

                        setCurrentPosition(
                            position
                        );


                        state.start = {
                            lat:
                                position.coords.latitude,
                            lon:
                                position.coords.longitude,
                            label:
                                "Moja trenutna lokacija"
                        };


                        state.startResolved =
                            true;


                        els.start.value =
                            state.start.label;


                        setResolvedUi(
                            els.startResolved,
                            true,
                            `${state.start.lat.toFixed(5)}, ${state.start.lon.toFixed(5)}`
                        );


                        drawPointMarkers();


                        state.map.setView(
                            [
                                state.start.lat,
                                state.start.lon
                            ],
                            14
                        );


                        showError(
                            "Trenutna GPS lokacija je postavljena kao start.",
                            false
                        );


                        if (
                            state.destinationResolved
                        ) {
                            calculateRoute();
                        }
                    },

                    error => {

                        showError(
                            gpsErrorMessage(
                                error
                            )
                        );
                    },

                    {
                        enableHighAccuracy:
                            true,

                        timeout:
                            15000,

                        maximumAge:
                            5000
                    }
                );
            }


            function startLiveNavigation() {

                if (
                    !navigator.geolocation
                ) {

                    showError(
                        "GPS nije podržan u ovom browseru."
                    );

                    return;
                }


                if (
                    state.liveNavigation
                ) {
                    return;
                }


                state.liveNavigation =
                    true;


                updateGpsUi(
                    true
                );


                state.watchId =
                    navigator.geolocation.watchPosition(
                        position => {

                            setCurrentPosition(
                                position
                            );

                            updateOffRouteState();
                        },

                        error => {

                            console.warn(
                                "GPS watch error:",
                                error
                            );


                            showError(
                                gpsErrorMessage(
                                    error
                                )
                            );
                        },

                        {
                            enableHighAccuracy:
                                true,

                            timeout:
                                15000,

                            maximumAge:
                                2000
                        }
                    );


                els.startLiveNavigation.hidden =
                    true;

                els.stopLiveNavigation.hidden =
                    false;
            }


            function stopLiveNavigation() {

                state.liveNavigation =
                    false;


                if (
                    state.watchId !== null
                ) {

                    navigator.geolocation.clearWatch(
                        state.watchId
                    );

                    state.watchId =
                        null;
                }


                updateGpsUi(
                    false
                );


                els.startLiveNavigation.hidden =
                    false;

                els.stopLiveNavigation.hidden =
                    true;
            }


            function setCurrentPosition(
                position
            ) {

                const coords =
                    position.coords;


                state.currentPosition = {

                    lat:
                        coords.latitude,

                    lon:
                        coords.longitude,

                    accuracy:
                        coords.accuracy,

                    speed:
                        Number.isFinite(
                            coords.speed
                        )
                            ? coords.speed * 3.6
                            : null,

                    heading:
                        coords.heading
                };


                updatePositionMarker();

                updateGpsUi(
                    state.liveNavigation
                );


                if (
                    state.liveNavigation
                ) {

                    maybeReroute();
                }
            }


            function updatePositionMarker() {

                if (
                    !state.currentPosition
                ) {
                    return;
                }


                const latlng =
                    [
                        state.currentPosition.lat,
                        state.currentPosition.lon
                    ];


                if (
                    !state.positionMarker
                ) {

                    state.positionMarker =
                        L.marker(
                            latlng,
                            {
                                icon:
                                    createTruckIcon(),
                                zIndexOffset:
                                    1000
                            }
                        ).addTo(
                            state.map
                        );

                } else {

                    state.positionMarker.setLatLng(
                        latlng
                    );
                }
            }


            function updateGpsUi(
                active
            ) {

                els.gpsStatus.textContent =
                    active
                        ? "CONNECTED"
                        : "OFF";


                els.liveChip.classList.toggle(
                    "active",
                    active
                );


                els.liveChip.textContent =
                    active
                        ? "GPS LIVE"
                        : "GPS OFF";


                if (
                    !state.currentPosition
                ) {

                    els.livePosition.textContent =
                        "Lokacija nije aktivna";

                    els.liveAccuracy.textContent =
                        "—";

                    els.liveSpeed.textContent =
                        "0 km/h";

                    return;
                }


                const p =
                    state.currentPosition;


                els.livePosition.textContent =
                    `${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}`;


                els.liveAccuracy.textContent =
                    Number.isFinite(
                        p.accuracy
                    )
                        ? `Preciznost ±${Math.round(p.accuracy)} m`
                        : "Preciznost —";


                els.liveSpeed.textContent =
                    Number.isFinite(
                        p.speed
                    )
                        ? `${Math.round(p.speed)} km/h`
                        : "0 km/h";
            }


            function centerGps() {

                if (
                    !state.currentPosition
                ) {

                    showError(
                        "GPS pozicija još nije dostupna."
                    );

                    return;
                }


                state.map.setView(
                    [
                        state.currentPosition.lat,
                        state.currentPosition.lon
                    ],
                    Math.max(
                        state.map.getZoom(),
                        15
                    ),
                    {
                        animate: true
                    }
                );
            }


            /*
             * ============================================================
             * OFF ROUTE / REROUTE
             * ============================================================
             */

            function updateOffRouteState() {

                if (
                    !state.currentPosition ||
                    !state.routeResponse
                ) {

                    els.liveOffRoute.textContent =
                        "NE";

                    els.liveOffRoute.classList.remove(
                        "off-route"
                    );

                    return;
                }


                const activeRoute =
                    state.routeResponse.routes?.[
                    state.selectedRouteIndex
                    ];


                if (
                    !activeRoute
                ) {
                    return;
                }


                const geometry =
                    normalizeGeoJson(
                        activeRoute.geometry
                    );


                const coordinates =
                    extractGeoJsonCoordinates(
                        geometry
                    );


                if (
                    coordinates.length < 2
                ) {
                    return;
                }


                let minDistance =
                    Number.POSITIVE_INFINITY;


                for (
                    let i = 0;
                    i < coordinates.length;
                    i++
                ) {

                    const point =
                        coordinates[i];


                    const distance =
                        distanceMeters(
                            state.currentPosition.lat,
                            state.currentPosition.lon,
                            point[1],
                            point[0]
                        );


                    if (
                        distance <
                        minDistance
                    ) {

                        minDistance =
                            distance;
                    }
                }


                const offRoute =
                    minDistance > 150;


                els.liveOffRoute.textContent =
                    offRoute
                        ? "DA"
                        : "NE";


                els.liveOffRoute.classList.toggle(
                    "off-route",
                    offRoute
                );


                if (
                    offRoute
                ) {

                    maybeReroute();
                }
            }


            function maybeReroute() {

                if (
                    !state.liveNavigation ||
                    !state.currentPosition
                ) {
                    return;
                }


                const now =
                    Date.now();


                if (
                    now -
                    state.lastRerouteAt <
                    30000
                ) {
                    return;
                }


                const activeRoute =
                    state.routeResponse?.routes?.[
                    state.selectedRouteIndex
                    ];


                if (!activeRoute) {
                    return;
                }


                const geometry =
                    normalizeGeoJson(
                        activeRoute.geometry
                    );


                const coordinates =
                    extractGeoJsonCoordinates(
                        geometry
                    );


                if (
                    coordinates.length < 2
                ) {
                    return;
                }


                let minDistance =
                    Number.POSITIVE_INFINITY;


                coordinates.forEach(
                    point => {

                        const d =
                            distanceMeters(
                                state.currentPosition.lat,
                                state.currentPosition.lon,
                                point[1],
                                point[0]
                            );


                        if (
                            d <
                            minDistance
                        ) {
                            minDistance = d;
                        }
                    }
                );


                if (
                    minDistance <= 150
                ) {
                    return;
                }


                state.lastRerouteAt =
                    now;


                const previousStart =
                    state.start;


                state.start = {
                    lat:
                        state.currentPosition.lat,
                    lon:
                        state.currentPosition.lon,
                    label:
                        "Trenutna GPS lokacija"
                };


                state.startResolved =
                    true;


                els.start.value =
                    state.start.label;


                setResolvedUi(
                    els.startResolved,
                    true,
                    `${state.start.lat.toFixed(5)}, ${state.start.lon.toFixed(5)}`
                );


                calculateRoute()
                    .catch(
                        error => {
                            console.warn(
                                "Automatic reroute failed:",
                                error
                            );

                            state.start =
                                previousStart;
                        }
                    );
            }


            /*
             * ============================================================
             * MAP FIT
             * ============================================================
             */

            function fitRoute() {

                if (
                    !state.map
                ) {
                    return;
                }


                const activeLayer =
                    state.routeLayers[
                    state.selectedRouteIndex
                    ];


                if (
                    activeLayer &&
                    typeof activeLayer.getBounds ===
                    "function"
                ) {

                    const bounds =
                        activeLayer.getBounds();


                    if (
                        bounds.isValid()
                    ) {

                        state.map.fitBounds(
                            bounds,
                            {
                                paddingTopLeft:
                                    [40, 100],

                                paddingBottomRight:
                                    [40, 130],

                                maxZoom:
                                    14
                            }
                        );

                        return;
                    }
                }


                const bounds =
                    L.latLngBounds(
                        [
                            [
                                state.start.lat,
                                state.start.lon
                            ],
                            [
                                state.destination.lat,
                                state.destination.lon
                            ]
                        ]
                    );


                state.map.fitBounds(
                    bounds,
                    {
                        padding: [70, 70],
                        maxZoom: 14
                    }
                );
            }


            /*
             * ============================================================
             * MAP MODE
             * ============================================================
             */

            function setMapMode(
                mode
            ) {

                els.mapRouteTab.classList.toggle(
                    "active",
                    mode === "route"
                );

                els.mapRestrictionsTab.classList.toggle(
                    "active",
                    mode === "restrictions"
                );

                els.mapGpsTab.classList.toggle(
                    "active",
                    mode === "gps"
                );


                if (
                    mode === "gps"
                ) {

                    centerGps();

                } else if (
                    mode === "route"
                ) {

                    fitRoute();

                } else {

                    /*
                     * Restriction visualization will be
                     * connected to the backend restriction
                     * geometry when that endpoint is exposed.
                     *
                     * Current route warnings remain visible
                     * in the right panel.
                     */

                    if (
                        state.routeResponse
                    ) {
                        renderWarnings(
                            state.routeResponse
                        );
                    }
                }
            }


            /*
             * ============================================================
             * HELPERS
             * ============================================================
             */

            function setRoutingUi(
                routing
            ) {

                els.calculate.disabled =
                    routing;


                els.calculate.querySelector(
                    "strong"
                ).textContent =
                    routing
                        ? "Računam rutu..."
                        : (
                            state.profile === "truck"
                                ? "Izračunaj truck rutu"
                                : "Izračunaj rutu"
                        );


                els.engineBadge.classList.toggle(
                    "error",
                    false
                );


                if (
                    routing
                ) {

                    els.engineBadge.innerHTML =
                        `
                        <span></span>
                        ROUTING...
                        `;
                }
            }


            function updateEngineUi(
                engine
            ) {

                const value =
                    String(
                        engine ?? "READY"
                    );


                els.engineHeader.textContent =
                    value;


                els.engineBadge.classList.remove(
                    "error"
                );


                els.engineBadge.innerHTML =
                    `
                    <span></span>
                    ${escapeHtml(
                        value.toUpperCase()
                    )}
                    `;


                if (
                    value === "ERROR"
                ) {

                    els.engineBadge.classList.add(
                        "error"
                    );
                }
            }


            function swapPoints() {

                const oldStart =
                    state.start;


                state.start =
                    state.destination;


                state.destination =
                    oldStart;


                const oldText =
                    els.start.value;


                els.start.value =
                    els.end.value;


                els.end.value =
                    oldText;


                const oldResolved =
                    state.startResolved;


                state.startResolved =
                    state.destinationResolved;


                state.destinationResolved =
                    oldResolved;


                setResolvedUi(
                    els.startResolved,
                    state.startResolved,
                    state.startResolved
                        ? `${state.start.lat.toFixed(5)}, ${state.start.lon.toFixed(5)}`
                        : "Nije potvrđeno"
                );


                setResolvedUi(
                    els.endResolved,
                    state.destinationResolved,
                    state.destinationResolved
                        ? `${state.destination.lat.toFixed(5)}, ${state.destination.lon.toFixed(5)}`
                        : "Nije potvrđeno"
                );


                drawPointMarkers();


                if (
                    state.startResolved &&
                    state.destinationResolved
                ) {
                    calculateRoute();
                }
            }


            function showError(
                message,
                isError = true
            ) {

                els.error.hidden =
                    false;


                els.error.textContent =
                    message;


                els.error.style.color =
                    isError
                        ? "#fda4af"
                        : "#7be0b9";


                els.error.style.borderColor =
                    isError
                        ? "rgba(251,113,133,.15)"
                        : "rgba(52,211,153,.15)";


                els.error.style.background =
                    isError
                        ? "rgba(244,63,94,.065)"
                        : "rgba(16,185,129,.055)";
            }


            function hideError() {

                els.error.hidden =
                    true;

                els.error.textContent =
                    "";
            }


            function validPoint(
                point
            ) {

                return Boolean(
                    point &&
                    Number.isFinite(
                        Number(point.lat)
                    ) &&
                    Number.isFinite(
                        Number(point.lon)
                    ) &&
                    Number(point.lat) >= -90 &&
                    Number(point.lat) <= 90 &&
                    Number(point.lon) >= -180 &&
                    Number(point.lon) <= 180
                );
            }


            function samePoint(
                a,
                b
            ) {

                return (
                    Math.abs(
                        a.lat - b.lat
                    ) < 0.00001 &&
                    Math.abs(
                        a.lon - b.lon
                    ) < 0.00001
                );
            }


            function numberValue(
                element,
                fallback
            ) {

                const value =
                    Number(
                        element.value
                    );


                return Number.isFinite(
                    value
                )
                    ? value
                    : fallback;
            }


            function integerValue(
                element,
                fallback
            ) {

                const value =
                    Number(
                        element.value
                    );


                return Number.isFinite(
                    value
                )
                    ? Math.round(value)
                    : fallback;
            }


            function calculateEta(
                durationSeconds
            ) {

                return new Date(
                    Date.now() +
                    Math.max(
                        0,
                        durationSeconds
                    ) *
                    1000
                ).toISOString();
            }


            function formatDistance(
                meters
            ) {

                if (
                    !Number.isFinite(
                        meters
                    )
                ) {
                    return "—";
                }


                if (
                    meters >= 1000
                ) {

                    return (
                        (meters / 1000)
                            .toFixed(
                                meters >= 10000
                                    ? 0
                                    : 1
                            ) +
                        " km"
                    );
                }


                return (
                    Math.round(
                        meters
                    ) +
                    " m"
                );
            }


            function formatDuration(
                seconds
            ) {

                if (
                    !Number.isFinite(
                        seconds
                    )
                ) {
                    return "—";
                }


                const totalMinutes =
                    Math.max(
                        0,
                        Math.round(
                            seconds / 60
                        )
                    );


                const hours =
                    Math.floor(
                        totalMinutes / 60
                    );


                const minutes =
                    totalMinutes % 60;


                if (
                    hours <= 0
                ) {

                    return `${minutes} min`;
                }


                return `${hours} h ${String(minutes).padStart(2, "0")} min`;
            }


            function formatEta(
                value
            ) {

                if (!value) {
                    return "—";
                }


                const date =
                    new Date(
                        value
                    );


                if (
                    Number.isNaN(
                        date.getTime()
                    )
                ) {
                    return "—";
                }


                return new Intl.DateTimeFormat(
                    "sr-RS",
                    {
                        hour: "2-digit",
                        minute: "2-digit"
                    }
                ).format(
                    date
                );
            }


            function distanceMeters(
                lat1,
                lon1,
                lat2,
                lon2
            ) {

                const earth =
                    6371000;


                const dLat =
                    (
                        lat2 -
                        lat1
                    ) *
                    Math.PI /
                    180;


                const dLon =
                    (
                        lon2 -
                        lon1
                    ) *
                    Math.PI /
                    180;


                const a =
                    Math.sin(
                        dLat / 2
                    ) ** 2 +
                    Math.cos(
                        lat1 *
                        Math.PI /
                        180
                    ) *
                    Math.cos(
                        lat2 *
                        Math.PI /
                        180
                    ) *
                    Math.sin(
                        dLon / 2
                    ) ** 2;


                return (
                    2 *
                    earth *
                    Math.atan2(
                        Math.sqrt(a),
                        Math.sqrt(1 - a)
                    )
                );
            }


            function extractGeoJsonCoordinates(
                geometry
            ) {

                if (!geometry) {
                    return [];
                }


                if (
                    geometry.type ===
                    "LineString"
                ) {

                    return Array.isArray(
                        geometry.coordinates
                    )
                        ? geometry.coordinates
                        : [];
                }


                if (
                    geometry.type ===
                    "MultiLineString"
                ) {

                    return (
                        geometry.coordinates
                            ?.flatMap(
                                part =>
                                    Array.isArray(
                                        part
                                    )
                                        ? part
                                        : []
                            ) ??
                        []
                    );
                }


                if (
                    geometry.type ===
                    "Feature"
                ) {

                    return extractGeoJsonCoordinates(
                        geometry.geometry
                    );
                }


                return [];
            }


            function clamp(
                value,
                min,
                max
            ) {

                return Math.min(
                    max,
                    Math.max(
                        min,
                        value
                    )
                );
            }


            function escapeHtml(
                value
            ) {

                return String(
                    value ?? ""
                )
                    .replace(
                        /&/g,
                        "&amp;"
                    )
                    .replace(
                        /</g,
                        "&lt;"
                    )
                    .replace(
                        />/g,
                        "&gt;"
                    )
                    .replace(
                        /"/g,
                        "&quot;"
                    )
                    .replace(
                        /'/g,
                        "&#039;"
                    );
            }


            function gpsErrorMessage(
                error
            ) {

                switch (
                error?.code
                ) {

                    case 1:
                        return "GPS dozvola je odbijena. Dozvolite pristup lokaciji u browseru.";

                    case 2:
                        return "GPS lokacija trenutno nije dostupna.";

                    case 3:
                        return "GPS zahtev je istekao. Pokušajte ponovo.";

                    default:
                        return "Greška pri čitanju GPS lokacije.";
                }
            }


            function formatRoutingError(
                error
            ) {

                const message =
                    error?.message ??
                    String(
                        error ??
                        "Nepoznata greška"
                    );


                if (
                    message.includes(
                        "Failed to fetch"
                    )
                ) {

                    return (
                        "Routing API nije dostupan. " +
                        "Proverite da li API radi i da li je /api/route dostupan."
                    );
                }


                return message;
            }


            function normalizeRouteForBounds(
                layer
            ) {

                if (
                    layer &&
                    typeof layer.getBounds ===
                    "function"
                ) {

                    return layer.getBounds();
                }


                return null;
            }


            /*
             * ============================================================
             * START
             * ============================================================
             */

            if (
                document.readyState ===
                "loading"
            ) {

                document.addEventListener(
                    "DOMContentLoaded",
                    init,
                    {
                        once: true
                    }
                );

            } else {

                init();
            }

        })();
    </script>

}