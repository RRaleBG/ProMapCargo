        margin-bottom: 10px;
    }

    .pm-page-subtitle {
        display: none;
    }

    .navigation-workspace {
        display: flex;
        flex-direction: column;

        gap: 10px;
    }

    .navigation-map-section {
        width: 100%;
        height: min(62dvh, 680px);
        order: 1;
    }

    .navigation-map-shell {
        width: 100%;

        height: min(62dvh, 680px);

        min-height: 420px;

        border-radius: 16px;
    }

    .navigation-control-panel {
        order: 2;

        width: 100%;

        max-height: none;

        overflow: visible;

        padding: 0;
    }

    .navigation-control-panel > section {
        width: 100%;
    }

    .nav-control-card {
        padding: 14px;
        border-radius: 15px;
    }

    /* --------------------------------------------------------
       MOBILE NEXT MANEUVER
       -------------------------------------------------------- */

    .nav-next-overlay {
        top: 60px;
        left: 50%;
        right: auto;

        transform: translateX(-50%);

        width: calc(100% - 20px);
        max-width: none;

        grid-template-columns: 46px minmax(0, 1fr) auto;

        gap: 10px;

        padding: 9px 10px;

        border-radius: 14px;
    }

    .nav-next-icon {
        width: 46px;
        height: 46px;

        flex-basis: 46px;

        border-radius: 12px;

        font-size: 24px;
    }

    .nav-next-copy strong {
        font-size: 14px;
    }

    .nav-next-copy span {
        font-size: 10px;
    }

    #nextInstructionDistance {
        font-size: 12px;
    }

    /* --------------------------------------------------------
       MAP TOPBAR
       -------------------------------------------------------- */

    .nav-map-topbar {
        top: 8px;
        left: 8px;
        right: 8px;
    }

    .nav-map-mode-tabs {
        max-width: calc(100% - 105px);

        overflow-x: auto;

        scrollbar-width: none;
    }

    .nav-map-mode-tabs::-webkit-scrollbar {
        display: none;
    }

    .nav-map-tab {
        flex: 0 0 auto;

        min-height: 36px;

        padding: 0 11px;
    }

    .nav-map-engine {
        flex-shrink: 0;
        padding: 0 9px;
    }

    .nav-map-engine strong {
        display: none;
    }

    /* --------------------------------------------------------
       MAP ROUTE CARD
       -------------------------------------------------------- */

    .nav-map-route-card {
        left: 8px;
        right: 8px;
        bottom: 8px;

        width: calc(100% - 16px);
        max-width: none;

        padding: 10px;
    }

    .nav-map-route-stats {
        gap: 5px;
    }

    .nav-map-route-stats strong {
        font-size: 10px;
    }

    /* --------------------------------------------------------
       LEAFLET
       -------------------------------------------------------- */

    #navMap .leaflet-control-zoom {
        margin-top: 122px;
        margin-right: 8px;
    }

    #navMap .leaflet-control-zoom a {
        width: 42px;
        height: 42px;

        line-height: 42px;

        font-size: 20px;
    }

    /* --------------------------------------------------------
       VEHICLE
       -------------------------------------------------------- */

    .nav-spec-grid {
        grid-template-columns: 1fr 1fr;
    }

    .nav-input,
    .nav-select {
        min-height: 46px;
        height: 46px;

        font-size: 16px;
    }

    .nav-icon-button,
    .nav-small-action,
    .nav-mode-button,
    .nav-location-button,
    .nav-map-control {
        min-height: 44px;
    }

    /* --------------------------------------------------------
       LIVE
       -------------------------------------------------------- */

    .nav-live-panel {
        position: sticky;

        z-index: 1200;

        bottom: 8px;

        display: grid;

        grid-template-columns: 1fr auto;

        gap: 10px;

        margin-top: 10px;

        padding: 10px;

        border-radius: 15px;

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .nav-live-left {
        min-width: 0;
    }

    .nav-live-stats {
        display: none;
    }

    .nav-live-actions {
        grid-column: 1 / -1;

        width: 100%;
    }

    .nav-live-actions button {
        width: 100%;
        min-height: 46px;
    }

    .nav-mobile-bottom-space {
        display: block;

        height: var(--nav-safe-bottom);
    }
