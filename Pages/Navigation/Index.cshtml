/* ============================================================
   VERY SMALL PHONE
   ============================================================ */

@@media (max-width: 390px) {

    .navigation-map-shell {
        height: 55dvh;
        min-height: 360px;
    }

    .nav-map-tab {
        padding: 0 8px;
        font-size: 9px;
    }

    .nav-next-overlay {
        top: 56px;

        grid-template-columns: 38px minmax(0, 1fr) auto;

        padding: 7px;

        gap: 7px;
    }

    .nav-next-icon {
        width: 38px;
        height: 38px;

        flex-basis: 38px;

        border-radius: 10px;

        font-size: 20px;
    }

    .nav-next-copy strong {
        font-size: 12px;
    }

    .nav-next-copy span {
        font-size: 8px;
    }

    #nextInstructionDistance {
        font-size: 10px;
    }

    .nav-map-route-stats {
        grid-template-columns: 1fr 1fr 1fr;
    }

    .nav-mode-button {
        min-height: 54px;
        padding: 7px;
    }

    .nav-mode-button small {
        display: none;
    }

    .nav-spec-grid {
        gap: 7px;
    }
}

/* ============================================================
   LIVE NAVIGATION MODE
   ============================================================ */

@@media (max-width: 900px) {

    .pm-navigation-page.live-navigation-active .nav-page-header {
        display: none;
    }

    .pm-navigation-page.live-navigation-active
    .navigation-map-shell {
        height:
            calc(
                100dvh -
                var(--nav-safe-top) -
                92px
            );

        min-height: 500px;

        border-radius: 0;

        border-left: 0;
        border-right: 0;
    }

    .pm-navigation-page.live-navigation-active
    .navigation-control-panel {
        display: none;
    }

    .pm-navigation-page.live-navigation-active
    .nav-live-panel {
        position: fixed;

        z-index: 5000;

        left: 8px;
        right: 8px;

        bottom:
            calc(
                8px +
                var(--nav-safe-bottom)
            );

        margin: 0;
    }

    /*
       U live modu banner ostaje centralan,
       odmah ispod gornjeg dela mape.
    */
    .pm-navigation-page.live-navigation-active
    .nav-next-overlay {
        top:
            calc(
                10px +
                var(--nav-safe-top)
            );

        left: 50%;
        right: auto;

        transform: translateX(-50%);

        width: calc(100% - 16px);
    }

    .pm-navigation-page.live-navigation-active
    .nav-map-controls {
        bottom: 95px;
    }

    .pm-navigation-page.live-navigation-active
    #navMap .leaflet-control-zoom {
        margin-top: 120px;
    }
}

/* ============================================================
   ACCESSIBILITY / TOUCH
   ============================================================ */

button,
select,
input {
    -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
    outline: 2px solid rgba(45, 212, 191, .75);
    outline-offset: 2px;
}

@@media (hover: hover) {

    .nav-map-control:hover,
    .nav-small-action:hover,
    .nav-icon-button:hover,
    .nav-location-button:hover {
        border-color: rgba(45, 212, 191, .35);
        background: rgba(45, 212, 191, .07);
    }

    .nav-mode-button:hover {
        border-color: rgba(45, 212, 191, .28);
    }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */

@@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
    }
}
