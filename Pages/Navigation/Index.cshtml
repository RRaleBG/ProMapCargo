@page
@{
    ViewData["Title"] = "Navigacija";
}

<div class="pm-page pm-navigation-page" data-module="navigation">

    <div class="nav-page-header">

        <div class="nav-page-heading">
            <div class="pm-eyebrow">FLEET NAVIGATION</div>

            <div class="nav-title-row">
                <h1 class="pm-page-title">Truck Navigation</h1>

                <span id="engineBadge" class="nav-engine-badge ready">
                    <span></span>
                    ROUTING READY
                </span>
            </div>

            <p class="pm-page-subtitle">
                Truck-aware routing preko PostGIS / OSM graph-a sa OSRM fallback-om,
                GPS praćenjem i kontrolom ograničenja vozila.
            </p>
        </div>

        <div class="nav-header-status">

            <div class="nav-status-card">
                <span class="nav-status-light"></span>

                <div>
                    <small>GPS STATUS</small>
                    <strong id="gpsStatus">OFF</strong>
                </div>
            </div>

            <div class="nav-status-card">
                <span class="nav-status-light emerald"></span>

                <div>
                    <small>ROUTING ENGINE</small>
                    <strong id="engineHeader">POSTGIS</strong>
                </div>
            </div>

        </div>

    </div>


    <div class="navigation-workspace">

        <!-- =====================================================
             MAP
             ===================================================== -->

        <section class="navigation-map-section">

            <div class="navigation-map-shell">

                <div id="navMap" class="navigation-map"></div>


                <div class="nav-map-topbar">

                    <div class="nav-map-mode-tabs">

                        <button type="button"
                                class="nav-map-tab active"
                                id="mapRouteTab">
                            Ruta
                        </button>

                        <button type="button"
                                class="nav-map-tab"
                                id="mapRestrictionsTab">
                            Ograničenja
                        </button>

                        <button type="button"
                                class="nav-map-tab"
                                id="mapGpsTab">
                            GPS
                        </button>

                    </div>

                    <div class="nav-map-engine">
                        <span></span>
                        <strong id="routeSafeBadge">TRUCK SAFE</strong>
                    </div>

                </div>


                <div class="nav-map-controls">

                    <button type="button"
                            id="fitRoute"
                            class="nav-map-control"
                            title="Prikaži celu rutu">
                        ⤢
                    </button>

                    <button type="button"
                            id="centerGps"
                            class="nav-map-control"
                            title="Centriraj GPS">
                        ◎
                    </button>

                </div>


                <div class="nav-map-route-card"
                     id="mapRouteCard"
                     hidden>

                    <div class="nav-map-route-card-head">

                        <div>
                            <small>AKTIVNA RUTA</small>
                            <strong id="mapRouteTitle">
                                Beograd → Novi Sad
                            </strong>
                        </div>

                        <span id="mapRouteStatus"
                              class="pm-badge pm-badge-success">
                            Bezbedna
                        </span>

                    </div>

                    <div class="nav-map-route-stats">

                        <div>
                            <span>Udaljenost</span>
                            <strong id="mapDistance">—</strong>
                        </div>

                        <div>
                            <span>Trajanje</span>
                            <strong id="mapDuration">—</strong>
                        </div>

                        <div>
                            <span>ETA</span>
                            <strong id="mapEta">—</strong>
                        </div>

                    </div>

                </div>


                <div class="nav-next-overlay"
                     id="nextInstruction"
                     hidden>

                    <div class="nav-next-icon"
                         id="nextInstructionIcon">
                        ↰
                    </div>

                    <div class="nav-next-copy">

                        <small>NAREDNI MANEVAR</small>

                        <strong id="nextInstructionText">
                            —
                        </strong>

                        <span id="nextInstructionDistance">
                            —
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             RIGHT / CONTROL PANEL
             ===================================================== -->

        <aside class="navigation-control-panel">

            <!-- ROUTE -->
            <section class="nav-control-card nav-route-control">

                <div class="nav-control-card-header">

                    <div>
                        <span class="nav-section-kicker">ROUTE PLANNER</span>
                        <h2>Planiranje rute</h2>
                    </div>

                    <button type="button"
                            id="swapPoints"
                            class="nav-icon-button"
                            title="Zameni polaznu i odredišnu tačku">
                        ⇅
                    </button>

                </div>


                <div class="nav-route-inputs">

                    <div class="nav-route-input-row">

                        <div class="nav-point-marker start"></div>

                        <div class="nav-input-wrapper">

                            <label for="navStart">
                                POLAZNA TAČKA
                            </label>

                            <input id="navStart"
                                   class="nav-input"
                                   type="text"
                                   autocomplete="off"
                                   value="Beograd, Srbija"
                                   placeholder="Grad, adresa ili lokacija" />

                            <div id="navStartSuggestions"
                                 class="nav-suggestions">
                            </div>

                            <div id="navStartResolved"
                                 class="nav-resolved">
                                <span></span>
                                Nije još potvrđeno
                            </div>

                        </div>

                    </div>


                    <div class="nav-route-connector"></div>


                    <div class="nav-route-input-row">

                        <div class="nav-point-marker destination"></div>

                        <div class="nav-input-wrapper">

                            <label for="navEnd">
                                ODREDIŠTE
                            </label>

                            <input id="navEnd"
                                   class="nav-input"
                                   type="text"
                                   autocomplete="off"
                                   value="Novi Sad, Srbija"
                                   placeholder="Grad, adresa ili lokacija" />

                            <div id="navEndSuggestions"
                                 class="nav-suggestions">
                            </div>

                            <div id="navEndResolved"
                                 class="nav-resolved">
                                <span></span>
                                Nije još potvrđeno
                            </div>

                        </div>

                    </div>

                </div>


                <div class="nav-map-pick-row">

                    <button type="button"
                            id="pickStart"
                            class="nav-small-action">
                        <span>＋</span>
                        Izaberi start na mapi
                    </button>

                    <button type="button"
                            id="pickEnd"
                            class="nav-small-action">
                        <span>＋</span>
                        Izaberi cilj na mapi
                    </button>

                </div>

            </section>


            <!-- VEHICLE MODE -->
            <section class="nav-control-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">VEHICLE</span>
                        <h2>Profil vozila</h2>
                    </div>

                    <span id="truckModeBadge"
                          class="nav-mini-status">
                        HGV
                    </span>

                </div>


                <div class="nav-mode-switch">

                    <button type="button"
                            id="truckMode"
                            class="nav-mode-button active">

                        <span class="nav-mode-icon">▣</span>

                        <span>
                            <strong>Kamion</strong>
                            <small>Truck-aware</small>
                        </span>

                    </button>


                    <button type="button"
                            id="carMode"
                            class="nav-mode-button">

                        <span class="nav-mode-icon">▱</span>

                        <span>
                            <strong>Auto</strong>
                            <small>Standard routing</small>
                        </span>

                    </button>

                </div>


                <div class="nav-preset-row">

                    <label for="truckPreset">
                        PRESET
                    </label>

                    <select id="truckPreset"
                            class="nav-select">

                        <option value="40t">
                            40 t · standardni šleper
                        </option>

                        <option value="12t">
                            12 t · srednji kamion
                        </option>

                        <option value="7.5t">
                            7.5 t · laki kamion
                        </option>

                        <option value="3.5t">
                            3.5 t · dostavno vozilo
                        </option>

                    </select>

                </div>


                <div id="truckFields"
                     class="nav-truck-fields">

                    <div class="nav-spec-grid">

                        <div class="nav-field">

                            <label for="navWeight">
                                MASA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navWeight"
                                       type="number"
                                       class="nav-input"
                                       value="40"
                                       min="0.1"
                                       step="0.1" />

                                <span>t</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navHeight">
                                VISINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navHeight"
                                       type="number"
                                       class="nav-input"
                                       value="4"
                                       min="0.1"
                                       step="0.01" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navWidth">
                                ŠIRINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navWidth"
                                       type="number"
                                       class="nav-input"
                                       value="2.55"
                                       min="0.1"
                                       step="0.01" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navLength">
                                DUŽINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navLength"
                                       type="number"
                                       class="nav-input"
                                       value="16.5"
                                       min="0.1"
                                       step="0.1" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxleLoad">
                                OSOVINSKO OPTEREĆENJE
                            </label>

                            <div class="nav-input-unit">
                                <input id="navAxleLoad"
                                       type="number"
                                       class="nav-input"
                                       value="10"
                                       min="0.1"
                                       step="0.1" />

                                <span>t</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxles">
                                OSOVINE
                            </label>

                            <div class="nav-input-unit">
                                <input id="navAxles"
                                       type="number"
                                       class="nav-input"
                                       value="5"
                                       min="1"
                                       step="1" />

                                <span>kom</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navMaxSpeed">
                                MAKS. BRZINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navMaxSpeed"
                                       type="number"
                                       class="nav-input"
                                       value="90"
                                       min="1"
                                       step="1" />

                                <span>km/h</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAdrClass">
                                ADR KLASA
                            </label>

                            <input id="navAdrClass"
                                   type="text"
                                   class="nav-input"
                                   placeholder="npr. 3" />

                        </div>

                    </div>


                    <div class="nav-check-grid">

                        <label class="nav-check">

                            <input id="navHazmat"
                                   type="checkbox" />

                            <span class="nav-check-box"></span>

                            <span>
                                ADR / opasna roba
                            </span>

                        </label>


                        <label class="nav-check">

                            <input id="navAvoid"
                                   type="checkbox"
                                   checked />

                            <span class="nav-check-box"></span>

                            <span>
                                Automatski izbegavaj restrikcije
                            </span>

                        </label>

                    </div>

                </div>

            </section>


            <!-- ROUTE ACTION -->
            <section class="nav-route-action">

                <button type="button"
                        id="calcRoute"
                        class="nav-calculate-button">

                    <span class="nav-calculate-icon">
                        ↗
                    </span>

                    <span>
                        <strong>Izračunaj truck rutu</strong>
                        <small>PostGIS · OSM · OSRM fallback</small>
                    </span>

                    <span class="nav-button-arrow">
                        →
                    </span>

                </button>


                <button type="button"
                        id="useCurrentLocation"
                        class="nav-location-button">

                    <span>◎</span>

                    <span>
                        Koristi moju trenutnu lokaciju
                    </span>

                </button>


                <div id="navError"
                     class="nav-error"
                     hidden>
                </div>

            </section>


            <!-- SUMMARY -->
            <section class="nav-control-card nav-summary-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">ROUTE RESULT</span>
                        <h2>Pregled rute</h2>
                    </div>

                    <span id="summarySafety"
                          class="pm-badge pm-badge-success">
                        READY
                    </span>

                </div>


                <div class="nav-result-main">

                    <div class="nav-result-distance">
                        <span>UKUPNA UDALJENOST</span>
                        <strong id="summaryDistance">—</strong>
                    </div>

                    <div class="nav-result-duration">
                        <span>TRAJANJE</span>
                        <strong id="summaryDuration">—</strong>
                    </div>

                </div>


                <div class="nav-summary-grid">

                    <div>
                        <small>ETA</small>
                        <strong id="summaryEta">—</strong>
                    </div>

                    <div>
                        <small>ENGINE</small>
                        <strong id="summaryEngine">—</strong>
                    </div>

                    <div>
                        <small>RESTRIKCIJE</small>
                        <strong id="summaryDiagnostics">—</strong>
                    </div>

                </div>

            </section>


            <!-- ALTERNATIVES -->
            <section id="alternativesCard"
                     class="nav-control-card nav-list-card"
                     hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">ROUTES</span>
                        <h2>Alternativne rute</h2>
                    </div>

                    <span id="alternativeCount"
                          class="nav-counter">
                        0
                    </span>

                </div>

                <div id="routeAlternatives"
                     class="nav-alternatives">
                </div>

            </section>


            <!-- WARNINGS -->
            <section id="warningsCard"
                     class="nav-control-card nav-list-card"
                     hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">SAFETY</span>
                        <h2>Upozorenja</h2>
                    </div>

                    <span id="warningCount"
                          class="nav-counter danger">
                        0
                    </span>

                </div>

                <div id="routeWarnings"
                     class="nav-warning-list">
                </div>

            </section>


            <!-- MANEUVERS -->
            <section id="maneuversCard"
                     class="nav-control-card nav-list-card"
                     hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">DIRECTIONS</span>
                        <h2>Koraci navigacije</h2>
                    </div>

                    <span id="maneuverCount"
                          class="nav-counter">
                        0
                    </span>

                </div>

                <div id="maneuverList"
                     class="nav-maneuver-list">
                </div>

            </section>


            <!-- DIAGNOSTICS -->
            <section class="nav-control-card nav-diagnostics-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">SYSTEM</span>
                        <h2>Routing diagnostics</h2>
                    </div>

                    <span class="nav-diagnostic-led"></span>

                </div>


                <div class="nav-diagnostics-grid">

                    <div>
                        <small>ENGINE</small>
                        <strong id="diagnosticEngine">—</strong>
                    </div>

                    <div>
                        <small>GRAPH</small>
                        <strong id="diagnosticGraph">—</strong>
                    </div>

                    <div>
                        <small>STATES</small>
                        <strong id="diagnosticStates">—</strong>
                    </div>

                    <div>
                        <small>FALLBACK</small>
                        <strong id="diagnosticFallback">—</strong>
                    </div>

                </div>

            </section>

        </aside>

    </div>


    <!-- =====================================================
         LIVE NAVIGATION BAR
         ===================================================== -->

    <section class="nav-live-panel"
             id="liveNavigationPanel">

        <div class="nav-live-left">

            <div class="nav-live-status">
                <span id="liveChip"
                      class="nav-live-chip">
                    GPS OFF
                </span>
            </div>

            <div class="nav-live-position">

                <strong id="livePosition">
                    Lokacija nije aktivna
                </strong>

                <small id="liveAccuracy">
                    —
                </small>

            </div>

        </div>


        <div class="nav-live-stats">

            <div>
                <small>BRZINA</small>
                <strong id="liveSpeed">0 km/h</strong>
            </div>

            <div>
                <small>OFF ROUTE</small>
                <strong id="liveOffRoute">NE</strong>
            </div>

        </div>


        <div class="nav-live-actions">

            <button type="button"
                    id="startLiveNavigation"
                    class="pm-btn pm-btn-primary">

                ◎
                Pokreni live navigaciju

            </button>

            <button type="button"
                    id="stopLiveNavigation"
                    class="pm-btn pm-btn-danger"
                    hidden>

                ■
                Zaustavi

            </button>

        </div>

    </section>


    <div class="nav-mobile-bottom-space"></div>


@section Scripts {

    <script>
        (() => {
            "use strict";

            /*
             * ============================================================
             * ProMap Cargo - Navigation
             * ============================================================
             *
             * Frontend responsibilities:
             *
             *   /api/geocode
             *   /api/route
             *
             * Backend responsibilities:
             *
             *   PostGIS / OSM graph
             *   OSRM fallback
             *   truck restrictions
             *   route analysis
             *
             * ============================================================
             */

            const state = {
                map: null,

                start: {
                    lat: 44.8178,
                    lon: 20.4573,
                    label: "Beograd, Srbija"
                },

                destination: {
                    lat: 45.2551,
                    lon: 19.8335,
                    label: "Novi Sad, Srbija"
                },

                startResolved: true,
                destinationResolved: true,

                startMarker: null,
                destinationMarker: null,
                positionMarker: null,

                routeLayers: [],
                selectedRouteIndex: 0,
                routeResponse: null,

                profile: "truck",

                mapPickTarget: null,

                watchId: null,
                liveNavigation: false,

                currentPosition: null,

                lastRerouteAt: 0,
                isRouting: false,

                lastGeocodeRequest: {
                    start: 0,
                    end: 0
                },

                suggestionAbortControllers: {
                    start: null,
                    end: null
                }
            };


            const $ = (id) => document.getElementById(id);


            const els = {
                map: $("navMap"),

                start: $("navStart"),
                end: $("navEnd"),

                startSuggestions: $("navStartSuggestions"),
                endSuggestions: $("navEndSuggestions"),

                startResolved: $("navStartResolved"),
                endResolved: $("navEndResolved"),

                swap: $("swapPoints"),

                truckMode: $("truckMode"),
                carMode: $("carMode"),
                truckModeBadge: $("truckModeBadge"),

                truckPreset: $("truckPreset"),
                truckFields: $("truckFields"),

                weight: $("navWeight"),
                height: $("navHeight"),
                width: $("navWidth"),
                length: $("navLength"),
                axleLoad: $("navAxleLoad"),
                axles: $("navAxles"),
                maxSpeed: $("navMaxSpeed"),
                adrClass: $("navAdrClass"),
                hazmat: $("navHazmat"),
                avoid: $("navAvoid"),

                calculate: $("calcRoute"),
                currentLocation: $("useCurrentLocation"),

                error: $("navError"),

                fitRoute: $("fitRoute"),
                centerGps: $("centerGps"),

                mapRouteTab: $("mapRouteTab"),
                mapRestrictionsTab: $("mapRestrictionsTab"),
                mapGpsTab: $("mapGpsTab"),

                engineBadge: $("engineBadge"),
                engineHeader: $("engineHeader"),
                gpsStatus: $("gpsStatus"),
                routeSafeBadge: $("routeSafeBadge"),

                mapRouteCard: $("mapRouteCard"),
                mapRouteTitle: $("mapRouteTitle"),
                mapRouteStatus: $("mapRouteStatus"),
                mapDistance: $("mapDistance"),
                mapDuration: $("mapDuration"),
                mapEta: $("mapEta"),

                nextInstruction: $("nextInstruction"),
                nextInstructionIcon: $("nextInstructionIcon"),
                nextInstructionText: $("nextInstructionText"),
                nextInstructionDistance: $("nextInstructionDistance"),

                summaryDistance: $("summaryDistance"),
                summaryDuration: $("summaryDuration"),
                summaryEta: $("summaryEta"),
                summarySafety: $("summarySafety"),
                summaryEngine: $("summaryEngine"),
                summaryDiagnostics: $("summaryDiagnostics"),

                alternativesCard: $("alternativesCard"),
                alternativeCount: $("alternativeCount"),
                routeAlternatives: $("routeAlternatives"),

                warningsCard: $("warningsCard"),
                warningCount: $("warningCount"),
                routeWarnings: $("routeWarnings"),

                maneuversCard: $("maneuversCard"),
                maneuverCount: $("maneuverCount"),
                maneuverList: $("maneuverList"),

                diagnosticEngine: $("diagnosticEngine"),
                diagnosticGraph: $("diagnosticGraph"),
                diagnosticStates: $("diagnosticStates"),
                diagnosticFallback: $("diagnosticFallback"),

                liveChip: $("liveChip"),
                liveSpeed: $("liveSpeed"),
                liveAccuracy: $("liveAccuracy"),
                liveOffRoute: $("liveOffRoute"),
                livePosition: $("livePosition"),

                startLiveNavigation: $("startLiveNavigation"),
                stopLiveNavigation: $("stopLiveNavigation"),

                pickStart: $("pickStart"),
                pickEnd: $("pickEnd")
            };


            /*
             * ============================================================
             * INITIALIZATION
             * ============================================================
             */

            function init() {

                if (!els.map) {
                    return;
                }

                initializeMap();

                bindEvents();

                setInitialPoints();

                updateTruckMode();

                updateGpsUi(false);

                updateEngineUi("READY");

                window.setTimeout(() => {
                    resolveInitialPoints();
                }, 350);
            }


            function initializeMap() {

                state.map = L.map(
                    els.map,
                    {
                        zoomControl: true,
                        attributionControl: true,
                        preferCanvas: true
                    }
                ).setView(
                    [44.95, 20.25],
                    8
                );


                /*
                 * Dark map similar to the requested Dispatch Pro
                 * visual direction.
                 */

                L.tileLayer(
                    "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
                    {
                        maxZoom: 20,
                        attribution:
                            '&copy; OpenStreetMap contributors &copy; CARTO'
                    }
                ).addTo(state.map);


                state.map.on(
                    "click",
                    handleMapClick
                );


                setTimeout(() => {
                    state.map.invalidateSize();
                }, 250);
            }


            function bindEvents() {

                els.calculate.addEventListener(
                    "click",
                    calculateRoute
                );


                els.swap.addEventListener(
                    "click",
                    swapPoints
                );


                els.truckMode.addEventListener(
                    "click",
                    () => {
                        state.profile = "truck";
                        updateTruckMode();
                    }
                );


                els.carMode.addEventListener(
                    "click",
                    () => {
                        state.profile = "car";
                        updateTruckMode();
                    }
                );


                els.truckPreset.addEventListener(
                    "change",
                    applyTruckPreset
                );


                els.useCurrentLocation.addEventListener(
                    "click",
                    useCurrentLocation
                );


                els.fitRoute.addEventListener(
                    "click",
                    fitRoute
                );


                els.centerGps.addEventListener(
                    "click",
                    centerGps
                );


                els.pickStart.addEventListener(
                    "click",
                    () => activateMapPick("start")
                );


                els.pickEnd.addEventListener(
                    "click",
                    () => activateMapPick("end")
                );


                els.start.addEventListener(
                    "input",
                    () => {
                        state.startResolved = false;
                        setResolvedUi(
                            els.startResolved,
                            false,
                            "Nije potvrđeno"
                        );

                        debounceGeocode(
                            "start",
                            els.start,
                            els.startSuggestions
                        );
                    }
                );


                els.end.addEventListener(
                    "input",
                    () => {
                        state.destinationResolved = false;
                        setResolvedUi(
                            els.endResolved,
                            false,
                            "Nije potvrđeno"
                        );

                        debounceGeocode(
                            "end",
                            els.end,
                            els.endSuggestions
                        );
                    }
                );


                els.start.addEventListener(
                    "keydown",
                    event => {
                        if (event.key === "Enter") {
                            event.preventDefault();
                            geocodeAndResolve(
                                "start",
                                els.start.value,
                                els.startSuggestions
                            );
                        }
                    }
                );


                els.end.addEventListener(
                    "keydown",
                    event => {
                        if (event.key === "Enter") {
                            event.preventDefault();
                            geocodeAndResolve(
                                "end",
                                els.end.value,
                                els.endSuggestions
                            );
                        }
                    }
                );


                document.addEventListener(
                    "click",
                    event => {

                        if (
                            !event.target.closest(".nav-input-wrapper")
                        ) {
                            hideSuggestions(
                                els.startSuggestions
                            );

                            hideSuggestions(
                                els.endSuggestions
                            );
                        }
                    }
                );


                els.startLiveNavigation.addEventListener(
                    "click",
                    startLiveNavigation
                );


                els.stopLiveNavigation.addEventListener(
                    "click",
                    stopLiveNavigation
                );


                els.mapRouteTab.addEventListener(
                    "click",
                    () => setMapMode("route")
                );


                els.mapRestrictionsTab.addEventListener(
                    "click",
                    () => setMapMode("restrictions")
                );


                els.mapGpsTab.addEventListener(
                    "click",
                    () => setMapMode("gps")
                );


                window.addEventListener(
                    "resize",
                    () => {
                        if (state.map) {
                            state.map.invalidateSize();
                        }
                    }
                );
            }


            /*
             * ============================================================
             * INITIAL POINTS
             * ============================================================
             */

            function setInitialPoints() {

                els.start.value = state.start.label;
                els.end.value = state.destination.label;

                setResolvedUi(
                    els.startResolved,
                    true,
                    `${state.start.lat.toFixed(5)}, ${state.start.lon.toFixed(5)}`
                );

                setResolvedUi(
                    els.endResolved,
                    true,
                    `${state.destination.lat.toFixed(5)}, ${state.destination.lon.toFixed(5)}`
                );

                drawPointMarkers();
            }


            async function resolveInitialPoints() {

                try {
                    await calculateRoute();
                } catch {
                }
            }


            /*
             * ============================================================
             * GEOCODING
             * ============================================================
             */

            function debounceGeocode(
                type,
                input,
                suggestions
            ) {

                const query = input.value.trim();

                if (query.length < 2) {
                    hideSuggestions(suggestions);
                    return;
                }

                const now = Date.now();

                state.lastGeocodeRequest[type] = now;

                window.setTimeout(
                    () => {

                        if (
                            state.lastGeocodeRequest[type] !== now
                        ) {
                            return;
                        }

                        geocodeAndResolve(
                            type,
                            query,
                            suggestions
                        );

                    },
                    350
                );
            }


            async function geocodeAndResolve(
                type,
                query,
                suggestions
            ) {

                query = String(query || "").trim();

                if (query.length < 2) {
                    return;
                }

                const controller =
                    new AbortController();

                if (
                    state.suggestionAbortControllers[type]
                ) {
                    state.suggestionAbortControllers[type].abort();
                }

                state.suggestionAbortControllers[type] =
                    controller;

                try {

                    const response =
                        await fetch(
                            `/api/geocode?q=${encodeURIComponent(query)}&limit=5`,
                            {
                                method: "GET",
                                headers: {
                                    "Accept": "application/json"
                                },
                                signal: controller.signal
                            }
                        );


                    if (!response.ok) {
                        throw new Error(
                            `Geocoding HTTP ${response.status}`
                        );
                    }


                    const data =
                        await response.json();


                    const results =
                        Array.isArray(data)
                            ? data
                            : [];


                    renderSuggestions(
                        type,
                        results,
                        suggestions
                    );


                    if (results.length === 1) {

                        selectGeocodingResult(
                            type,
                            results[0],
                            suggestions
                        );

                    }

                } catch (error) {

                    if (
                        error?.name === "AbortError"
                    ) {
                        return;
                    }

                    console.warn(
                        "Geocoding error:",
                        error
                    );
                }
            }


            function renderSuggestions(
                type,
                results,
                container
            ) {

                container.innerHTML = "";


                if (!results.length) {

                    container.innerHTML =
                        `<div class="nav-suggestion">
                            <strong>Nema rezultata</strong>
                            <small>Pokušajte precizniju lokaciju.</small>
                        </div>`;

                    container.classList.add(
                        "visible"
                    );

                    return;
                }


                results.forEach(
                    result => {

                        const button =
                            document.createElement(
                                "button"
                            );

                        button.type = "button";
                        button.className =
                            "nav-suggestion";


                        const displayName =
                            result.displayName ??
                            result.display_Name ??
                            result.display_name ??
                            result.name ??
                            "Lokacija";


                        const typeName =
                            result.type ??
                            result.class ??
                            "";


                        button.innerHTML = `
                            <strong>${escapeHtml(displayName)}</strong>
                            <small>${escapeHtml(typeName)}</small>
                        `;


                        button.addEventListener(
                            "click",
                            event => {

                                event.preventDefault();

                                selectGeocodingResult(
                                    type,
                                    result,
                                    container
                                );
                            }
                        );


                        container.appendChild(
                            button
                        );
                    }
                );


                container.classList.add(
                    "visible"
                );
            }


            function selectGeocodingResult(
                type,
                result,
                container
            ) {

                const lat =
                    Number(
                        result.lat ??
                        result.latitude
                    );


                const lon =
                    Number(
                        result.lon ??
                        result.longitude
                    );


                if (
                    !Number.isFinite(lat) ||
                    !Number.isFinite(lon)
                ) {
                    return;
                }


                const label =
                    result.displayName ??
                    result.display_Name ??
                    result.display_name ??
                    result.name ??
                    `${lat.toFixed(5)}, ${lon.toFixed(5)}`;


                if (type === "start") {

                    state.start = {
                        lat,
                        lon,
                        label
                    };

                    state.startResolved = true;

                    els.start.value = label;

                    setResolvedUi(
                        els.startResolved,
                        true,
                        `${lat.toFixed(5)}, ${lon.toFixed(5)}`
                    );

                } else {

                    state.destination = {
                        lat,
                        lon,
                        label
                    };

                    state.destinationResolved = true;

                    els.end.value = label;

                    setResolvedUi(
                        els.endResolved,
                        true,
                        `${lat.toFixed(5)}, ${lon.toFixed(5)}`
                    );
                }


                hideSuggestions(container);

                drawPointMarkers();

                if (state.startResolved && state.destinationResolved) {

                    state.map.fitBounds(
                        L.latLngBounds(
                            [
                                [state.start.lat, state.start.lon],
                                [
                                    state.destination.lat,
                                    state.destination.lon
                                ]
                            ]
                        ),
                        {
                            padding: [80, 80]
                        }
                    );
                }
            }


            function setResolvedUi(
                element,
                resolved,
                text
            ) {

                element.classList.remove(
                    "resolved",
                    "error"
                );


                if (resolved) {
                    element.classList.add(
                        "resolved"
                    );
                }


                const span =
                    element.querySelector(
                        "span"
                    );


                if (span) {
                    span.textContent = "";
                }


                const textNode =
                    [...element.childNodes]
                        .find(
                            node =>
                                node.nodeType ===
                                Node.TEXT_NODE
                        );


                if (textNode) {
                    textNode.textContent =
                        ` ${text}`;
                } else {
                    element.appendChild(
                        document.createTextNode(
                            ` ${text}`
                        )
                    );
                }
            }


            function hideSuggestions(
                element
            ) {

                element.classList.remove(
                    "visible"
                );

                element.innerHTML = "";
            }


            /*
             * ============================================================
             * MAP POINTS
             * ============================================================
             */

            function drawPointMarkers() {

                if (!state.map) {
                    return;
                }


                if (state.startMarker) {
                    state.map.removeLayer(
                        state.startMarker
                    );
                }


                if (state.destinationMarker) {
                    state.map.removeLayer(
                        state.destinationMarker
                    );
                }


                state.startMarker =
                    L.marker(
                        [
                            state.start.lat,
                            state.start.lon
                        ],
                        {
                            icon: createPointIcon(
                                false
                            ),
                            zIndexOffset: 700
                        }
                    )
                        .addTo(state.map)
                        .bindTooltip(
                            "START · " +
                            escapeHtml(
                                state.start.label
                            ),
                            {
                                direction: "top",
                                offset: [0, -9],
                                className: "nav-map-label"
                            }
                        );


                state.destinationMarker =
                    L.marker(
                        [
                            state.destination.lat,
                            state.destination.lon
                        ],
                        {
                            icon: createPointIcon(
                                true
                            ),
                            zIndexOffset: 700
                        }
                    )
                        .addTo(state.map)
                        .bindTooltip(
                            "CILJ · " +
                            escapeHtml(
                                state.destination.label
                            ),
                            {
                                direction: "top",
                                offset: [0, -9],
                                className: "nav-map-label"
                            }
                        );
            }


            function createPointIcon(
                destination
            ) {

                const className =
                    destination
                        ? "nav-marker destination"
                        : "nav-marker";


                return L.divIcon({
                    className: "",
                    html: `
                        <div class="${className}">
                            <span class="nav-marker-pulse"></span>
                            <span class="nav-marker-core"></span>
                        </div>
                    `,
                    iconSize: [30, 30],
                    iconAnchor: [15, 15]
                });
            }


            function createTruckIcon() {

                return L.divIcon({
                    className: "",
                    html: `
                        <div class="nav-truck-marker">
                            🚛
                        </div>
                    `,
                    iconSize: [40, 40],
                    iconAnchor: [20, 20]
                });
            }


            function handleMapClick(
                event
            ) {

                if (!state.mapPickTarget) {
                    return;
                }


                const point = {
                    lat: event.latlng.lat,
                    lon: event.latlng.lng,
                    label:
                        `${event.latlng.lat.toFixed(5)}, ${event.latlng.lng.toFixed(5)}`
                };


