@page
@{
    ViewData["Title"] = "Navigacija";
}

<div class="pm-page pm-navigation-page" data-module="navigation">

    <div class="nav-page-header">

        <div class="nav-page-heading">
            <div class="pm-eyebrow">FLEET NAVIGATION</div>

            <div class="nav-title-row">
                <h1 class="pm-page-title">Truck Navigation</h1>

                <span id="engineBadge" class="nav-engine-badge ready">
                    <span></span>
                    ROUTING READY
                </span>
            </div>

            <p class="pm-page-subtitle">
                Truck-aware routing preko PostGIS / OSM graph-a sa OSRM fallback-om,
                GPS praćenjem i kontrolom ograničenja vozila.
            </p>
        </div>

        <div class="nav-header-status">

            <div class="nav-status-card">
                <span class="nav-status-light"></span>

                <div>
                    <small>GPS STATUS</small>
                    <strong id="gpsStatus">OFF</strong>
                </div>
            </div>

            <div class="nav-status-card">
                <span class="nav-status-light emerald"></span>

                <div>
                    <small>ROUTING ENGINE</small>
                    <strong id="engineHeader">POSTGIS</strong>
                </div>
            </div>

        </div>

    </div>


    <div class="navigation-workspace">

        <!-- =====================================================
             MAP
             ===================================================== -->

        <section class="navigation-map-section">

            <div class="navigation-map-shell">

                <div id="navMap" class="navigation-map"></div>


                <div class="nav-map-topbar">

                    <div class="nav-map-mode-tabs">

                        <button type="button" class="nav-map-tab active" id="mapRouteTab">
                            Ruta
                        </button>

                        <button type="button" class="nav-map-tab" id="mapRestrictionsTab">
                            Ograničenja
                        </button>

                        <button type="button" class="nav-map-tab" id="mapGpsTab">
                            GPS
                        </button>

                    </div>

                    <div class="nav-map-engine">
                        <span></span>
                        <strong id="routeSafeBadge">TRUCK SAFE</strong>
                    </div>

                </div>


                <div class="nav-map-controls">

                    <button type="button" id="fitRoute" class="nav-map-control" title="Prikaži celu rutu">
                        ⤢
                    </button>

                    <button type="button" id="centerGps" class="nav-map-control" title="Centriraj GPS">
                        ◎
                    </button>

                </div>


                <div class="nav-map-route-card" id="mapRouteCard" hidden>

                    <div class="nav-map-route-card-head">

                        <div>
                            <small>AKTIVNA RUTA</small>
                            <strong id="mapRouteTitle">
                                Beograd → Novi Sad
                            </strong>
                        </div>

                        <span id="mapRouteStatus" class="pm-badge pm-badge-success">
                            Bezbedna
                        </span>

                    </div>

                    <div class="nav-map-route-stats">

                        <div>
                            <span>Udaljenost</span>
                            <strong id="mapDistance">—</strong>
                        </div>

                        <div>
                            <span>Trajanje</span>
                            <strong id="mapDuration">—</strong>
                        </div>

                        <div>
                            <span>ETA</span>
                            <strong id="mapEta">—</strong>
                        </div>

                    </div>

                </div>


                <div class="nav-next-overlay" id="nextInstruction" hidden>

                    <div class="nav-next-icon" id="nextInstructionIcon">
                        ↰
                    </div>

                    <div class="nav-next-copy">

                        <small>NAREDNI MANEVAR</small>

                        <strong id="nextInstructionText">
                            —
                        </strong>

                        <span id="nextInstructionDistance">
                            —
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             RIGHT / CONTROL PANEL
             ===================================================== -->

        <aside class="navigation-control-panel">

            <!-- ROUTE -->
            <section class="nav-control-card nav-route-control">

                <div class="nav-control-card-header">

                    <div>
                        <span class="nav-section-kicker">ROUTE PLANNER</span>
                        <h2>Planiranje rute</h2>
                    </div>

                    <button type="button" id="swapPoints" class="nav-icon-button"
                            title="Zameni polaznu i odredišnu tačku">
                        ⇅
                    </button>

                </div>


                <div class="nav-route-inputs">

                    <div class="nav-route-input-row">

                        <div class="nav-point-marker start"></div>

                        <div class="nav-input-wrapper">

                            <label for="navStart">
                                POLAZNA TAČKA
                            </label>

                            <input id="navStart" class="nav-input" type="text" autocomplete="off"
                                   value="Beograd, Srbija" placeholder="Grad, adresa ili lokacija" />

                            <div id="navStartSuggestions" class="nav-suggestions">
                            </div>

                            <div id="navStartResolved" class="nav-resolved">
                                <span></span>
                                Nije još potvrđeno
                            </div>

                        </div>

                    </div>


                    <div class="nav-route-connector"></div>


                    <div class="nav-route-input-row">

                        <div class="nav-point-marker destination"></div>

                        <div class="nav-input-wrapper">

                            <label for="navEnd">
                                ODREDIŠTE
                            </label>

                            <input id="navEnd" class="nav-input" type="text" autocomplete="off" value="Novi Sad, Srbija"
                                   placeholder="Grad, adresa ili lokacija" />

                            <div id="navEndSuggestions" class="nav-suggestions">
                            </div>

                            <div id="navEndResolved" class="nav-resolved">
                                <span></span>
                                Nije još potvrđeno
                            </div>

                        </div>

                    </div>

                </div>


                <div class="nav-map-pick-row">

                    <button type="button" id="pickStart" class="nav-small-action">
                        <span>＋</span>
                        Izaberi start na mapi
                    </button>

                    <button type="button" id="pickEnd" class="nav-small-action">
                        <span>＋</span>
                        Izaberi cilj na mapi
                    </button>

                </div>

            </section>


            <!-- VEHICLE MODE -->
            <section class="nav-control-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">VEHICLE</span>
                        <h2>Profil vozila</h2>
                    </div>

                    <span id="truckModeBadge" class="nav-mini-status">
                        HGV
                    </span>

                </div>


                <div class="nav-mode-switch">

                    <button type="button" id="truckMode" class="nav-mode-button active">

                        <span class="nav-mode-icon">▣</span>

                        <span>
                            <strong>Kamion</strong>
                            <small>Truck-aware</small>
                        </span>

                    </button>


                    <button type="button" id="carMode" class="nav-mode-button">

                        <span class="nav-mode-icon">▱</span>

                        <span>
                            <strong>Auto</strong>
                            <small>Standard routing</small>
                        </span>

                    </button>

                </div>


                <div class="nav-preset-row">

                    <label for="truckPreset">
                        PRESET
                    </label>

                    <select id="truckPreset" class="nav-select">

                        <option value="40t">
                            40 t · standardni šleper
                        </option>

                        <option value="12t">
                            12 t · srednji kamion
                        </option>

                        <option value="7.5t">
                            7.5 t · laki kamion
                        </option>

                        <option value="3.5t">
                            3.5 t · dostavno vozilo
                        </option>

                    </select>

                </div>


                <div id="truckFields" class="nav-truck-fields">

                    <div class="nav-spec-grid">

                        <div class="nav-field">

                            <label for="navWeight">
                                MASA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navWeight" type="number" class="nav-input" value="40" min="0.1" step="0.1" />

                                <span>t</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navHeight">
                                VISINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navHeight" type="number" class="nav-input" value="4" min="0.1" step="0.01" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navWidth">
                                ŠIRINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navWidth" type="number" class="nav-input" value="2.55" min="0.1"
                                       step="0.01" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navLength">
                                DUŽINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navLength" type="number" class="nav-input" value="16.5" min="0.1"
                                       step="0.1" />

                                <span>m</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxleLoad">
                                OSOVINSKO OPTEREĆENJE
                            </label>

                            <div class="nav-input-unit">
                                <input id="navAxleLoad" type="number" class="nav-input" value="10" min="0.1"
                                       step="0.1" />

                                <span>t</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAxles">
                                OSOVINE
                            </label>

                            <div class="nav-input-unit">
                                <input id="navAxles" type="number" class="nav-input" value="5" min="1" step="1" />

                                <span>kom</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navMaxSpeed">
                                MAKS. BRZINA
                            </label>

                            <div class="nav-input-unit">
                                <input id="navMaxSpeed" type="number" class="nav-input" value="90" min="1" step="1" />

                                <span>km/h</span>
                            </div>

                        </div>


                        <div class="nav-field">

                            <label for="navAdrClass">
                                ADR KLASA
                            </label>

                            <input id="navAdrClass" type="text" class="nav-input" placeholder="npr. 3" />

                        </div>

                    </div>


                    <div class="nav-check-grid">

                        <label class="nav-check">

                            <input id="navHazmat" type="checkbox" />

                            <span class="nav-check-box"></span>

                            <span>
                                ADR / opasna roba
                            </span>

                        </label>


                        <label class="nav-check">

                            <input id="navAvoid" type="checkbox" checked />

                            <span class="nav-check-box"></span>

                            <span>
                                Automatski izbegavaj restrikcije
                            </span>

                        </label>

                    </div>

                </div>

            </section>


            <!-- ROUTE ACTION -->
            <section class="nav-route-action">

                <button type="button" id="calcRoute" class="nav-calculate-button">

                    <span class="nav-calculate-icon">
                        ↗
                    </span>

                    <span>
                        <strong>Izračunaj truck rutu</strong>
                        <small>PostGIS · OSM · OSRM fallback</small>
                    </span>

                    <span class="nav-button-arrow">
                        →
                    </span>

                </button>


                <button type="button" id="useCurrentLocation" class="nav-location-button">

                    <span>◎</span>

                    <span>
                        Koristi moju trenutnu lokaciju
                    </span>

                </button>


                <div id="navError" class="nav-error" hidden>
                </div>

            </section>


            <!-- SUMMARY -->
            <section class="nav-control-card nav-summary-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">ROUTE RESULT</span>
                        <h2>Pregled rute</h2>
                    </div>

                    <span id="summarySafety" class="pm-badge pm-badge-success">
                        READY
                    </span>

                </div>


                <div class="nav-result-main">

                    <div class="nav-result-distance">
                        <span>UKUPNA UDALJENOST</span>
                        <strong id="summaryDistance">—</strong>
                    </div>

                    <div class="nav-result-duration">
                        <span>TRAJANJE</span>
                        <strong id="summaryDuration">—</strong>
                    </div>

                </div>


                <div class="nav-summary-grid">

                    <div>
                        <small>ETA</small>
                        <strong id="summaryEta">—</strong>
                    </div>

                    <div>
                        <small>ENGINE</small>
                        <strong id="summaryEngine">—</strong>
                    </div>

                    <div>
                        <small>RESTRIKCIJE</small>
                        <strong id="summaryDiagnostics">—</strong>
                    </div>

                </div>

            </section>


            <!-- ALTERNATIVES -->
            <section id="alternativesCard" class="nav-control-card nav-list-card" hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">ROUTES</span>
                        <h2>Alternativne rute</h2>
                    </div>

                    <span id="alternativeCount" class="nav-counter">
                        0
                    </span>

                </div>

                <div id="routeAlternatives" class="nav-alternatives">
                </div>

            </section>


            <!-- WARNINGS -->
            <section id="warningsCard" class="nav-control-card nav-list-card" hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">SAFETY</span>
                        <h2>Upozorenja</h2>
                    </div>

                    <span id="warningCount" class="nav-counter danger">
                        0
                    </span>

                </div>

                <div id="routeWarnings" class="nav-warning-list">
                </div>

            </section>


            <!-- MANEUVERS -->
            <section id="maneuversCard" class="nav-control-card nav-list-card" hidden>

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">DIRECTIONS</span>
                        <h2>Koraci navigacije</h2>
                    </div>

                    <span id="maneuverCount" class="nav-counter">
                        0
                    </span>

                </div>

                <div id="maneuverList" class="nav-maneuver-list">
                </div>

            </section>


            <!-- DIAGNOSTICS -->
            <section class="nav-control-card nav-diagnostics-card">

                <div class="nav-control-card-header compact">

                    <div>
                        <span class="nav-section-kicker">SYSTEM</span>
                        <h2>Routing diagnostics</h2>
                    </div>

                    <span class="nav-diagnostic-led"></span>

                </div>


                <div class="nav-diagnostics-grid">

                    <div>
                        <small>ENGINE</small>
                        <strong id="diagnosticEngine">—</strong>
                    </div>

                    <div>
                        <small>GRAPH</small>
                        <strong id="diagnosticGraph">—</strong>
                    </div>

                    <div>
                        <small>STATES</small>
                        <strong id="diagnosticStates">—</strong>
                    </div>

                    <div>
                        <small>FALLBACK</small>
                        <strong id="diagnosticFallback">—</strong>
                    </div>

                </div>

            </section>

        </aside>

    </div>


    <!-- =====================================================
         LIVE NAVIGATION BAR
         ===================================================== -->

    <section class="nav-live-panel" id="liveNavigationPanel">

        <div class="nav-live-left">

            <div class="nav-live-status">
                <span id="liveChip" class="nav-live-chip">
                    GPS OFF
                </span>
            </div>

            <div class="nav-live-position">

                <strong id="livePosition">
                    Lokacija nije aktivna
                </strong>

                <small id="liveAccuracy">
                    —
                </small>

            </div>

        </div>


        <div class="nav-live-stats">

            <div>
                <small>BRZINA</small>
                <strong id="liveSpeed">0 km/h</strong>
            </div>

            <div>
                <small>OFF ROUTE</small>
                <strong id="liveOffRoute">NE</strong>
            </div>

        </div>


        <div class="nav-live-actions">

            <button type="button" id="startLiveNavigation" class="pm-btn pm-btn-primary">

                ◎
                Pokreni live navigaciju

            </button>

            <button type="button" id="stopLiveNavigation" class="pm-btn pm-btn-danger" hidden>

                ■
                Zaustavi

            </button>

        </div>

    </section>


    <div class="nav-mobile-bottom-space"></div>
</div>

@section Scripts {
    <script src="~/js/promap-gps.js" asp-append-version="true"></script>
    <script src="~/js/promap-maneuvers.js" asp-append-version="true"></script>
    <script src="~/js/promap-routing.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
}