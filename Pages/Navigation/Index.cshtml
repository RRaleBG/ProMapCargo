@page "/navigation"
@{
    ViewData["Title"] = "Navigacija · ProMap Cargo";
}

<div id="app" style="display:none"></div>

<div class="pm-page" data-module="navigation">
    <header class="pm-header">
        <div>
            <div class="pm-brand">ProMap <span>Cargo</span></div>
            <div class="pm-kicker">Navigacija</div>
            <div class="pm-subtitle">Truck routing, map display, restrictions and ETA</div>
        </div>
        <div class="pm-header-actions">
            <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
            <a class="pm-btn" href="/profile">Profil</a>
        </div>
    </header>

    <div class="pm-layout">
        <aside class="pm-sidebar">
            <div class="pm-nav-title">OPERATIONS</div>
            <nav class="pm-nav">
                <a href="/dashboard">Dashboard</a>
                <a href="/dispatch">Command Center</a>
                <a href="/orders">Transportni nalozi</a>
                <a href="/trips">Ture</a>
                <a href="/vehicles">Vozila</a>
                <a href="/drivers">Vozači</a>
                <a class="active" href="/navigation">Navigacija</a>
                <a href="/alerts">Alerts</a>
                <a href="/moderation">Moderacija</a>
                <a href="/audit">Audit</a>
                <a href="/compliance">Compliance</a>
                <a href="/monitoring">Monitoring</a>
                <a href="/finance">Finansije</a>
                <a href="/reports">Izveštaji</a>
                <a href="/settings">Podešavanja</a>
                <a href="/profile">Profil</a>
                <a href="/admin">Administracija</a>
            </nav>

            <div class="pm-sidebar-footer">
                <b>Routing engine</b><br />
                PostGIS · OSM · Truck-aware<br />
                <span>Graph protected</span>
            </div>
        </aside>

        <main class="pm-content">
            <div class="pm-title">Navigacija</div>
            <div class="pm-muted" style="margin:5px 0 14px">
                Truck-aware routing preko PostGIS/OSM graph-a ili OSRM fallback-a.
            </div>

            <div class="pm-grid" style="grid-template-columns:390px minmax(0,1fr)">
                <div class="pm-card pm-card-body">
                    <div class="pm-row" style="margin-bottom:12px">
                        <button class="pm-btn pm-btn-primary" id="truckMode">Kamion</button>
                        <button class="pm-btn" type="button">Auto</button>
                    </div>

                    <div class="pm-grid">
                        <div>
                            <label class="pm-label" for="navStart">Start</label>
                            <div class="nav-search">
                                <input id="navStart" class="pm-field" value="Beograd, Srbija"
                                       placeholder="Adresa, grad, firma, POI ili koordinate..." autocomplete="off" />
                                <div id="navStartSuggestions" class="nav-suggestions"></div>
                            </div>
                        </div>

                        <div>
                            <label class="pm-label" for="navEnd">Destinacija</label>
                            <div class="nav-search">
                                <input id="navEnd" class="pm-field" value="Novi Sad, Srbija"
                                       placeholder="Adresa, grad, firma, POI ili koordinate..." autocomplete="off" />
                                <div id="navEndSuggestions" class="nav-suggestions"></div>
                            </div>
                        </div>

                        <div class="pm-grid pm-grid-2">
                            <input id="navWeight" class="pm-field" value="40" placeholder="Masa t" />
                            <input id="navHeight" class="pm-field" value="4" placeholder="Visina m" />
                        </div>

                        <div class="pm-grid pm-grid-2">
                            <input id="navWidth" class="pm-field" value="2.55" placeholder="Širina m" />
                            <input id="navLength" class="pm-field" value="16.5" placeholder="Dužina m" />
                        </div>

                        <label class="pm-muted">
                            <input id="navAvoid" type="checkbox" checked />
                            Izbegni aktivne restrikcije
                        </label>

                        <button class="pm-btn pm-btn-primary" id="calcRoute" type="button">
                            Izračunaj truck rutu
                        </button>

                        <pre id="navResult" class="pm-muted" style="white-space:pre-wrap"></pre>
                    </div>
                </div>

                <div class="pm-card">
                    <div id="navMap" class="pm-map" style="height:650px"></div>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .pm-page
    {
        min-height: 100vh;
        background: linear-gradient(135deg, #022c22, #064e3b 55%, #075e54);
        color: #f8fafc;
        font-family: Inter, system-ui, -apple-system, Segoe UI, sans-serif;
    }

    .pm-header
    {
        height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        background: rgba(2,44,34,.9);
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(12px);
    }

    .pm-brand
    {
        font-size: 21px;
        font-weight: 900;
    }

        .pm-brand span
        {
            color: #2dd4bf;
        }

    .pm-kicker
    {
        font-size: 12px;
        font-weight: 800;
        margin-top: 3px;
    }

    .pm-subtitle
    {
        font-size: 11px;
        color: #a7f3d0;
        margin-top: 2px;
    }

    .pm-header-actions
    {
        display: flex;
        gap: 8px;
    }

    .pm-btn
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 9px;
        padding: 9px 13px;
        color: #f8fafc;
        text-decoration: none;
        background: #075e54;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

        .pm-btn:hover
        {
            filter: brightness(1.12);
        }

    .pm-btn-primary
    {
        background: #10b981;
        color: #022c22;
        border-color: #10b981;
    }

    .pm-layout
    {
        display: flex;
        min-height: calc(100vh - 74px);
    }

    .pm-sidebar
    {
        width: 238px;
        flex: 0 0 238px;
        border-right: 1px solid rgba(255,255,255,.1);
        padding: 20px 12px;
        display: flex;
        flex-direction: column;
    }

    .pm-nav-title
    {
        font-size: 10px;
        color: #6ee7b7;
        font-weight: 900;
        letter-spacing: .12em;
        padding: 0 10px 8px;
    }

    .pm-nav
    {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .pm-nav a
        {
            color: #c8f7e5;
            text-decoration: none;
            padding: 10px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
        }

            .pm-nav a:hover,
            .pm-nav a.active
            {
                background: #075e54;
                color: #fff;
            }

    .pm-sidebar-footer
    {
        margin-top: auto;
        border-top: 1px solid rgba(255,255,255,.1);
        padding: 14px 10px;
        font-size: 10px;
        color: #a7f3d0;
        line-height: 1.65;
    }

        .pm-sidebar-footer span
        {
            color: #5eead4;
        }

    .pm-content
    {
        flex: 1;
        min-width: 0;
        padding: 25px;
        max-width: 1600px;
    }

    .pm-grid
    {
        display: grid;
        gap: 14px;
    }

    .pm-grid-2
    {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .pm-card
    {
        background: rgba(6,78,59,.86);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 14px;
        box-shadow: 0 12px 35px rgba(0,0,0,.12);
    }

    .pm-card-body
    {
        padding: 16px;
    }

    .pm-title
    {
        font-size: 22px;
        font-weight: 900;
    }

    .pm-muted
    {
        color: #a7f3d0;
        font-size: 11px;
    }

    .pm-label
    {
        display: block;
        color: #a7f3d0;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .pm-field
    {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,.12);
        background: #043f31;
        color: #fff;
        border-radius: 9px;
        padding: 10px;
        font-size: 12px;
        outline: none;
    }

        .pm-field:focus
        {
            border-color: #2dd4bf;
        }

    .pm-row
    {
        display: flex;
        gap: 9px;
        align-items: center;
    }

    .pm-map
    {
        height: 430px;
        border-radius: 12px;
        overflow: hidden;
        background: #0b3b31;
    }


    .nav-search
    {
        position: relative;
    }

    .nav-suggestions
    {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 4px);
        z-index: 1000;
        display: none;
        max-height: 260px;
        overflow-y: auto;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 10px;
        background: #043f31;
        box-shadow: 0 14px 30px rgba(0,0,0,.28);
    }

    .nav-suggestion
    {
        padding: 10px 12px;
        border-bottom: 1px solid rgba(255,255,255,.08);
        cursor: pointer;
        color: #f8fafc;
        font-size: 12px;
        line-height: 1.35;
    }

        .nav-suggestion:last-child
        {
            border-bottom: 0;
        }

        .nav-suggestion:hover,
        .nav-suggestion.active
        {
            background: #075e54;
        }

        .nav-suggestion small
        {
            display: block;
            margin-top: 3px;
            color: #a7f3d0;
            font-size: 10px;
        }

    .nav-resolved
    {
        margin-top: 4px;
        min-height: 14px;
        color: #a7f3d0;
        font-size: 10px;
    }

    .nav-error
    {
        color: #fecaca;
    }

    @@media (max-width:1000px)
    {
        .pm-sidebar
        {
            display: none;
        }

        .pm-grid-2
        {
            grid-template-columns: 1fr 1fr;
        }

        .pm-content
        {
            padding: 15px;
        }
    }

    @@media (max-width:620px)
    {
        .pm-header
        {
            padding: 0 12px;
        }

        .pm-header-actions .pm-btn:first-child
        {
            display: none;
        }

        .pm-grid-2
        {
            grid-template-columns: 1fr;
        }

        .pm-content
        {
            padding: 10px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (!window.L) return;

        const map = L.map('navMap').setView([44.9, 20.7], 7);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        const calcButton = document.getElementById('calcRoute');
        const navStart = document.getElementById('navStart');
        const navEnd = document.getElementById('navEnd');
        const navWeight = document.getElementById('navWeight');
        const navHeight = document.getElementById('navHeight');
        const navWidth = document.getElementById('navWidth');
        const navLength = document.getElementById('navLength');
        const navAvoid = document.getElementById('navAvoid');
        const navResult = document.getElementById('navResult');
        const startSuggestions = document.getElementById('navStartSuggestions');
        const endSuggestions = document.getElementById('navEndSuggestions');

        let startLocation = null;
        let endLocation = null;
        let routeLayer = null;
        let markerStart = null;
        let markerEnd = null;
        const timers = new WeakMap();

        const normalize = value => (value || '').trim();

        function parseCoordinates(value) {
            const match = normalize(value).match(
                /^\s*(-?\d+(?:[.,]\d+)?)\s*[,;\s]\s*(-?\d+(?:[.,]\d+)?)\s*$/
            );

            if (!match) return null;

            const lat = Number(match[1].replace(',', '.'));
            const lon = Number(match[2].replace(',', '.'));

            if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;
            if (lat < -90 || lat > 90 || lon < -180 || lon > 180) return null;

            return {
                lat,
                lon,
                displayName: `${lat.toFixed(6)}, ${lon.toFixed(6)}`
            };
        }

        function extractLocations(payload) {
            const candidates =
                Array.isArray(payload) ? payload :
                    Array.isArray(payload?.results) ? payload.results :
                        Array.isArray(payload?.results) ? payload.results :
                            Array.isArray(payload?.items) ? payload.items :
                                Array.isArray(payload?.data) ? payload.data :
                                    Array.isArray(payload?.features) ? payload.features :
                                        payload ? [payload] : [];

            return candidates.map(item => {
                const geometry = item?.geometry?.coordinates;
                const lat = Number(
                    item?.lat ??
                    item?.latitude ??
                    item?.location?.lat ??
                    item?.point?.lat ??
                    (Array.isArray(geometry) ? geometry[1] : NaN)
                );
                const lon = Number(
                    item?.lon ??
                    item?.lng ??
                    item?.longitude ??
                    item?.location?.lon ??
                    item?.point?.lon ??
                    (Array.isArray(geometry) ? geometry[0] : NaN)
                );

                if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;

                return {
                    lat,
                    lon,
                    displayName:
                        item?.displayName ??
                        item?.display_name ??
                        item?.name ??
                        item?.label ??
                        `${lat.toFixed(6)}, ${lon.toFixed(6)}`
                };
            }).filter(x =>
                x &&
                x.lat >= -90 && x.lat <= 90 &&
                x.lon >= -180 && x.lon <= 180
            );
        }

        async function geocode(query) {
            const q = normalize(query);

            if (!q) {
                throw new Error('Unesite mesto, adresu ili objekat.');
            }

            const coordinates = parseCoordinates(q);
            if (coordinates) return [coordinates];

            // Prefer the application's own geocoder. This keeps routing independent
            // from the browser and allows the server to use its configured provider.
            try {
                const response = await fetch(
                    `/api/geocode?query=${encodeURIComponent(q)}`,
                    {
                        headers: { 'Accept': 'application/json' }
                    }
                );

                if (response.ok) {
                    const payload = await response.json();
                    const locations = extractLocations(payload);
                    if (locations.length) return locations;
                }
            } catch (error) {
                console.warn('Internal geocoder unavailable:', error);
            }

            // Public fallback. Used only when the application geocoder is unavailable.
            const response = await fetch(
                `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&addressdetails=1&accept-language=sr,en&q=${encodeURIComponent(q)}`,
                { headers: { 'Accept': 'application/json' } }
            );

            if (!response.ok) {
                throw new Error(`Geocoding HTTP ${response.status}`);
            }

            const payload = await response.json();
            const locations = extractLocations(payload);

            if (!locations.length) {
                throw new Error(`Nije pronađeno mesto za: "${q}"`);
            }

            return locations;
        }

        function renderSuggestions(container, locations, onSelect) {
            container.innerHTML = '';

            if (!locations.length) {
                container.style.display = 'none';
                return;
            }

            locations.forEach((location, index) => {
                const item = document.createElement('div');
                item.className = 'nav-suggestion';
                item.innerHTML =
                    `${escapeHtml(location.displayName)}<small>${location.lat.toFixed(6)}, ${location.lon.toFixed(6)}</small>`;

                item.addEventListener('mousedown', event => {
                    event.preventDefault();
                    onSelect(location);
                });

                container.appendChild(item);
            });

            container.style.display = 'block';
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function closeSuggestions(container) {
            container.innerHTML = '';
            container.style.display = 'none';
        }

        function setResolved(input, location) {
            input.dataset.lat = String(location.lat);
            input.dataset.lon = String(location.lon);
            input.title = location.displayName;
        }

        function clearResolved(input) {
            delete input.dataset.lat;
            delete input.dataset.lon;
            input.title = '';
        }

        function selectLocation(input, suggestions, location, isStart) {
            input.value = location.displayName;
            setResolved(input, location);
            closeSuggestions(suggestions);

            if (isStart) {
                startLocation = location;
                markerStart?.remove();
                markerStart = L.marker([location.lat, location.lon])
                    .addTo(map)
                    .bindPopup(`<b>Start</b><br>${escapeHtml(location.displayName)}`);
            } else {
                endLocation = location;
                markerEnd?.remove();
                markerEnd = L.marker([location.lat, location.lon])
                    .addTo(map)
                    .bindPopup(`<b>Destinacija</b><br>${escapeHtml(location.displayName)}`);
            }

            if (startLocation && endLocation) {
                map.fitBounds(
                    L.latLngBounds(
                        [startLocation.lat, startLocation.lon],
                        [endLocation.lat, endLocation.lon]
                    ),
                    { padding: [35, 35] }
                );
            }
        }

        function setupGeocoder(input, suggestions, isStart) {
            input.addEventListener('input', () => {
                clearResolved(input);
                if (isStart) startLocation = null;
                else endLocation = null;

                const q = normalize(input.value);
                clearTimeout(timers.get(input));

                if (q.length < 2) {
                    closeSuggestions(suggestions);
                    return;
                }

                const timer = setTimeout(async () => {
                    try {
                        const locations = await geocode(q);
                        renderSuggestions(suggestions, locations, location => {
                            selectLocation(input, suggestions, location, isStart);
                        });
                    } catch (error) {
                        console.warn('Geocoding:', error);
                        closeSuggestions(suggestions);
                    }
                }, 350);

                timers.set(input, timer);
            });

            input.addEventListener('keydown', async event => {
                if (event.key === 'Enter') {
                    event.preventDefault();

                    try {
                        const locations = await geocode(input.value);
                        if (!locations.length) {
                            throw new Error('Mesto nije pronađeno.');
                        }

                        selectLocation(input, suggestions, locations[0], isStart);
                    } catch (error) {
                        navResult.textContent = 'Lokacija nije pronađena: ' + error.message;
                    }
                }

                if (event.key === 'Escape') {
                    closeSuggestions(suggestions);
                }
            });

            input.addEventListener('blur', () => {
                setTimeout(() => closeSuggestions(suggestions), 180);
            });
        }

        async function resolveInput(input, cachedLocation) {
            if (cachedLocation) return cachedLocation;

            const coordinates = parseCoordinates(input.value);
            if (coordinates) return coordinates;

            const lat = Number(input.dataset.lat);
            const lon = Number(input.dataset.lon);

            if (Number.isFinite(lat) && Number.isFinite(lon)) {
                return {
                    lat,
                    lon,
                    displayName: input.value
                };
            }

            const locations = await geocode(input.value);
            return locations[0];
        }

        setupGeocoder(navStart, startSuggestions, true);
        setupGeocoder(navEnd, endSuggestions, false);

        // Resolve the initial human-readable defaults without forcing the user
        // to enter coordinates manually.
        Promise.all([
            resolveInput(navStart, startLocation),
            resolveInput(navEnd, endLocation)
        ]).then(([start, end]) => {
            startLocation = start;
            endLocation = end;
            setResolved(navStart, start);
            setResolved(navEnd, end);

            markerStart = L.marker([start.lat, start.lon])
                .addTo(map)
                .bindPopup(`<b>Start</b><br>${escapeHtml(start.displayName)}`);

            markerEnd = L.marker([end.lat, end.lon])
                .addTo(map)
                .bindPopup(`<b>Destinacija</b><br>${escapeHtml(end.displayName)}`);

            map.fitBounds(
                L.latLngBounds(
                    [start.lat, start.lon],
                    [end.lat, end.lon]
                ),
                { padding: [35, 35] }
            );
        }).catch(error => {
            console.warn('Initial geocoding:', error);
        });

        calcButton.addEventListener('click', async () => {
            calcButton.disabled = true;

            try {
                navResult.textContent = 'Pronalazim start i destinaciju...';

                const start = await resolveInput(navStart, startLocation);
                const destination = await resolveInput(navEnd, endLocation);

                if (!start || !destination) {
                    throw new Error('Start i destinacija moraju biti pronađeni.');
                }

                startLocation = start;
                endLocation = destination;
                setResolved(navStart, start);
                setResolved(navEnd, destination);

                const truck = {
                    grossWeightTons: Number(navWeight.value),
                    heightMeters: Number(navHeight.value),
                    widthMeters: Number(navWidth.value),
                    lengthMeters: Number(navLength.value),
                    axleLoadTons: 10,
                    axles: 5,
                    isHgv: true,
                    commercial: true,
                    hazmat: false,
                    vehicleClass: 'HeavyGoods',
                    maxSpeedKmh: 90
                };

                const requestBody = {
                    start: {
                        lat: start.lat,
                        lon: start.lon
                    },
                    destination: {
                        lat: destination.lat,
                        lon: destination.lon
                    },
                    profile: 'truck',
                    avoidRestricted: navAvoid.checked,
                    truck
                };

                navResult.textContent =
                    `Ruta: ${start.displayName} → ${destination.displayName}\nRačunam...`;

                const response = await fetch('/api/route', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(requestBody)
                });

                const responseText = await response.text();

                let routeData = null;

                try {
                    routeData = responseText ? JSON.parse(responseText) : null;
                } catch {
                    routeData = null;
                }

                if (!response.ok) {
                    throw new Error(
                        routeData?.message ||
                        routeData?.title ||
                        routeData?.detail ||
                        responseText ||
                        `Routing HTTP ${response.status}`
                    );
                }

                if (!routeData) {
                    throw new Error('Routing API je vratio prazan odgovor.');
                }

                const route = routeData.routes?.[0];

                if (!route) {
                    throw new Error('Routing API nije vratio nijednu rutu.');
                }

                navResult.textContent = JSON.stringify({
                    code: routeData.code,
                    truckSafe: routeData.isTruckSafe,
                    distance: route.distance,
                    duration: route.duration,
                    start: start.displayName,
                    destination: destination.displayName
                }, null, 2);

                if (routeLayer) {
                    map.removeLayer(routeLayer);
                }

                if (route.geometry) {
                    routeLayer = L.geoJSON(route.geometry, {
                        style: {
                            weight: 6
                        }
                    }).addTo(map);

                    map.fitBounds(routeLayer.getBounds(), {
                        padding: [35, 35]
                    });
                }
            } catch (error) {
                console.error('Navigation routing error:', error);

                navResult.textContent =
                    'Routing API nije dostupan: ' +
                    (error instanceof Error ? error.message : String(error));
            } finally {
                calcButton.disabled = false;
            }
        });
    });

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.pm-page a[href]').forEach(a => {
            a.addEventListener('click', event => {
                if (a.origin === location.origin) {
                    event.stopPropagation();
                }
            }, true);
        });
    });
</script>
