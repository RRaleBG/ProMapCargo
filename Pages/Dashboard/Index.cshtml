@page "/dashboard"
@{
    ViewData["Title"] = "Dashboard · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="dashboard">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Dashboard</div>
      <div class="pm-subtitle">Executive fleet overview and daily operations</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="active" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="" href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-grid pm-grid-6"><div class="pm-card pm-stat"><small>Aktivne ture</small><div class="pm-value">12</div><div class="pm-muted">u tranzitu</div></div><div class="pm-card pm-stat"><small>Vozila online</small><div class="pm-value">38</div><div class="pm-muted">od 41</div></div><div class="pm-card pm-stat"><small>GPS lost</small><div class="pm-value">2</div><div class="pm-muted">zahteva pažnju</div></div><div class="pm-card pm-stat"><small>Off-route</small><div class="pm-value">1</div><div class="pm-muted">automatski alert</div></div><div class="pm-card pm-stat"><small>Granice</small><div class="pm-value">3</div><div class="pm-muted">vozila čekaju</div></div><div class="pm-card pm-stat"><small>Compliance</small><div class="pm-value">96%</div><div class="pm-muted">fleet score</div></div></div><div style="height:14px"></div><div class="pm-grid pm-grid-2"><div class="pm-card"><div class="pm-card-head"><div><b>Operativni pregled</b><div class="pm-muted">Današnji učinak flote</div></div><span class="pm-badge">LIVE</span></div><div class="pm-card-body pm-list"><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>Delivery success</b><b>94%</b></div><div class="pm-progress"><span style="width:94%"></span></div></div><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>On-time departures</b><b>88%</b></div><div class="pm-progress"><span style="width:88%"></span></div></div><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>Fuel efficiency</b><b>81%</b></div><div class="pm-progress"><span style="width:81%"></span></div></div></div></div><div class="pm-card"><div class="pm-card-head"><b>Prioritetni događaji</b><a class="pm-btn" href="/alerts">Svi alerti</a></div><div class="pm-card-body pm-list"><div class="pm-item"><span class="pm-badge danger">OFF-ROUTE</span><div style="margin-top:6px"><b>BG-241-AA</b> je 84 m van planirane rute.</div></div><div class="pm-item"><span class="pm-badge warn">BORDER</span><div style="margin-top:6px"><b>Horgoš</b> · procenjeno čekanje 31 min.</div></div><div class="pm-item"><span class="pm-badge info">GPS</span><div style="margin-top:6px"><b>NI-401-TT</b> nema telemetriju 4 min.</div></div></div></div></div>
    </main>
  </div>
</div>

<style>
.pm-page{min-height:100vh;background:linear-gradient(135deg,#022c22,#064e3b 55%,#075e54);color:#f8fafc;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}
.pm-header{height:74px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid rgba(255,255,255,.1);background:rgba(2,44,34,.9);position:sticky;top:0;z-index:40;backdrop-filter:blur(12px)}
.pm-brand{font-size:21px;font-weight:900} .pm-brand span{color:#2dd4bf} .pm-kicker{font-size:12px;font-weight:800;margin-top:3px} .pm-subtitle{font-size:11px;color:#a7f3d0;margin-top:2px}
.pm-header-actions{display:flex;gap:8px} .pm-btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.12);border-radius:9px;padding:9px 13px;color:#f8fafc;text-decoration:none;background:#075e54;font-size:12px;font-weight:800;cursor:pointer} .pm-btn:hover{filter:brightness(1.12)} .pm-btn-primary{background:#10b981;color:#022c22;border-color:#10b981}
.pm-layout{display:flex;min-height:calc(100vh - 74px)} .pm-sidebar{width:238px;flex:0 0 238px;border-right:1px solid rgba(255,255,255,.1);padding:20px 12px;display:flex;flex-direction:column} .pm-nav-title{font-size:10px;color:#6ee7b7;font-weight:900;letter-spacing:.12em;padding:0 10px 8px} .pm-nav{display:flex;flex-direction:column;gap:4px} .pm-nav a{color:#c8f7e5;text-decoration:none;padding:10px;border-radius:8px;font-size:12px;font-weight:700} .pm-nav a:hover,.pm-nav a.active{background:#075e54;color:#fff} .pm-sidebar-footer{margin-top:auto;border-top:1px solid rgba(255,255,255,.1);padding:14px 10px;font-size:10px;color:#a7f3d0;line-height:1.65} .pm-sidebar-footer span{color:#5eead4}
.pm-content{flex:1;min-width:0;padding:25px;max-width:1600px} .pm-grid{display:grid;gap:14px} .pm-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))} .pm-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))} .pm-grid-4{grid-template-columns:repeat(4,minmax(0,1fr))} .pm-grid-6{grid-template-columns:repeat(6,minmax(0,1fr))}
.pm-card{background:rgba(6,78,59,.86);border:1px solid rgba(255,255,255,.1);border-radius:14px;box-shadow:0 12px 35px rgba(0,0,0,.12)} .pm-card-head{padding:16px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between} .pm-card-body{padding:16px}
.pm-title{font-size:22px;font-weight:900} .pm-h2{font-size:15px;font-weight:900} .pm-muted{color:#a7f3d0;font-size:11px} .pm-label{display:block;color:#a7f3d0;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px} .pm-value{font-size:24px;font-weight:900;margin-top:3px}
.pm-field{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.12);background:#043f31;color:#fff;border-radius:9px;padding:10px;font-size:12px;outline:none} .pm-field:focus{border-color:#2dd4bf} .pm-row{display:flex;gap:9px;align-items:center}
.pm-table{width:100%;border-collapse:collapse;font-size:12px} .pm-table th{color:#a7f3d0;font-size:10px;text-transform:uppercase;text-align:left;padding:11px;border-bottom:1px solid rgba(255,255,255,.1)} .pm-table td{padding:12px 11px;border-bottom:1px solid rgba(255,255,255,.07)} .pm-table tr:hover td{background:rgba(255,255,255,.025)}
.pm-badge{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:9px;font-weight:900;background:#075e54;color:#99f6e4} .pm-badge.warn{background:#713f12;color:#fde68a} .pm-badge.danger{background:#7f1d1d;color:#fecaca} .pm-badge.info{background:#164e63;color:#a5f3fc}
.pm-actions{display:flex;gap:7px;flex-wrap:wrap} .pm-progress{height:7px;background:#022c22;border-radius:999px;overflow:hidden} .pm-progress span{display:block;height:100%;background:#10b981;border-radius:999px}
.pm-list{display:flex;flex-direction:column;gap:8px} .pm-item{padding:12px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(7,94,84,.45)} .pm-map{height:430px;border-radius:12px;overflow:hidden;background:#0b3b31} .pm-empty{padding:38px;text-align:center;color:#a7f3d0}
.pm-stat{padding:15px} .pm-stat small{color:#a7f3d0;font-size:10px;text-transform:uppercase}
@@media(max-width:1000px){.pm-sidebar{display:none}.pm-grid-6,.pm-grid-4,.pm-grid-3,.pm-grid-2{grid-template-columns:1fr 1fr}
.pm-content{padding:15px}}
 @@media(max-width:620px){.pm-header{padding:0 12px}.pm-header-actions .pm-btn:first-child{display:none}.pm-grid-6,.pm-grid-4,.pm-grid-3,.pm-grid-2{grid-template-columns:1fr}.pm-content{padding:10px}}
</style>
<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>{
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>
