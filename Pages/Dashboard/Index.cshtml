@page "/dashboard"
@{
    ViewData["Title"] = "Dashboard · ProMap Cargo";
}

<style>
    .pm-dashboard-page
    {
        --dashboard-card: rgba(5, 31, 25, .88);
        --dashboard-card-2: rgba(7, 39, 31, .96);
        --dashboard-border: rgba(45, 212, 191, .14);
        --dashboard-border-strong: rgba(45, 212, 191, .28);
        --dashboard-text: #ecfdf5;
        --dashboard-muted: #7da99f;
        --dashboard-green: #10b981;
        --dashboard-teal: #2dd4bf;
        --dashboard-yellow: #f59e0b;
        --dashboard-red: #ef4444;
        --dashboard-blue: #38bdf8;
        width: 100%;
        min-width: 0;
    }

        .pm-dashboard-page *,
        .pm-dashboard-page *::before,
        .pm-dashboard-page *::after
        {
            box-sizing: border-box;
        }

    .pm-dashboard-content
    {
        width: 100%;
        min-width: 0;
        padding: 24px;
        background: radial-gradient(circle at 72% 0%, rgba(16, 185, 129, .08), transparent 34%), linear-gradient(180deg, #03251d 0%, #021b16 100%);
        border-radius: 14px;
    }

    .pm-dashboard-header
    {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .pm-dashboard-heading
    {
        min-width: 0;
    }

    .pm-dashboard-kicker
    {
        color: #34d399;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .pm-dashboard-title
    {
        margin: 0;
        color: var(--dashboard-text);
        font-size: 29px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -.035em;
    }

    .pm-dashboard-subtitle
    {
        margin-top: 8px;
        color: var(--dashboard-muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .pm-dashboard-header-actions
    {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .pm-dashboard-btn
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 0 13px;
        border-radius: 9px;
        border: 1px solid var(--dashboard-border-strong);
        background: rgba(5, 31, 25, .8);
        color: #c7e9e1;
        text-decoration: none;
        font-size: 10px;
        font-weight: 750;
        cursor: pointer;
        transition: background .18s ease, border-color .18s ease, transform .18s ease;
    }

        .pm-dashboard-btn:hover
        {
            background: rgba(16, 185, 129, .12);
            border-color: rgba(45, 212, 191, .34);
            transform: translateY(-1px);
            color: #ecfdf5;
        }

        .pm-dashboard-btn.primary
        {
            background: #0d8f6b;
            border-color: #10b981;
            color: white;
        }

            .pm-dashboard-btn.primary:hover
            {
                background: #0fa77d;
            }

    .pm-dashboard-grid
    {
        display: grid;
        gap: 14px;
    }

    .pm-dashboard-kpis
    {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        margin-bottom: 14px;
    }

    .pm-dashboard-card
    {
        position: relative;
        border: 1px solid var(--dashboard-border);
        border-radius: 14px;
        background: linear-gradient( 145deg, rgba(7, 42, 33, .94), rgba(3, 25, 20, .96) );
        box-shadow: 0 16px 40px rgba(0, 0, 0, .12);
        overflow: hidden;
    }

        .pm-dashboard-card::before
        {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient( 120deg, rgba(45, 212, 191, .035), transparent 45% );
        }

    .pm-dashboard-kpi
    {
        min-height: 142px;
        padding: 17px;
    }

    .pm-dashboard-kpi-head
    {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .pm-dashboard-kpi-label
    {
        color: #7fa9a0;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .pm-dashboard-kpi-icon
    {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(45, 212, 191, .08);
        color: #5eead4;
        font-size: 12px;
        flex: 0 0 auto;
    }

    .pm-dashboard-kpi-value
    {
        margin-top: 14px;
        color: #ecfdf5;
        font-size: 29px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -.04em;
    }

    .pm-dashboard-kpi-bottom
    {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        color: #648e84;
        font-size: 10px;
    }

    .pm-dashboard-trend
    {
        color: #34d399;
        font-weight: 750;
    }

        .pm-dashboard-trend.warn
        {
            color: #fbbf24;
        }

        .pm-dashboard-trend.danger
        {
            color: #fb7185;
        }

    .pm-dashboard-main-grid
    {
        grid-template-columns: minmax(0, 1.65fr) minmax(320px, .85fr);
        margin-bottom: 14px;
    }

    .pm-dashboard-map-card
    {
        min-height: 500px;
    }

    .pm-dashboard-card-head
    {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 17px;
        border-bottom: 1px solid var(--dashboard-border);
    }

    .pm-dashboard-card-title
    {
        color: #e8fbf5;
        font-size: 13px;
        font-weight: 800;
    }

    .pm-dashboard-card-subtitle
    {
        margin-top: 3px;
        color: #668f85;
        font-size: 10px;
        line-height: 1.4;
    }

    .pm-dashboard-live
    {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px;
        border: 1px solid rgba(16, 185, 129, .2);
        border-radius: 999px;
        color: #6ee7b7;
        background: rgba(16, 185, 129, .07);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .06em;
        white-space: nowrap;
    }

    .pm-dashboard-live-dot
    {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 10px rgba(52, 211, 153, .8);
        flex: 0 0 auto;
    }

    .pm-dashboard-map
    {
        position: relative;
        height: 418px;
        background: #10241f;
    }

    #dashboardMap
    {
        width: 100%;
        height: 100%;
        min-height: 300px;
    }

    .pm-dashboard-map-overlay
    {
        position: absolute;
        z-index: 500;
        left: 14px;
        bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 10px;
        border: 1px solid rgba(255, 255, 255, .12);
        border-radius: 9px;
        background: rgba(2, 24, 19, .9);
        backdrop-filter: blur(10px);
        color: #b9d7d0;
        font-size: 9px;
    }

        .pm-dashboard-map-overlay strong
        {
            color: #ecfdf5;
        }

    .pm-dashboard-map-controls
    {
        position: absolute;
        z-index: 500;
        right: 12px;
        top: 12px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .pm-dashboard-map-btn
    {
        width: 32px;
        height: 32px;
        border: 1px solid rgba(255, 255, 255, .16);
        border-radius: 8px;
        background: rgba(2, 24, 19, .9);
        color: #d1fae5;
        cursor: pointer;
        backdrop-filter: blur(10px);
        font-size: 15px;
        line-height: 1;
    }

        .pm-dashboard-map-btn:hover
        {
            background: rgba(16, 185, 129, .22);
        }

    .pm-dashboard-status-grid
    {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        padding: 12px 14px;
        border-top: 1px solid var(--dashboard-border);
    }

    .pm-dashboard-mini-stat
    {
        padding: 10px;
        border-radius: 9px;
        background: rgba(255, 255, 255, .018);
        border: 1px solid rgba(45, 212, 191, .08);
    }

        .pm-dashboard-mini-stat small
        {
            display: block;
            color: #638d84;
            font-size: 9px;
        }

        .pm-dashboard-mini-stat strong
        {
            display: block;
            margin-top: 4px;
            color: #dffaf1;
            font-size: 14px;
        }

    .pm-dashboard-side-stack
    {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .pm-dashboard-alerts
    {
        flex: 1;
    }

    .pm-dashboard-list
    {
        padding: 6px 14px 12px;
    }

    .pm-dashboard-event
    {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(45, 212, 191, .07);
    }

        .pm-dashboard-event:last-child
        {
            border-bottom: 0;
        }

    .pm-dashboard-event-icon
    {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(56, 189, 248, .08);
        color: #7dd3fc;
        font-size: 11px;
    }

        .pm-dashboard-event-icon.danger
        {
            background: rgba(239, 68, 68, .08);
            color: #fca5a5;
        }

        .pm-dashboard-event-icon.warn
        {
            background: rgba(245, 158, 11, .08);
            color: #fcd34d;
        }

        .pm-dashboard-event-icon.ok
        {
            background: rgba(16, 185, 129, .08);
            color: #6ee7b7;
        }

    .pm-dashboard-event-title
    {
        color: #d8eee8;
        font-size: 11px;
        font-weight: 750;
    }

    .pm-dashboard-event-text
    {
        margin-top: 3px;
        color: #638b82;
        font-size: 9px;
        line-height: 1.4;
    }

    .pm-dashboard-event-time
    {
        color: #557b72;
        font-size: 9px;
        white-space: nowrap;
    }

    .pm-dashboard-pill
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 7px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .05em;
        white-space: nowrap;
    }

        .pm-dashboard-pill.green
        {
            color: #6ee7b7;
            background: rgba(16, 185, 129, .09);
        }

        .pm-dashboard-pill.yellow
        {
            color: #fcd34d;
            background: rgba(245, 158, 11, .09);
        }

        .pm-dashboard-pill.red
        {
            color: #fda4af;
            background: rgba(239, 68, 68, .09);
        }

        .pm-dashboard-pill.blue
        {
            color: #7dd3fc;
            background: rgba(56, 189, 248, .09);
        }

    .pm-dashboard-performance
    {
        padding: 16px;
    }

    .pm-dashboard-progress
    {
        margin-top: 14px;
    }

        .pm-dashboard-progress:first-child
        {
            margin-top: 0;
        }

    .pm-dashboard-progress-row
    {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: #9fc1b8;
        font-size: 10px;
        font-weight: 700;
        margin-bottom: 6px;
    }

        .pm-dashboard-progress-row strong
        {
            color: #d9f8ef;
        }

    .pm-dashboard-progress-track
    {
        height: 6px;
        border-radius: 99px;
        overflow: hidden;
        background: rgba(255, 255, 255, .055);
    }

    .pm-dashboard-progress-fill
    {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #059669, #2dd4bf);
    }

    .pm-dashboard-bottom-grid
    {
        grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
    }

    .pm-dashboard-table-wrap
    {
        overflow-x: auto;
    }

    .pm-dashboard-table
    {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
    }

        .pm-dashboard-table th
        {
            padding: 11px 14px;
            text-align: left;
            color: #5f887e;
            border-bottom: 1px solid var(--dashboard-border);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .pm-dashboard-table td
        {
            padding: 12px 14px;
            border-bottom: 1px solid rgba(45, 212, 191, .055);
            color: #a8c9c1;
            font-size: 10px;
            vertical-align: middle;
        }

        .pm-dashboard-table tr:last-child td
        {
            border-bottom: 0;
        }

    .pm-dashboard-vehicle
    {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .pm-dashboard-vehicle-icon
    {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: rgba(16, 185, 129, .08);
        color: #6ee7b7;
    }

    .pm-dashboard-vehicle strong
    {
        display: block;
        color: #dff7f0;
        font-size: 10px;
    }

    .pm-dashboard-vehicle small
    {
        display: block;
        margin-top: 2px;
        color: #5f887e;
        font-size: 8px;
    }

    .pm-dashboard-driver
    {
        color: #c1ddd6;
        font-weight: 650;
    }

    .pm-dashboard-route
    {
        color: #7dd3fc;
    }

    .pm-dashboard-number
    {
        color: #e1f8f1;
        font-weight: 750;
    }

    .pm-dashboard-footer-line
    {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 14px;
        border-top: 1px solid var(--dashboard-border);
        color: #587f76;
        font-size: 9px;
    }

        .pm-dashboard-footer-line strong
        {
            color: #8fb7ad;
        }

    .pm-dashboard-map .leaflet-control-zoom a,
    .pm-dashboard-map .leaflet-control-layers
    {
        background: rgba(3, 25, 20, .92);
        color: #d1fae5;
        border-color: rgba(45, 212, 191, .18);
    }

    .pm-dashboard-map .leaflet-control-layers-toggle
    {
        background-color: rgba(3, 25, 20, .92);
    }

    .pm-dashboard-map .leaflet-control-attribution
    {
        background: rgba(2, 24, 19, .72);
        color: #759b92;
    }

        .pm-dashboard-map .leaflet-control-attribution a
        {
            color: #7dd3fc;
        }

    .pm-dashboard-marker
    {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 2px solid #d1fae5;
        background: #059669;
        box-shadow: 0 0 0 4px rgba(5, 150, 105, .18), 0 5px 15px rgba(0, 0, 0, .35);
        color: white;
        font-size: 12px;
        font-weight: 900;
    }

        .pm-dashboard-marker.warning
        {
            background: #d97706;
            box-shadow: 0 0 0 4px rgba(217, 119, 6, .18), 0 5px 15px rgba(0, 0, 0, .35);
        }

        .pm-dashboard-marker.danger
        {
            background: #dc2626;
            box-shadow: 0 0 0 4px rgba(220, 38, 38, .18), 0 5px 15px rgba(0, 0, 0, .35);
        }

        .pm-dashboard-marker.gps
        {
            background: #0284c7;
            box-shadow: 0 0 0 4px rgba(2, 132, 199, .18), 0 5px 15px rgba(0, 0, 0, .35);
        }

    .pm-dashboard-popup
    {
        min-width: 180px;
        color: #dff7f0;
    }

        .pm-dashboard-popup strong
        {
            font-size: 12px;
        }

        .pm-dashboard-popup div
        {
            margin-top: 5px;
            color: #658e84;
            font-size: 10px;
        }

        .pm-dashboard-popup b
        {
            color: #34d399;
        }

    @@media (max-width: 1400px)
    {
        .pm-dashboard-kpis
        {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .pm-dashboard-main-grid
        {
            grid-template-columns: minmax(0, 1.35fr) minmax(300px, .8fr);
        }
    }

    @@media (max-width: 1100px)
    {
        .pm-dashboard-main-grid,
        .pm-dashboard-bottom-grid
        {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px)
    {
        .pm-dashboard-content
        {
            padding: 14px;
        }

        .pm-dashboard-header
        {
            flex-direction: column;
        }

        .pm-dashboard-header-actions
        {
            justify-content: flex-start;
        }

        .pm-dashboard-kpis
        {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pm-dashboard-map
        {
            height: 350px;
        }

        .pm-dashboard-status-grid
        {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px)
    {
        .pm-dashboard-kpis
        {
            grid-template-columns: 1fr;
        }

        .pm-dashboard-title
        {
            font-size: 24px;
        }
    }
</style>

<div class="pm-page pm-dashboard-page" data-module="dashboard">

    <main class="pm-dashboard-content">

        <header class="pm-dashboard-header">

            <div class="pm-dashboard-heading">
                <div class="pm-dashboard-kicker">
                    ProMap Cargo
                </div>

                <h1 class="pm-dashboard-title">
                    Dashboard
                </h1>

                <div class="pm-dashboard-subtitle">
                    Executive fleet overview and daily operations
                </div>
            </div>

            <div class="pm-dashboard-header-actions">

                <a class="pm-dashboard-btn primary"
                   href="/dispatch">
                    Command Center
                </a>

                <a class="pm-dashboard-btn"
                   href="/navigation">
                    Navigacija
                </a>

            </div>

        </header>


        <section class="pm-dashboard-grid pm-dashboard-kpis">

            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        Aktivne ture
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        ⇄
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    12
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>u tranzitu</span>
                    <span class="pm-dashboard-trend">
                        +2 danas
                    </span>
                </div>

            </div>


            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        Vozila online
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        ◉
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    38
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>od 41 vozila</span>
                    <span class="pm-dashboard-trend">
                        92.7%
                    </span>
                </div>

            </div>


            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        GPS lost
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        ◌
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    2
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>zahteva pažnju</span>
                    <span class="pm-dashboard-trend danger">
                        ALERT
                    </span>
                </div>

            </div>


            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        Off-route
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        !
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    1
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>van planirane rute</span>
                    <span class="pm-dashboard-trend warn">
                        84 m
                    </span>
                </div>

            </div>


            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        Granice
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        ⇥
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    3
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>vozila čekaju</span>
                    <span class="pm-dashboard-trend warn">
                        +31 min
                    </span>
                </div>

            </div>


            <div class="pm-dashboard-card pm-dashboard-kpi">

                <div class="pm-dashboard-kpi-head">
                    <span class="pm-dashboard-kpi-label">
                        Compliance
                    </span>

                    <span class="pm-dashboard-kpi-icon">
                        ✓
                    </span>
                </div>

                <div class="pm-dashboard-kpi-value">
                    96%
                </div>

                <div class="pm-dashboard-kpi-bottom">
                    <span>fleet score</span>
                    <span class="pm-dashboard-trend">
                        +1.8%
                    </span>
                </div>

            </div>

        </section>


        <section class="pm-dashboard-grid pm-dashboard-main-grid">

            <div class="pm-dashboard-card pm-dashboard-map-card">

                <div class="pm-dashboard-card-head">

                    <div>
