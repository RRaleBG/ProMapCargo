@page "/dashboard"
@{
    ViewData["Title"] = "Dashboard · ProMap Cargo";
}

<div id="app" style="display:none"></div>
<div class="pm-page" data-module="dashboard">
  <header class="pm-header">
    <div>
      <div class="pm-brand">ProMap <span>Cargo</span></div>
      <div class="pm-kicker">Dashboard</div>
      <div class="pm-subtitle">Executive fleet overview and daily operations</div>
    </div>
    <div class="pm-header-actions">
      <a class="pm-btn pm-btn-primary" href="/dispatch">Command Center</a>
      <a class="pm-btn" href="/profile">Profil</a>
    </div>
  </header>
  <div class="pm-layout">
    <aside class="pm-sidebar">
      <div class="pm-nav-title">OPERATIONS</div>
      <nav class="pm-nav"><a class="active" href="/dashboard">Dashboard</a><a class="" href="/dispatch">Command Center</a><a class="" href="/orders">Transportni nalozi</a><a class="" href="/trips">Ture</a><a class="" href="/vehicles">Vozila</a><a class="" href="/drivers">Vozači</a><a class="" href="/navigation">Navigacija</a><a class="" href="/alerts">Alerts</a><a class="" href="/moderation">Moderacija</a><a class="" href="/audit">Audit</a><a class="" href="/compliance">Compliance</a><a class="" href="/monitoring">Monitoring</a><a class="" href="/finance">Finansije</a><a class="" href="/reports">Izveštaji</a><a class="" href="/settings">Podešavanja</a><a class="" href="/profile">Profil</a><a class="" href="/admin">Administracija</a></nav>
      <div class="pm-sidebar-footer"><b>Routing engine</b><br>PostGIS · OSM · Truck-aware<br><span>Graph protected</span></div>
    </aside>
    <main class="pm-content">
      <div class="pm-grid pm-grid-6"><div class="pm-card pm-stat"><small>Aktivne ture</small><div class="pm-value">12</div><div class="pm-muted">u tranzitu</div></div><div class="pm-card pm-stat"><small>Vozila online</small><div class="pm-value">38</div><div class="pm-muted">od 41</div></div><div class="pm-card pm-stat"><small>GPS lost</small><div class="pm-value">2</div><div class="pm-muted">zahteva pažnju</div></div><div class="pm-card pm-stat"><small>Off-route</small><div class="pm-value">1</div><div class="pm-muted">automatski alert</div></div><div class="pm-card pm-stat"><small>Granice</small><div class="pm-value">3</div><div class="pm-muted">vozila čekaju</div></div><div class="pm-card pm-stat"><small>Compliance</small><div class="pm-value">96%</div><div class="pm-muted">fleet score</div></div></div><div style="height:14px"></div><div class="pm-grid pm-grid-2"><div class="pm-card"><div class="pm-card-head"><div><b>Operativni pregled</b><div class="pm-muted">Današnji učinak flote</div></div><span class="pm-badge">LIVE</span></div><div class="pm-card-body pm-list"><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>Delivery success</b><b>94%</b></div><div class="pm-progress"><span style="width:94%"></span></div></div><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>On-time departures</b><b>88%</b></div><div class="pm-progress"><span style="width:88%"></span></div></div><div class="pm-item"><div class="pm-row" style="justify-content:space-between"><b>Fuel efficiency</b><b>81%</b></div><div class="pm-progress"><span style="width:81%"></span></div></div></div></div><div class="pm-card"><div class="pm-card-head"><b>Prioritetni događaji</b><a class="pm-btn" href="/alerts">Svi alerti</a></div><div class="pm-card-body pm-list"><div class="pm-item"><span class="pm-badge danger">OFF-ROUTE</span><div style="margin-top:6px"><b>BG-241-AA</b> je 84 m van planirane rute.</div></div><div class="pm-item"><span class="pm-badge warn">BORDER</span><div style="margin-top:6px"><b>Horgoš</b> · procenjeno čekanje 31 min.</div></div><div class="pm-item"><span class="pm-badge info">GPS</span><div style="margin-top:6px"><b>NI-401-TT</b> nema telemetriju 4 min.</div></div></div></div></div>
    </main>
  </div>
</div>


<script>
// Pages are server-rendered and must remain independent from the legacy SPA renderer.
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.pm-page a[href]').forEach(a=>a.addEventListener('click',e=>{
    if(a.origin===location.origin){ e.stopPropagation(); }
  },true));
});
</script>
