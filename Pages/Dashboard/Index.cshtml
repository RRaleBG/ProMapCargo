<script>
    document.addEventListener("DOMContentLoaded", () => {

        const lastUpdate =
            document.getElementById("dashboardLastUpdate");

        if (lastUpdate) {
            lastUpdate.textContent = "upravo sada";
        }

        if (typeof window.L === "undefined") {
            return;
        }

        const mapElement =
            document.getElementById("dashboardMap");

        if (!mapElement) {
            return;
        }

        if (mapElement.dataset.initialized === "true") {
            return;
        }

        mapElement.dataset.initialized = "true";


        const map =
            L.map("dashboardMap", {
                zoomControl: false,
                preferCanvas: true
            }).setView(
                [44.92, 20.55],
                7
            );


        const lightLayer =
            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        "© OpenStreetMap contributors"
                }
            );


        const darkLayer =
            L.tileLayer(
                "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
                {
                    maxZoom: 20,
                    subdomains: "abcd",
                    attribution:
                        "© OpenStreetMap contributors © CARTO"
                }
            );


        lightLayer.addTo(map);


        /*
         * Layer kontrola.
         *
         * Klikom na ikonicu slojeva korisnik menja
         * izgled mape. Nema dodatnog popup UI-ja
         * van standardnog Leaflet layer kontrola.
         */

        L.control.layers(
            {
                "OSM Light": lightLayer,
                "Dark Map": darkLayer
            },
            null,
            {
                collapsed: true,
                position: "topright"
            }
        ).addTo(map);


        L.control.zoom({
            position: "topright"
        }).addTo(map);


        const fleet = [

            {
                id: "BG-241-AA",
                driver: "Marko Petrović",
                lat: 44.8178,
                lon: 20.4573,
                speed: 78,
                status: "danger",
                statusText: "OFF-ROUTE"
            },

            {
                id: "NS-512-KK",
                driver: "Nikola Jovanović",
                lat: 45.2551,
                lon: 19.8335,
                speed: 82,
                status: "ok",
                statusText: "ON ROUTE"
            },

            {
                id: "NI-401-TT",
                driver: "Stefan Ilić",
                lat: 43.3209,
                lon: 21.8958,
                speed: 0,
                status: "warning",
                statusText: "GPS LOST"
            },

            {
                id: "SU-774-BG",
                driver: "Milan Savić",
                lat: 46.1000,
                lon: 19.6676,
                speed: 76,
                status: "ok",
                statusText: "ON ROUTE"
            },

            {
                id: "KG-330-AA",
                driver: "Petar Nikolić",
                lat: 44.0128,
                lon: 20.9114,
                speed: 71,
                status: "ok",
                statusText: "ON ROUTE"
            },

            {
                id: "SA-119-BB",
                driver: "Ivan Marković",
                lat: 44.7569,
                lon: 19.6900,
                speed: 68,
                status: "gps",
                statusText: "GPS LIVE"
            }

        ];


        const markerGroup =
            L.layerGroup().addTo(map);


        function markerClass(status) {

            if (status === "danger") {
                return "pm-dashboard-marker danger";
            }

            if (status === "warning") {
                return "pm-dashboard-marker warning";
            }

            if (status === "gps") {
                return "pm-dashboard-marker gps";
            }

            return "pm-dashboard-marker";
        }


        fleet.forEach(vehicle => {

            const icon =
                L.divIcon({
                    className: "",
                    html:
                        `<div class="${markerClass(vehicle.status)}">▰</div>`,
                    iconSize: [
                        30,
                        30
                    ],
                    iconAnchor: [
                        15,
                        15
                    ],
                    popupAnchor: [
                        0,
                        -14
                    ]
                });


            const marker =
                L.marker(
                    [
                        vehicle.lat,
                        vehicle.lon
                    ],
                    {
                        icon
                    }
                );


            marker.bindPopup(`
                    <div class="pm-dashboard-popup">

                        <strong>
                            ${vehicle.id}
                        </strong>

                        <div>
                            Vozač:
                            <b>${vehicle.driver}</b>
                        </div>

                        <div>
                            Brzina:
                            <b>${vehicle.speed} km/h</b>
                        </div>

                        <div>
                            Status:
                            <b>${vehicle.statusText}</b>
                        </div>

                    </div>
                `);


            markerGroup.addLayer(marker);

        });


        const bounds =
            L.latLngBounds(
                fleet.map(vehicle => [
                    vehicle.lat,
                    vehicle.lon
                ])
            );


        map.fitBounds(
            bounds,
            {
                padding: [
                    35,
                    35
                ]
            }
        );


        const zoomIn =
            document.getElementById(
                "dashboardMapZoomIn"
            );

        const zoomOut =
            document.getElementById(
                "dashboardMapZoomOut"
            );

        const fit =
            document.getElementById(
                "dashboardMapFit"
            );


        zoomIn?.addEventListener(
            "click",
            () => map.zoomIn()
        );


        zoomOut?.addEventListener(
            "click",
            () => map.zoomOut()
        );


        fit?.addEventListener(
            "click",
            () => {

                map.fitBounds(
                    bounds,
                    {
                        padding: [
                            35,
                            35
                        ]
                    }
                );

            }
        );


        setTimeout(() => {

            map.invalidateSize();

            map.fitBounds(
                bounds,
                {
                    padding: [
                        35,
                        35
                    ]
                }
            );

        }, 250);

    });
</script>