@page

@{
    ViewData["Title"] = "Dashboard · ProMap Cargo";
}

<div class="pm-page">

    <div class="pm-header">

        <div>
            <div class="pm-kicker">
                ProMap Cargo
            </div>

            <h1 class="pm-title">
                Dashboard
            </h1>

            <p class="pm-subtitle">
                Transport · Fleet · Navigation
            </p>
        </div>

    </div>


    <div class="pm-grid-4">

        <div class="pm-card">
            <div class="pm-card-label">
                Aktivne ture
            </div>

            <div class="pm-card-value">
                12
            </div>

            <div class="pm-card-subtitle">
                Operativno
            </div>
        </div>


        <div class="pm-card">
            <div class="pm-card-label">
                GPS Online
            </div>

            <div class="pm-card-value">
                38
            </div>

            <div class="pm-card-subtitle">
                Fleet
            </div>
        </div>


        <div class="pm-card">
            <div class="pm-card-label">
                GPS Lost
            </div>

            <div class="pm-card-value">
                2
            </div>

            <div class="pm-card-subtitle">
                Zahteva pažnju
            </div>
        </div>


        <div class="pm-card">
            <div class="pm-card-label">
                Off-route
            </div>

            <div class="pm-card-value">
                1
            </div>

            <div class="pm-card-subtitle">
                Automatski alert
            </div>
        </div>

    </div>


    <div class="pm-grid-2">

        <div class="pm-card">

            <div class="pm-card-header">
                <div>
                    <div class="pm-card-title">
                        Live Fleet
                    </div>

                    <div class="pm-card-subtitle">
                        Vozila · rute · status
                    </div>
                </div>

                <span class="pm-badge pm-badge-success">
                    LIVE
                </span>
            </div>

            <div id="dashboardMap"
                 class="pm-map">
            </div>

        </div>


        <div class="pm-card">

            <div class="pm-card-header">

                <div>
                    <div class="pm-card-title">
                        System status
                    </div>

                    <div class="pm-card-subtitle">
                        ProMap Cargo platform
                    </div>
                </div>

            </div>


            <div class="pm-status-list">

                <div class="pm-status-row">
                    <span>API</span>
                    <strong>CONNECTED</strong>
                </div>

                <div class="pm-status-row">
                    <span>PostgreSQL</span>
                    <strong>CONNECTED</strong>
                </div>

                <div class="pm-status-row">
                    <span>PostGIS</span>
                    <strong>READY</strong>
                </div>

                <div class="pm-status-row">
                    <span>Routing</span>
                    <strong>READY</strong>
                </div>

            </div>

        </div>

    </div>

</div>