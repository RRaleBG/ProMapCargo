@page "/alerts"
@{
    ViewData["Title"] = "Alerts · ProMap Cargo";
}

<div class="pm-alerts-page" data-module="alerts">

    <header class="pm-alerts-header">

        <div class="pm-alerts-heading">

            <div class="pm-alerts-kicker">
                <span class="pm-alerts-kicker-dot"></span>
                CONTROL · ALERT CENTER
            </div>

            <h1>
                Alerts
            </h1>

            <p>
                Centralni pregled svih operativnih, bezbednosnih,
                fleet, navigation, compliance i finansijskih alerta.
            </p>

        </div>

        <div class="pm-alerts-header-actions">

            <div class="pm-alerts-live">

                <span class="pm-alerts-live-dot"></span>

                <span>
                    Alert engine
                </span>

                <strong>
                    LIVE
                </strong>

            </div>

            <button
                type="button"
                class="pm-alerts-btn"
                id="alertsRefresh">

                <span>↻</span>
                Osveži

            </button>

            <button
                type="button"
                class="pm-alerts-btn pm-alerts-btn-primary"
                id="alertsClearResolved">

                Očisti rešene

            </button>

        </div>

    </header>


    <section
        class="pm-alerts-kpis"
        aria-label="Alert statistika">

        <article class="pm-alert-kpi pm-alert-kpi-open">

            <div class="pm-alert-kpi-top">

                <span>
                    Otvoreni alerti
                </span>

                <span class="pm-alert-kpi-icon">
                    !
                </span>

            </div>

            <strong id="alertsOpenCount">
                —
            </strong>

            <small>
                zahtevaju pažnju
            </small>

        </article>


        <article class="pm-alert-kpi pm-alert-kpi-critical">

            <div class="pm-alert-kpi-top">

                <span>
                    Critical
                </span>

                <span class="pm-alert-kpi-icon">
                    !
                </span>

            </div>

            <strong id="alertsCriticalCount">
                —
            </strong>

            <small>
                bezbednosni / blokirajući
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    High
                </span>

                <span class="pm-alert-kpi-icon">
                    ↑
                </span>

            </div>

            <strong id="alertsHighCount">
                —
            </strong>

            <small>
                visoki prioritet
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    Danas
                </span>

                <span class="pm-alert-kpi-icon">
                    ◷
                </span>

            </div>

            <strong id="alertsTodayCount">
                —
            </strong>

            <small>
                generisano danas
            </small>

        </article>


        <article class="pm-alert-kpi">

            <div class="pm-alert-kpi-top">

                <span>
                    Resolved
                </span>

                <span class="pm-alert-kpi-icon">
                    ✓
                </span>

            </div>

            <strong id="alertsResolvedCount">
                —
            </strong>

            <small>
                uspešno rešeno
            </small>

        </article>

    </section>


    <section class="pm-alerts-workspace">


        <div class="pm-alerts-main">


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            ALERT STREAM
                        </div>

                        <h2>
                            Svi operativni alerti
                        </h2>

                        <p>
                            Centralizovani događaji iz svih ProMap Cargo modula.
                        </p>

                    </div>

                    <div
                        class="pm-alerts-result-count"
                        id="alertsResultCount">
                        —
                    </div>

                </div>


                <div class="pm-alerts-filters">


                    <div class="pm-alerts-search">

                        <span>
                            ⌕
                        </span>

                        <input
                            id="alertsSearch"
                            type="search"
                            autocomplete="off"
                            placeholder="Pretraži alert, vozilo, vozača, turu..." />

                    </div>


                    <select
                        id="alertsSeverity"
                        class="pm-alerts-select">

                        <option value="">
                            Sve severity
                        </option>

                        <option value="critical">
                            Critical
                        </option>

                        <option value="high">
                            High
                        </option>

                        <option value="medium">
                            Medium
                        </option>

                        <option value="low">
                            Low
                        </option>

                        <option value="info">
                            Info
                        </option>

                    </select>


                    <select
                        id="alertsCategory"
                        class="pm-alerts-select">

                        <option value="">
                            Sve kategorije
                        </option>

                        <option value="navigation">
                            Navigacija
                        </option>

                        <option value="gps">
                            GPS
                        </option>

                        <option value="compliance">
                            Compliance
                        </option>

                        <option value="border">
                            Granica
                        </option>

                        <option value="maintenance">
                            Servis
                        </option>

                        <option value="tachograph">
                            Tachograph
                        </option>

                        <option value="fuel">
                            Gorivo / Fuel card
                        </option>

                        <option value="orders">
                            Transportni nalozi
                        </option>

                        <option value="trips">
                            Ture
                        </option>

                        <option value="driver">
                            Vozači
                        </option>

                        <option value="vehicle">
                            Vozila
                        </option>

                        <option value="finance">
                            Finansije
                        </option>

                        <option value="system">
                            Sistem
                        </option>

                    </select>


                    <select
                        id="alertsStatus"
                        class="pm-alerts-select">

                        <option value="open">
                            Otvoreni
                        </option>

                        <option value="">
                            Svi statusi
                        </option>

                        <option value="acknowledged">
                            Acknowledged
                        </option>

                        <option value="snoozed">
                            Snoozed
                        </option>

                        <option value="resolved">
                            Resolved
                        </option>

                    </select>

                </div>


                <div
                    class="pm-alerts-list"
                    id="alertsList">
                </div>


                <div
                    class="pm-alerts-empty"
                    id="alertsEmpty"
                    hidden>

                    <div class="pm-alerts-empty-icon">
                        ✓
                    </div>

                    <strong>
                        Nema alerta
                    </strong>

                    <span>
                        Za izabrane filtere nema rezultata.
                    </span>

                </div>

            </section>

        </div>


        <aside class="pm-alerts-side">


            <section class="pm-alerts-card pm-alerts-detail-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            ALERT DETAIL
                        </div>

                        <h2>
                            Detalji
                        </h2>

                    </div>

                </div>


                <div
                    id="alertDetails"
                    class="pm-alerts-details">

                    <div class="pm-alerts-detail-empty">

                        <div>
                            !
                        </div>

                        <strong>
                            Izaberite alert
                        </strong>

                        <span>
                            Kliknite na alert iz liste da vidite
                            kompletan kontekst i akcije.
                        </span>

                    </div>

                </div>

            </section>


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            SOURCES
                        </div>

                        <h2>
                            Izvori alerta
                        </h2>

                    </div>

                </div>


                <div class="pm-alert-source-list">

                    <div>
                        <span class="pm-alert-source-dot navigation"></span>
                        <strong>Navigacija</strong>
                        <em id="sourceNavigation">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot compliance"></span>
                        <strong>Compliance</strong>
                        <em id="sourceCompliance">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot gps"></span>
                        <strong>GPS / Monitoring</strong>
                        <em id="sourceGps">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot fleet"></span>
                        <strong>Fleet / Vozila</strong>
                        <em id="sourceFleet">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot driver"></span>
                        <strong>Vozači</strong>
                        <em id="sourceDriver">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot finance"></span>
                        <strong>Finansije</strong>
                        <em id="sourceFinance">0</em>
                    </div>

                    <div>
                        <span class="pm-alert-source-dot operations"></span>
                        <strong>Operacije</strong>
                        <em id="sourceOperations">0</em>
                    </div>

                </div>

            </section>


            <section class="pm-alerts-card">


                <div class="pm-alerts-card-header">

                    <div>

                        <div class="pm-alerts-eyebrow">
                            SEVERITY
                        </div>

                        <h2>
                            Prioritet
                        </h2>

                    </div>

                </div>


                <div class="pm-alert-severity-bars">

                    <div>

                        <span>
                            Critical
                        </span>

                        <div>
                            <i
                                id="severityCriticalBar"
                                style="width:0%">
                            </i>
                        </div>

                        <strong
                            id="severityCriticalValue">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            High
                        </span>

                        <div>
                            <i
                                id="severityHighBar"
                                style="width:0%">
                            </i>
                        </div>

                        <strong
                            id="severityHighValue">
                            0
                        </strong>

                    </div>


                    <div>

                        <span>
                            Medium
                        </span>

                        <div>
                            <i
                                id="severityMediumBar"
                                style="width:0%">
                            </i>
                        </div>

                        <strong
                            id="severityMediumValue">
                            0
                        </strong>

                    </div>

                </div>

            </section>

        </aside>

    </section>

</div>


<style>

.pm-alerts-page
{
    width: 100%;
    min-width: 0;
    color: var(--pm-text);
}


.pm-alerts-header
{
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
}


.pm-alerts-heading
{
    min-width: 0;
}


.pm-alerts-kicker
{
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 7px;
    color: var(--pm-teal);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
}


.pm-alerts-kicker-dot
{
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pm-danger);
    box-shadow: 0 0 0 4px rgba(251,113,133,.08);
}


.pm-alerts-heading h1
{
    margin: 0;
    color: var(--pm-text);
    font-size: 31px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -.04em;
}


.pm-alerts-heading p
{
    max-width: 760px;
    margin: 8px 0 0;
    color: var(--pm-text-muted);
    font-size: 13px;
    line-height: 1.55;
}


.pm-alerts-header-actions
{
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
    flex-wrap: wrap;
}


.pm-alerts-live
{
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--pm-border);
    border-radius: 10px;
    background: rgba(16,185,129,.055);
    color: var(--pm-text-muted);
    font-size: 10px;
    font-weight: 700;
}


.pm-alerts-live strong
{
    color: var(--pm-emerald-300);
    font-size: 9px;
    letter-spacing: .08em;
}


.pm-alerts-live-dot
{
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pm-emerald-400);
    box-shadow: 0 0 0 4px rgba(52,211,153,.08);
}


.pm-alerts-btn
{
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 13px;
    border: 1px solid var(--pm-border);
    border-radius: 10px;
    background: var(--pm-surface);
    color: var(--pm-text-soft);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease;
}


.pm-alerts-btn:hover
{
    transform: translateY(-1px);
    border-color: var(--pm-border-strong);
    background: var(--pm-surface-hover);
}


.pm-alerts-btn-primary
{
    background: rgba(16,185,129,.12);
    border-color: rgba(52,211,153,.24);
    color: var(--pm-emerald-200);
}


.pm-alerts-kpis
{
    display: grid;
    grid-template-columns:
        repeat(5,minmax(0,1fr));
    gap: 12px;
    margin-bottom: 14px;
}


.pm-alert-kpi
{
    min-width: 0;
    padding: 15px;
    border: 1px solid var(--pm-border);
    border-radius: var(--pm-radius-md);
    background: var(--pm-surface);
    box-shadow: var(--pm-shadow-sm);
}


.pm-alert-kpi-open
{
    border-color: rgba(45,212,191,.24);
}


.pm-alert-kpi-critical
{
    border-color: rgba(251,113,133,.22);
}


.pm-alert-kpi-top
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: var(--pm-text-muted);
    font-size: 10px;
    font-weight: 700;
}


.pm-alert-kpi-icon
{
    width: 27px;
    height: 27px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(255,255,255,.035);
    color: var(--pm-teal);
    font-weight: 900;
}


.pm-alert-kpi-critical .pm-alert-kpi-icon
{
    color: var(--pm-danger);
    background: var(--pm-danger-bg);
}


.pm-alert-kpi strong
{
    display: block;
    margin-top: 8px;
    color: var(--pm-text);
    font-size: 25px;
    line-height: 1;
    font-weight: 800;
}


.pm-alert-kpi small
{
    display: block;
    margin-top: 7px;
    color: var(--pm-text-dim);
    font-size: 10px;
}


.pm-alerts-workspace
{
    display: grid;
    grid-template-columns:
        minmax(0,1fr)
        350px;
    gap: 14px;
    align-items: start;
}


.pm-alerts-main,
.pm-alerts-side
{
    min-width: 0;
}


.pm-alerts-side
{
    display: flex;
    flex-direction: column;
    gap: 14px;
}


.pm-alerts-card
{
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: var(--pm-radius-lg);
    background: var(--pm-surface);
    box-shadow: var(--pm-shadow-sm);
}


.pm-alerts-card-header
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 17px;
    border-bottom: 1px solid var(--pm-border-soft);
}


.pm-alerts-eyebrow
{
    margin-bottom: 5px;
    color: var(--pm-teal);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}


.pm-alerts-card-header h2
{
    margin: 0;
    color: var(--pm-text);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -.015em;
}


.pm-alerts-card-header p
{
    margin: 5px 0 0;
    color: var(--pm-text-dim);
    font-size: 10px;
}


.pm-alerts-result-count
{
    padding: 6px 9px;
    border: 1px solid var(--pm-border);
    border-radius: 999px;
    color: var(--pm-text-muted);
    background: rgba(255,255,255,.025);
    font-size: 9px;
    font-weight: 800;
    white-space: nowrap;
}


.pm-alerts-filters
{
    display: grid;
    grid-template-columns:
        minmax(220px,1.6fr)
        repeat(3,minmax(130px,.7fr));
    gap: 9px;
    padding: 13px 15px;
    border-bottom: 1px solid var(--pm-border-soft);
    background: rgba(2,24,20,.22);
}


.pm-alerts-search
{
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 11px;
    border: 1px solid var(--pm-border);
    border-radius: 9px;
    background: rgba(2,24,20,.55);
}


.pm-alerts-search > span
{
    color: var(--pm-text-dim);
    font-size: 18px;
}


.pm-alerts-search input
{
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--pm-text);
    font: inherit;
    font-size: 11px;
}


.pm-alerts-search input::placeholder
{
    color: var(--pm-text-dim);
}


.pm-alerts-select
{
    min-width: 0;
    min-height: 38px;
    padding: 0 10px;
    border: 1px solid var(--pm-border);
    border-radius: 9px;
    outline: 0;
    background: rgba(2,24,20,.55);
    color: var(--pm-text-soft);
    font-size: 10px;
    font-weight: 700;
}


.pm-alerts-select:focus
{
    border-color: var(--pm-border-strong);
}


.pm-alerts-list
{
    display: flex;
    flex-direction: column;
}


.pm-alert-row
{
    display: grid;
    grid-template-columns:
        4px
        34px
        minmax(170px,1.6fr)
        minmax(100px,.75fr)
        minmax(100px,.7fr)
        auto;
    align-items: center;
    gap: 12px;
    min-height: 84px;
    padding: 11px 14px 11px 0;
    border-bottom: 1px solid var(--pm-border-soft);
    cursor: pointer;
    transition:
        background .16s ease,
        transform .16s ease;
}


.pm-alert-row:last-child
{
    border-bottom: 0;
}


.pm-alert-row:hover
{
    background: rgba(16,185,129,.035);
}


.pm-alert-row.selected
{
    background: rgba(45,212,191,.055);
}


.pm-alert-severity-line
{
    align-self: stretch;
    border-radius: 0 4px 4px 0;
    background: var(--pm-info);
}


.pm-alert-row.critical .pm-alert-severity-line
{
    background: var(--pm-danger);
}


.pm-alert-row.high .pm-alert-severity-line
{
    background: #fb923c;
}


.pm-alert-row.medium .pm-alert-severity-line
{
    background: var(--pm-warning);
}


.pm-alert-row.low .pm-alert-severity-line
{
    background: var(--pm-emerald-400);
}


.pm-alert-row.info .pm-alert-severity-line
{
    background: var(--pm-info);
}


.pm-alert-row-icon
{
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pm-border);
    border-radius: 10px;
    background: rgba(255,255,255,.025);
    color: var(--pm-text-soft);
    font-size: 12px;
    font-weight: 900;
}


.pm-alert-row.critical .pm-alert-row-icon
{
    color: var(--pm-danger);
    background: var(--pm-danger-bg);
    border-color: rgba(251,113,133,.18);
}


.pm-alert-row.high .pm-alert-row-icon
{
    color: #fb923c;
    background: rgba(249,115,22,.10);
    border-color: rgba(249,115,22,.18);
}


.pm-alert-row.medium .pm-alert-row-icon
{
    color: var(--pm-warning);
    background: var(--pm-warning-bg);
}


.pm-alert-row-content
{
    min-width: 0;
}


.pm-alert-row-title
{
    overflow: hidden;
    color: var(--pm-text);
    font-size: 11px;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.pm-alert-row-message
{
    overflow: hidden;
    margin-top: 4px;
    color: var(--pm-text-muted);
    font-size: 10px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.pm-alert-row-meta
{
    margin-top: 5px;
    color: var(--pm-text-dim);
    font-size: 9px;
}


.pm-alert-row-context
{
    min-width: 0;
}


.pm-alert-context-main
{
    overflow: hidden;
    color: var(--pm-text-soft);
    font-size: 10px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.pm-alert-context-sub
{
    overflow: hidden;
    margin-top: 4px;
    color: var(--pm-text-dim);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.pm-alert-row-status
{
    display: inline-flex;
    justify-content: center;
}


.pm-alert-status
{
    display: inline-flex;
    align-items: center;
    min-height: 23px;
    padding: 0 8px;
    border: 1px solid var(--pm-border);
    border-radius: 999px;
    color: var(--pm-text-muted);
    background: rgba(255,255,255,.025);
    font-size: 8px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}


.pm-alert-status.open
{
    color: var(--pm-danger);
    border-color: rgba(251,113,133,.18);
    background: var(--pm-danger-bg);
}


.pm-alert-status.acknowledged
{
    color: var(--pm-warning);
    background: var(--pm-warning-bg);
}


.pm-alert-status.snoozed
{
    color: var(--pm-info);
    background: var(--pm-info-bg);
}


.pm-alert-status.resolved
{
    color: var(--pm-success);
    background: var(--pm-success-bg);
}


.pm-alert-severity-badge
{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 8px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .04em;
}


.pm-alert-severity-badge.critical
{
    color: #fecdd3;
    background: var(--pm-danger-bg);
    border: 1px solid rgba(251,113,133,.16);
}


.pm-alert-severity-badge.high
{
    color: #fed7aa;
