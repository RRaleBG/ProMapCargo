@page "/finance"
@{
    ViewData["Title"] = "Finansije · ProMap Cargo";
}

<div class="pm-page pm-finance-page" data-module="finance">

    <div class="finance-bg-orb finance-bg-orb-one"></div>
    <div class="finance-bg-orb finance-bg-orb-two"></div>

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->
    <section class="finance-page-header finance-reveal">
        <div>
            <div class="finance-kicker">
                <span class="finance-kicker-dot"></span>
                FINANCE CONTROL
            </div>

            <h1>Finansije</h1>

            <p>
                Putni troškovi, kartice, finansije ture, obračun vozača
                i kompletan pregled salda na jednom mestu.
            </p>
        </div>

        <div class="finance-header-actions">
            <button type="button"
                    class="finance-btn"
                    id="financeRefreshButton">
                <span>↻</span>
                Osveži
            </button>

            <button type="button"
                    class="finance-btn finance-btn-primary"
                    id="openExpenseModal">
                <span>＋</span>
                Novi trošak
            </button>
        </div>
    </section>

    <!-- =========================================================
         CONTEXT BAR
    ========================================================== -->
    <section class="finance-context-bar finance-reveal finance-delay-1">

        <div class="finance-context-main">
            <div class="finance-context-icon">
                MP
            </div>

            <div class="finance-context-copy">
                <span>Finansijski kontekst</span>
                <strong id="financeContextTitle">
                    Marko Petrović
                </strong>

                <div class="finance-context-meta">
                    <span>Vozač DRV-0048</span>
                    <i></i>
                    <span>Aktivna tura TR-2026-00941</span>
                    <i></i>
                    <span>BG-123-AB</span>
                </div>
            </div>
        </div>

        <div class="finance-mode-switch" role="group">
            <button class="finance-mode-button active"
                    type="button"
                    data-finance-mode="driver">
                Moj pregled
            </button>

            <button class="finance-mode-button"
                    type="button"
                    data-finance-mode="dispatch">
                Dispatch
            </button>
        </div>

    </section>

    <!-- =========================================================
         KPI
    ========================================================== -->
    <section class="finance-kpi-grid finance-reveal finance-delay-2">

        <article class="finance-kpi finance-kpi-balance">
            <div class="finance-kpi-top">
                <span class="finance-kpi-label">Apsolutni saldo</span>
                <span class="finance-kpi-icon">€</span>
            </div>

            <strong class="finance-kpi-value"
                    data-finance-value="1245.80"
                    data-finance-format="currency">
                0,00 €
            </strong>

            <div class="finance-kpi-bottom">
                <span class="finance-status finance-status-positive">
                    +82,40 € ovaj mesec
                </span>
                <span>Vozač</span>
            </div>
        </article>

        <article class="finance-kpi">
            <div class="finance-kpi-top">
                <span class="finance-kpi-label">Aktivna tura</span>
                <span class="finance-kpi-icon">↗</span>
            </div>

            <strong class="finance-kpi-value">
                316,50 €
            </strong>

            <div class="finance-kpi-bottom">
                <span class="finance-status finance-status-live">
                    TR-2026-00941
                </span>
                <span>Preostalo</span>
            </div>
        </article>

        <article class="finance-kpi">
            <div class="finance-kpi-top">
                <span class="finance-kpi-label">Prethodna tura</span>
                <span class="finance-kpi-icon">✓</span>
            </div>

            <strong class="finance-kpi-value">
                +42,00 €
            </strong>

            <div class="finance-kpi-bottom">
                <span class="finance-status finance-status-success">
                    Obračunata
                </span>
                <span>TR-2026-00887</span>
            </div>
        </article>

        <article class="finance-kpi">
            <div class="finance-kpi-top">
                <span class="finance-kpi-label">Troškovi ture</span>
                <span class="finance-kpi-icon">−</span>
            </div>

            <strong class="finance-kpi-value">
                1.095,19 €
            </strong>

            <div class="finance-kpi-bottom">
                <span>8 transakcija</span>
                <span>Aktivna tura</span>
            </div>
        </article>

        <article class="finance-kpi">
            <div class="finance-kpi-top">
                <span class="finance-kpi-label">Na čekanju</span>
                <span class="finance-kpi-icon">!</span>
            </div>

            <strong class="finance-kpi-value">
                127,00 €
            </strong>

            <div class="finance-kpi-bottom">
                <span class="finance-status finance-status-warning">
                    3 troška
                </span>
                <span>Za proveru</span>
            </div>
        </article>

    </section>

    <!-- =========================================================
         MAIN GRID
    ========================================================== -->
