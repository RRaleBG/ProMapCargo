<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .pm-finance-page {
        position: relative;
        isolation: isolate;
        padding: 28px;
        overflow: hidden;
    }

    .finance-bg-orb {
        position: fixed;
        pointer-events: none;
        z-index: -1;
        border-radius: 999px;
        filter: blur(110px);
        opacity: .12;
    }

    .finance-bg-orb-one {
        width: 420px;
        height: 420px;
        top: 8%;
        right: 2%;
        background: var(--pm-emerald-500);
    }

    .finance-bg-orb-two {
        width: 340px;
        height: 340px;
        left: 20%;
        bottom: 4%;
        background: var(--pm-teal);
        opacity: .07;
    }


    /* =========================================================
       ANIMATION
    ========================================================== */

    .finance-reveal {
        opacity: 0;
        transform: translateY(14px);
        animation: financeReveal .58s ease forwards;
    }

    .finance-delay-1 {
        animation-delay: .06s;
    }

    .finance-delay-2 {
        animation-delay: .12s;
    }

    .finance-delay-3 {
        animation-delay: .18s;
    }

    .finance-delay-4 {
        animation-delay: .24s;
    }

    @@keyframes financeReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
       HEADER
    ========================================================== */

    .finance-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .finance-kicker,
    .finance-card-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--pm-emerald-400);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .finance-kicker-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--pm-emerald-400);
        box-shadow: 0 0 14px rgba(52, 211, 153, .8);
        animation: financePulse 2s infinite;
    }

    @@keyframes financePulse {
        50% {
            opacity: .42;
            box-shadow: 0 0 22px rgba(52, 211, 153, .35);
        }
    }

    .finance-page-header h1 {
        margin: 7px 0 0;
        font-size: clamp(28px, 3vw, 42px);
        line-height: 1;
        letter-spacing: -.04em;
    }

    .finance-page-header p {
        max-width: 720px;
        margin: 10px 0 0;
        color: var(--pm-text-muted);
        font-size: 13px;
        line-height: 1.65;
    }

    .finance-header-actions,
    .finance-card-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }


    /* =========================================================
       BUTTONS
    ========================================================== */

    .finance-btn {
        min-height: 39px;
        padding: 0 14px;
        border: 1px solid var(--pm-border);
        border-radius: 10px;
        background: rgba(255, 255, 255, .035);
        color: var(--pm-text-soft);
        font: inherit;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition:
            border-color .2s ease,
            background .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    .finance-btn:hover {
        transform: translateY(-1px);
        border-color: var(--pm-border-strong);
        background: rgba(255, 255, 255, .055);
    }

    .finance-btn-primary {
        color: #022c22;
        border-color: rgba(52, 211, 153, .75);
        background:
            linear-gradient(
                135deg,
                var(--pm-emerald-400),
                var(--pm-emerald-500)
            );
        box-shadow: 0 10px 30px rgba(16, 185, 129, .15);
    }

    .finance-btn-primary:hover {
        background:
            linear-gradient(
                135deg,
                var(--pm-emerald-300),
                var(--pm-emerald-500)
            );
        box-shadow: 0 12px 34px rgba(16, 185, 129, .24);
    }

    .finance-btn-small {
        min-height: 34px;
        padding: 0 11px;
        font-size: 11px;
    }

    .finance-btn-full {
        width: 100%;
        justify-content: space-between;
        margin-top: 15px;
    }

    .finance-icon-button {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        border: 1px solid var(--pm-border);
        background: rgba(255,255,255,.03);
        color: var(--pm-text-muted);
        cursor: pointer;
        font-size: 20px;
    }


    /* =========================================================
       CONTEXT BAR
    ========================================================== */

    .finance-context-bar {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        align-items: center;
        padding: 13px 14px;
        margin-bottom: 14px;
        border: 1px solid var(--pm-border);
        border-radius: var(--pm-radius-lg);
        background:
            linear-gradient(
                135deg,
                rgba(4, 31, 26, .94),
                rgba(4, 31, 26, .72)
            );
        backdrop-filter: var(--pm-blur);
        box-shadow: var(--pm-shadow-sm);
    }

    .finance-context-main {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 12px;
    }

    .finance-context-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(16, 185, 129, .11);
        border: 1px solid rgba(52, 211, 153, .2);
        color: var(--pm-emerald-300);
        font-weight: 850;
        font-size: 12px;
    }

    .finance-context-copy {
        min-width: 0;
    }

    .finance-context-copy > span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .1em;
    }

    .finance-context-copy > strong {
        display: block;
        margin-top: 2px;
        font-size: 13px;
    }

    .finance-context-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
        margin-top: 4px;
        color: var(--pm-text-muted);
        font-size: 10px;
    }

    .finance-context-meta i {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--pm-text-dim);
    }

    .finance-mode-switch {
        display: inline-flex;
        gap: 3px;
        padding: 3px;
        border: 1px solid var(--pm-border);
        border-radius: 9px;
        background: rgba(0, 0, 0, .14);
    }

    .finance-mode-button {
        min-height: 31px;
        padding: 0 12px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--pm-text-muted);
        font: inherit;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

    .finance-mode-button.active {
        color: #021512;
        background: var(--pm-emerald-400);
    }


    /* =========================================================
       CARDS
    ========================================================== */

    .finance-card,
    .finance-kpi {
        border: 1px solid var(--pm-border);
        background:
            linear-gradient(
                145deg,
                rgba(5, 39, 32, .86),
                rgba(2, 21, 18, .88)
            );
        backdrop-filter: var(--pm-blur);
        box-shadow:
            var(--pm-shadow-sm),
            inset 0 1px 0 rgba(255,255,255,.025);
    }

    .finance-card {
        border-radius: var(--pm-radius-lg);
        padding: 18px;
    }

    .finance-card + .finance-card {
        margin-top: 14px;
    }

    .finance-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 17px;
    }

    .finance-card-header.compact {
        margin-bottom: 14px;
    }

    .finance-card-header h2,
    .finance-card-header h3 {
        margin: 4px 0 0;
        letter-spacing: -.025em;
    }

    .finance-card-header h2 {
        font-size: 18px;
    }

    .finance-card-header h3 {
        font-size: 15px;
    }

    .finance-card-header p {
        margin: 5px 0 0;
        color: var(--pm-text-muted);
        font-size: 10px;
        line-height: 1.5;
    }


    /* =========================================================
       KPI
    ========================================================== */

    .finance-kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .finance-kpi {
        position: relative;
        min-width: 0;
        border-radius: 14px;
        padding: 14px;
        overflow: hidden;
        transition:
            transform .25s ease,
            border-color .25s ease;
    }

    .finance-kpi::after {
        content: "";
        position: absolute;
        right: -45px;
        bottom: -58px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: var(--pm-emerald-500);
        opacity: .035;
        transition: .3s ease;
    }

    .finance-kpi:hover {
        transform: translateY(-2px);
        border-color: rgba(52, 211, 153, .24);
    }

    .finance-kpi:hover::after {
        opacity: .07;
        transform: scale(1.08);
    }

    .finance-kpi-balance {
        border-color: rgba(52, 211, 153, .22);
    }

    .finance-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .finance-kpi-label {
        color: var(--pm-text-muted);
        font-size: 9px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .09em;
    }

    .finance-kpi-icon {
        width: 27px;
        height: 27px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(52, 211, 153, .12);
        border-radius: 8px;
        background: rgba(16, 185, 129, .07);
        color: var(--pm-emerald-300);
        font-size: 11px;
        font-weight: 850;
    }

    .finance-kpi-value {
        display: block;
        margin-top: 12px;
        font-size: clamp(18px, 1.7vw, 25px);
        letter-spacing: -.04em;
        white-space: nowrap;
    }

    .finance-kpi-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 7px;
        margin-top: 9px;
        color: var(--pm-text-dim);
        font-size: 8px;
    }


    /* =========================================================
       STATUS
    ========================================================== */

    .finance-status {
        display: inline-flex;
        align-items: center;
        width: max-content;
        gap: 5px;
        border-radius: 999px;
        padding: 4px 7px;
        font-size: 8px;
        line-height: 1;
        font-weight: 850;
        letter-spacing: .035em;
    }

    .finance-status-success,
    .finance-status-positive {
        color: var(--pm-success);
        background: var(--pm-success-bg);
        border: 1px solid rgba(52, 211, 153, .15);
    }

    .finance-status-live {
        color: var(--pm-cyan);
        background: rgba(34, 211, 238, .08);
        border: 1px solid rgba(34, 211, 238, .14);
    }

    .finance-status-warning {
        color: var(--pm-warning);
        background: var(--pm-warning-bg);
        border: 1px solid rgba(251, 191, 36, .16);
    }

    .finance-status-info {
        color: var(--pm-info);
        background: var(--pm-info-bg);
        border: 1px solid rgba(56, 189, 248, .14);
    }


    /* =========================================================
       MAIN GRID
    ========================================================== */

    .finance-main-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.7fr)
            minmax(310px, .68fr);
        gap: 14px;
        align-items: start;
    }

    .finance-main-column,
    .finance-side-column {
        min-width: 0;
    }


    /* =========================================================
       TRIP
    ========================================================== */

    .finance-trip-identity {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .finance-trip-identity > div {
        min-width: 0;
        padding: 10px;
        border-radius: 10px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--pm-border-soft);
    }

    .finance-trip-identity span,
    .finance-budget-head span,
    .finance-previous-summary span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: .065em;
    }

    .finance-trip-identity strong {
        display: block;
        margin-top: 4px;
        font-size: 10px;
    }

    .finance-budget {
        margin-top: 14px;
        padding: 13px;
        border-radius: 12px;
        border: 1px solid rgba(52, 211, 153, .12);
        background:
            linear-gradient(
                135deg,
                rgba(16, 185, 129, .055),
                rgba(0,0,0,.08)
            );
    }

    .finance-budget-head {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .finance-budget-head strong {
        display: block;
        margin-top: 4px;
        font-size: 14px;
    }

    .finance-budget-spent {
        text-align: right;
    }

    .finance-progress {
        height: 6px;
        margin-top: 11px;
        border-radius: 99px;
        overflow: hidden;
        background: rgba(255,255,255,.055);
    }

    .finance-progress-bar {
        width: 0;
        height: 100%;
        border-radius: inherit;
        background:
            linear-gradient(
                90deg,
                var(--pm-emerald-500),
                var(--pm-teal)
            );
        box-shadow: 0 0 14px rgba(16,185,129,.28);
        transition: width 1.15s cubic-bezier(.16,1,.3,1);
    }

    .finance-budget-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 7px;
        color: var(--pm-text-muted);
        font-size: 8px;
    }

    .finance-budget-footer strong {
        color: var(--pm-emerald-300);
    }

    .finance-trip-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-top: 10px;
    }

    .finance-trip-stats > div {
        padding: 9px 10px;
        border-radius: 9px;
        background: rgba(255,255,255,.02);
        border: 1px solid var(--pm-border-soft);
    }

    .finance-trip-stats span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 8px;
    }

    .finance-trip-stats strong {
        display: block;
        margin-top: 3px;
        font-size: 10px;
    }


    /* =========================================================
       PHYSICAL FUEL CARD
    ========================================================== */

    .finance-fuel-card-area {
        display: grid;
        grid-template-columns:
            minmax(300px, .8fr)
            minmax(220px, 1fr);
        gap: 13px;
    }

    .finance-physical-card {
        position: relative;
        min-height: 185px;
        overflow: hidden;
        padding: 18px;
        border-radius: 17px;
        border: 1px solid rgba(110, 231, 183, .22);
        background:
            radial-gradient(
                circle at 80% 10%,
                rgba(45, 212, 191, .24),
                transparent 30%
            ),
            linear-gradient(
                145deg,
                #073a31,
                #031e19 58%,
                #061713
            );
        box-shadow:
            0 18px 38px rgba(0,0,0,.25),
            inset 0 1px 0 rgba(255,255,255,.08);
        transition: transform .3s ease;
    }

    .finance-physical-card:hover {
        transform: perspective(800px) rotateX(1deg) rotateY(-1deg) translateY(-2px);
    }

    .finance-card-light {
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: rgba(52, 211, 153, .1);
        filter: blur(35px);
        top: -160px;
        right: -60px;
        pointer-events: none;
    }

    .finance-physical-top,
    .finance-physical-bottom {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .finance-card-provider {
        font-size: 19px;
        font-weight: 900;
        letter-spacing: -.04em;
    }

    .finance-physical-top small {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-muted);
        font-size: 8px;
    }

    .finance-card-chip {
        width: 32px;
        height: 25px;
        border-radius: 6px;
        padding: 5px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
        background:
            linear-gradient(
                135deg,
                #d6c484,
                #9e8e58
            );
    }

    .finance-card-chip span {
        border: 1px solid rgba(0,0,0,.16);
        border-radius: 2px;
    }

    .finance-card-number {
        position: relative;
        z-index: 1;
        margin-top: 34px;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: .08em;
        white-space: nowrap;
    }

    .finance-physical-bottom {
        align-items: flex-end;
        margin-top: 28px;
    }

    .finance-physical-bottom > div {
        min-width: 0;
    }

    .finance-physical-bottom span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 7px;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .finance-physical-bottom strong {
        display: block;
        margin-top: 3px;
        font-size: 9px;
    }

    .finance-card-active {
        color: var(--pm-emerald-300);
    }

    .finance-fuel-summary {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
    }

    .finance-fuel-stat {
        padding: 13px;
        border-radius: 11px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--pm-border-soft);
    }

    .finance-fuel-stat span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 8px;
    }

    .finance-fuel-stat strong {
        display: block;
        margin-top: 5px;
        font-size: 14px;
    }

    .finance-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 18px 0 7px;
    }

    .finance-section-title strong {
        display: block;
        font-size: 11px;
    }

    .finance-section-title span {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-dim);
        font-size: 8px;
    }

    .finance-fuel-transactions {
        display: grid;
        gap: 5px;
    }

    .finance-fuel-row {
        display: grid;
        grid-template-columns:
            auto
            minmax(150px, 1fr)
            minmax(120px, .7fr)
            minmax(90px, .45fr)
            minmax(110px, .5fr);
        gap: 10px;
        align-items: center;
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: rgba(255,255,255,.018);
        transition: .2s ease;
    }

    .finance-fuel-row:hover {
        border-color: var(--pm-border);
        background: rgba(255,255,255,.032);
        transform: translateX(2px);
    }

    .finance-transaction-icon {
        width: 31px;
        height: 31px;
        border-radius: 9px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        font-size: 11px;
        font-weight: 850;
    }

    .finance-transaction-icon.fuel {
        color: var(--pm-emerald-300);
        background: rgba(16, 185, 129, .09);
        border: 1px solid rgba(16,185,129,.13);
    }

    .finance-transaction-icon.toll {
        color: var(--pm-cyan);
        background: rgba(34,211,238,.08);
    }

    .finance-transaction-icon.parking {
        color: var(--pm-warning);
        background: rgba(251,191,36,.08);
    }

    .finance-transaction-icon.allowance {
        color: var(--pm-success);
        background: var(--pm-success-bg);
    }

    .finance-transaction-icon.payment {
        color: var(--pm-info);
        background: var(--pm-info-bg);
    }

    .finance-transaction-icon.other {
        color: var(--pm-text-soft);
        background: rgba(255,255,255,.045);
    }

    .finance-transaction-main strong,
    .finance-fuel-volume strong,
    .finance-transaction-amount strong {
        display: block;
        font-size: 9px;
    }

    .finance-transaction-main span,
    .finance-fuel-volume span {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-fuel-card-label small {
        display: block;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-fuel-card-label strong {
        display: block;
        margin-top: 2px;
        font-size: 8px;
        color: var(--pm-emerald-300);
    }

    .finance-transaction-amount {
        text-align: right;
    }

    .finance-transaction-amount .finance-status {
        margin-top: 4px;
        margin-left: auto;
    }


    /* =========================================================
       BALANCE
    ========================================================== */

    .finance-balance-card {
        overflow: hidden;
    }

    .finance-balance-ring {
        width: 180px;
        height: 180px;
        margin: 2px auto 19px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        position: relative;
        background:
            conic-gradient(
                var(--pm-emerald-400) 0deg 282deg,
                rgba(255,255,255,.055) 282deg 360deg
            );
        animation: financeBalanceEntrance .9s cubic-bezier(.16,1,.3,1);
    }

    @@keyframes financeBalanceEntrance {
        from {
            transform: scale(.86) rotate(-8deg);
            opacity: .2;
        }

        to {
            transform: scale(1) rotate(0);
            opacity: 1;
        }
    }

    .finance-balance-ring::before {
        content: "";
        position: absolute;
        inset: 6px;
        border-radius: 50%;
        background: #031c18;
    }

    .finance-balance-ring-inner {
        position: relative;
        z-index: 1;
        text-align: center;
    }

    .finance-balance-ring-inner span,
    .finance-balance-ring-inner small {
        display: block;
        color: var(--pm-text-dim);
    }

    .finance-balance-ring-inner span {
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .finance-balance-ring-inner strong {
        display: block;
        margin: 6px 0 4px;
        color: var(--pm-emerald-300);
        font-size: 20px;
        letter-spacing: -.04em;
    }

    .finance-balance-ring-inner small {
        font-size: 7px;
    }

    .finance-balance-breakdown {
        display: grid;
        gap: 8px;
    }

    .finance-balance-breakdown > div {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        font-size: 9px;
    }

    .finance-balance-breakdown span {
        color: var(--pm-text-muted);
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .finance-balance-breakdown strong {
        font-size: 9px;
    }

    .finance-bullet {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .finance-bullet.green {
        background: var(--pm-success);
    }

    .finance-bullet.yellow {
        background: var(--pm-warning);
    }

    .finance-bullet.red {
        background: var(--pm-danger);
    }

    .finance-balance-total {
        border-top: 1px solid var(--pm-border);
        margin-top: 3px;
        padding-top: 9px;
    }

    .finance-balance-total strong {
        color: var(--pm-emerald-300);
        font-size: 12px;
    }

    .finance-info-box {
        display: flex;
        gap: 9px;
        margin-top: 15px;
        padding: 10px;
        border-radius: 9px;
        background: rgba(56,189,248,.055);
        border: 1px solid rgba(56,189,248,.1);
    }

    .finance-info-box > span {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        background: rgba(56,189,248,.12);
        color: var(--pm-info);
        font-size: 8px;
        font-weight: 900;
    }

    .finance-info-box p {
        margin: 0;
        color: var(--pm-text-muted);
        font-size: 8px;
        line-height: 1.55;
    }


    /* =========================================================
       PREVIOUS TRIP
    ========================================================== */

    .finance-previous-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .finance-previous-summary > div {
        padding: 9px;
        border-radius: 9px;
        background: rgba(255,255,255,.022);
        border: 1px solid var(--pm-border-soft);
    }

    .finance-previous-summary strong {
        display: block;
        margin-top: 4px;
        font-size: 10px;
    }

    .finance-positive {
        color: var(--pm-success) !important;
    }

    .finance-negative {
        color: #fda4af !important;
    }


    /* =========================================================
       PENDING
    ========================================================== */

    .finance-count-badge {
        min-width: 27px;
        height: 27px;
        padding: 0 7px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: var(--pm-warning-bg);
        color: var(--pm-warning);
        font-size: 9px;
        font-weight: 850;
    }

    .finance-pending-list {
        display: grid;
        gap: 5px;
    }

    .finance-pending-item {
        width: 100%;
        padding: 8px;
        border: 1px solid transparent;
        border-radius: 9px;
        background: rgba(255,255,255,.02);
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 8px;
        align-items: center;
        text-align: left;
        color: inherit;
        font: inherit;
        cursor: pointer;
        transition: .2s ease;
    }

    .finance-pending-item:hover {
        transform: translateX(2px);
        background: rgba(255,255,255,.038);
        border-color: var(--pm-border);
    }

    .finance-pending-main strong {
        display: block;
        font-size: 9px;
    }

    .finance-pending-main small {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-pending-value {
        color: var(--pm-warning);
        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================================
       ASSIGNED CARDS
    ========================================================== */

    .finance-assigned-cards {
        display: grid;
        gap: 6px;
    }

    .finance-assigned-card {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 9px;
        align-items: center;
        padding: 9px;
        border-radius: 9px;
        background: rgba(255,255,255,.02);
        border: 1px solid var(--pm-border-soft);
    }

    .finance-assigned-logo {
        width: 35px;
        height: 28px;
        border-radius: 7px;
        display: grid;
        place-items: center;
        font-size: 7px;
        font-weight: 900;
    }

    .finance-assigned-logo.uta {
        background: rgba(16,185,129,.1);
        color: var(--pm-emerald-300);
    }

    .finance-assigned-logo.dkv {
        background: rgba(56,189,248,.1);
        color: var(--pm-info);
    }

    .finance-assigned-logo.visa {
        background: rgba(167,139,250,.1);
        color: #c4b5fd;
    }

    .finance-assigned-card strong {
        display: block;
        font-size: 9px;
    }

    .finance-assigned-card div span {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-dot-online {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--pm-success);
        box-shadow: 0 0 8px rgba(52,211,153,.45);
    }


    /* =========================================================
       FILTERS
    ========================================================== */

    .finance-filters {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 170px 140px;
        gap: 7px;
        margin-bottom: 10px;
    }

    .finance-search {
        position: relative;
    }

    .finance-search > span {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--pm-text-dim);
    }

    .finance-search input {
        padding-left: 30px !important;
    }

    .finance-filters input,
    .finance-filters select,
    .finance-field input,
    .finance-field select,
    .finance-field textarea {
        width: 100%;
        border: 1px solid var(--pm-border);
        border-radius: 9px;
        background: rgba(0,0,0,.15);
        color: var(--pm-text);
        outline: none;
        font: inherit;
        font-size: 9px;
        transition:
            border-color .2s ease,
            box-shadow .2s ease;
    }

    .finance-filters input,
    .finance-filters select,
    .finance-field input,
    .finance-field select {
        height: 36px;
        padding: 0 10px;
    }

    .finance-field textarea {
        resize: vertical;
        padding: 10px;
    }

    .finance-filters input:focus,
    .finance-filters select:focus,
    .finance-field input:focus,
    .finance-field select:focus,
    .finance-field textarea:focus {
        border-color: rgba(52,211,153,.45);
        box-shadow: 0 0 0 3px rgba(16,185,129,.06);
    }

    .finance-filters option,
    .finance-field option {
        background: #05251f;
    }


    /* =========================================================
       TABLE
    ========================================================== */

    .finance-table-wrap {
        overflow-x: auto;
    }

    .finance-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

    .finance-table th {
        padding: 8px 8px;
        color: var(--pm-text-dim);
        font-size: 7px;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 750;
        border-bottom: 1px solid var(--pm-border);
    }

    .finance-table td {
        padding: 8px;
        border-bottom: 1px solid var(--pm-border-soft);
        color: var(--pm-text-soft);
        font-size: 8px;
    }

    .finance-table tbody tr {
        transition:
            background .18s ease,
            transform .18s ease,
            opacity .2s ease;
    }

    .finance-table tbody tr:hover {
        background: rgba(255,255,255,.018);
    }

    .finance-table-transaction {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .finance-table-transaction strong {
        display: block;
        font-size: 9px;
    }

    .finance-table-transaction div > span,
    .finance-table-sub {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-payment-method {
        color: var(--pm-emerald-300);
        font-size: 8px;
    }

    .align-right {
        text-align: right !important;
    }

    .finance-table-empty {
        display: none;
        text-align: center;
        padding: 35px 15px 22px;
        color: var(--pm-text-dim);
    }

    .finance-table-empty > div {
        font-size: 24px;
    }

    .finance-table-empty strong {
        display: block;
        margin-top: 7px;
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .finance-table-empty span {
        display: block;
        margin-top: 4px;
        font-size: 8px;
    }


    /* =========================================================
       MODAL
    ========================================================== */

    .finance-modal {
        position: fixed;
        z-index: 5000;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 20px;
        visibility: hidden;
        opacity: 0;
        transition: .22s ease;
    }

    .finance-modal.open {
        visibility: visible;
        opacity: 1;
    }

    .finance-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 10, 8, .76);
        backdrop-filter: blur(8px);
    }

    .finance-modal-dialog {
        position: relative;
        z-index: 1;
        width: min(720px, 100%);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
        padding: 20px;
        border-radius: 18px;
        border: 1px solid var(--pm-border-strong);
        background:
            linear-gradient(
                145deg,
                rgba(5,39,32,.98),
                rgba(2,21,18,.99)
            );
        box-shadow: 0 30px 100px rgba(0,0,0,.55);
        transform: translateY(16px) scale(.985);
        transition: transform .25s cubic-bezier(.16,1,.3,1);
    }

    .finance-modal.open .finance-modal-dialog {
        transform: translateY(0) scale(1);
    }

    .finance-modal-header {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .finance-modal-header h2 {
        margin: 4px 0 0;
        font-size: 19px;
    }

    .finance-modal-header p {
        margin: 4px 0 0;
        color: var(--pm-text-muted);
        font-size: 9px;
    }

    .finance-modal-close {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border: 1px solid var(--pm-border);
        background: rgba(255,255,255,.025);
        color: var(--pm-text-muted);
        font-size: 20px;
        cursor: pointer;
    }

    .finance-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 10px;
    }

    .finance-field {
        display: block;
    }

    .finance-field > span {
        display: block;
        margin-bottom: 5px;
        color: var(--pm-text-muted);
        font-size: 8px;
        font-weight: 700;
    }

    .finance-field-wide {
        grid-column: 1 / -1;
    }

    .finance-field-block {
        margin-top: 11px;
    }

    .finance-money-input {
        position: relative;
    }

    .finance-money-input input {
        padding-right: 45px;
    }

    .finance-money-input > span {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--pm-text-dim);
        font-size: 8px;
        pointer-events: none;
    }

    .finance-fuel-fields {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--pm-border);
    }

    .finance-form-section-title {
        margin-bottom: 9px;
        color: var(--pm-emerald-300);
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: .1em;
        font-weight: 800;
    }

    .finance-upload {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        padding: 11px;
        border: 1px dashed rgba(52,211,153,.2);
        border-radius: 11px;
        background: rgba(16,185,129,.025);
    }

    .finance-upload-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: rgba(16,185,129,.08);
        color: var(--pm-emerald-300);
    }

    .finance-upload > div:nth-child(2) {
        flex: 1;
    }

    .finance-upload strong {
        display: block;
        font-size: 9px;
    }

    .finance-upload span {
        display: block;
        margin-top: 3px;
        color: var(--pm-text-dim);
        font-size: 7px;
    }

    .finance-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding-top: 16px;
        margin-top: 16px;
        border-top: 1px solid var(--pm-border);
    }


    /* =========================================================
       TOAST
    ========================================================== */

    .finance-toast {
        position: fixed;
        z-index: 5100;
        right: 22px;
        bottom: 22px;
        min-width: 280px;
        max-width: 360px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        border: 1px solid rgba(52,211,153,.24);
        border-radius: 12px;
        background: rgba(3,28,24,.96);
        box-shadow: 0 18px 48px rgba(0,0,0,.36);
        transform: translateY(25px);
        opacity: 0;
        visibility: hidden;
        transition: .25s ease;
    }

    .finance-toast.show {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    .finance-toast-icon {
        width: 31px;
        height: 31px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border-radius: 9px;
        color: var(--pm-success);
        background: var(--pm-success-bg);
    }

    .finance-toast strong {
        display: block;
        font-size: 9px;
    }

    .finance-toast div span {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-muted);
        font-size: 8px;
    }


    /* =========================================================
       DISPATCH MODE
    ========================================================== */

    .pm-finance-page.finance-dispatch-mode
    .finance-context-icon {
        color: var(--pm-cyan);
        background: rgba(34,211,238,.08);
        border-color: rgba(34,211,238,.14);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 1350px) {

        .finance-kpi-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .finance-main-grid {
            grid-template-columns: minmax(0,1.45fr) minmax(290px,.7fr);
        }

        .finance-trip-identity {
            grid-template-columns: repeat(2,1fr);
        }

        .finance-fuel-card-area {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 1050px) {

        .pm-finance-page {
            padding: 20px;
        }

        .finance-main-grid {
            grid-template-columns: 1fr;
        }

        .finance-side-column {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 12px;
        }

        .finance-side-column .finance-card {
            margin-top: 0;
        }

        .finance-kpi-grid {
            grid-template-columns: repeat(2,1fr);
        }

    }

    @@media (max-width: 760px) {

        .pm-finance-page {
            padding: 14px;
        }

        .finance-page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .finance-header-actions {
            width: 100%;
        }

        .finance-header-actions .finance-btn {
            flex: 1;
        }

        .finance-context-bar {
            grid-template-columns: 1fr;
        }

        .finance-mode-switch {
            width: 100%;
        }

        .finance-mode-button {
            flex: 1;
        }

        .finance-kpi-grid {
            grid-template-columns: 1fr 1fr;
        }

        .finance-kpi:first-child {
            grid-column: 1 / -1;
        }

        .finance-trip-identity,
        .finance-trip-stats,
        .finance-previous-summary {
            grid-template-columns: repeat(2,1fr);
        }

        .finance-fuel-row {
            grid-template-columns: auto 1fr auto;
        }

        .finance-fuel-card-label,
        .finance-fuel-volume {
            grid-column: 2 / -1;
        }

        .finance-transaction-amount {
            grid-column: 3;
            grid-row: 1;
        }

        .finance-side-column {
            grid-template-columns: 1fr;
        }

        .finance-filters {
            grid-template-columns: 1fr;
        }

        .finance-form-grid {
            grid-template-columns: 1fr;
        }

        .finance-field-wide {
            grid-column: auto;
        }

        .finance-upload {
            align-items: flex-start;
            flex-wrap: wrap;
        }

    }

    @@media (max-width: 480px) {

        .finance-kpi-grid {
            grid-template-columns: 1fr;
        }

        .finance-kpi:first-child {
            grid-column: auto;
        }

        .finance-trip-identity,
        .finance-trip-stats,
        .finance-previous-summary,
        .finance-fuel-summary {
            grid-template-columns: 1fr 1fr;
        }

        .finance-card {
            padding: 14px;
        }

        .finance-physical-card {
            min-height: 170px;
        }

        .finance-card-number {
            font-size: 12px;
        }

        .finance-modal {
            padding: 8px;
        }

        .finance-modal-dialog {
            padding: 15px;
            max-height: calc(100vh - 16px);
        }

        .finance-toast {
            left: 12px;
            right: 12px;
            bottom: 12px;
            min-width: 0;
        }

    }

    @@media (prefers-reduced-motion: reduce) {

        .finance-reveal,
        .finance-kicker-dot,
        .finance-balance-ring {
            animation: none !important;
            opacity: 1;
            transform: none;
        }

        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
        }

    }

</style>

@section Scripts {

<script>

(() => {

    "use strict";

    const page = document.querySelector(".pm-finance-page");

    if (!page) {
        return;
    }

    /* =========================================================
       ELEMENTS
    ========================================================== */

    const modal =
        document.getElementById("expenseModal");

    const openExpenseButton =
        document.getElementById("openExpenseModal");

    const closeExpenseButtons =
        document.querySelectorAll("[data-close-expense-modal]");

    const expenseForm =
        document.getElementById("expenseForm");

    const expenseCategory =
        document.getElementById("expenseCategory");

    const expensePaymentMethod =
        document.getElementById("expensePaymentMethod");

    const expenseCardField =
        document.getElementById("expenseCardField");

    const fuelFields =
        document.getElementById("fuelSpecificFields");

    const searchInput =
        document.getElementById("financeSearch");

    const categoryFilter =
        document.getElementById("financeCategoryFilter");

    const statusFilter =
        document.getElementById("financeStatusFilter");

    const table =
        document.getElementById("financeTransactionTable");

    const emptyState =
        document.getElementById("financeTableEmpty");

    const modeButtons =
        document.querySelectorAll("[data-finance-mode]");

    const contextTitle =
        document.getElementById("financeContextTitle");

    const refreshButton =
        document.getElementById("financeRefreshButton");

    const exportButton =
        document.getElementById("exportFinanceButton");

    const toast =
        document.getElementById("financeToast");

    const toastTitle =
        document.getElementById("financeToastTitle");

    const toastText =
        document.getElementById("financeToastText");


    /* =========================================================
       NUMBER ANIMATION
    ========================================================== */

    const currencyFormatter =
        new Intl.NumberFormat("sr-RS", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

    function animateFinanceValues() {

        document
            .querySelectorAll("[data-finance-value]")
            .forEach(element => {

                const target =
                    Number(element.dataset.financeValue || 0);

                const duration = 900;
                const started = performance.now();

                const frame = now => {

                    const progress =
                        Math.min((now - started) / duration, 1);

                    const eased =
                        1 - Math.pow(1 - progress, 3);

                    const current =
                        target * eased;

                    element.textContent =
                        `${currencyFormatter.format(current)} €`;

                    if (progress < 1) {
                        requestAnimationFrame(frame);
                    }

                };

                requestAnimationFrame(frame);

            });

    }


    /* =========================================================
       PROGRESS
    ========================================================== */

    function animateProgressBars() {

        requestAnimationFrame(() => {

            document
                .querySelectorAll(".finance-progress-bar")
                .forEach(bar => {

                    const width =
                        Number(bar.dataset.width || 0);

                    setTimeout(() => {
                        bar.style.width = `${width}%`;
                    }, 180);

                });

        });

    }


    /* =========================================================
       MODAL
    ========================================================== */

    function openExpenseModal() {

        modal.classList.add("open");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

        updateExpenseFields();

    }

    function closeExpenseModal() {

        modal.classList.remove("open");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

    }

    openExpenseButton?.addEventListener(
        "click",
        openExpenseModal
    );

    closeExpenseButtons.forEach(button => {

        button.addEventListener(
            "click",
            closeExpenseModal
        );

    });

    document.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Escape" &&
                modal.classList.contains("open")
            ) {
                closeExpenseModal();
            }

        }
    );


    /* =========================================================
       EXPENSE FORM CONDITIONAL FIELDS
    ========================================================== */

    function updateExpenseFields() {

        const isFuel =
            expenseCategory.value === "fuel";

        fuelFields.style.display =
            isFuel ? "block" : "none";

        const requiresCard =
            expensePaymentMethod.value !== "cash";

        expenseCardField.style.display =
            requiresCard ? "block" : "none";

    }

    expenseCategory?.addEventListener(
        "change",
        updateExpenseFields
    );

    expensePaymentMethod?.addEventListener(
        "change",
        updateExpenseFields
    );


    /* =========================================================
       SAVE EXPENSE - UI ONLY
    ========================================================== */

    expenseForm?.addEventListener(
        "submit",
        event => {

            event.preventDefault();

            const saveButton =
                expenseForm.querySelector(
                    'button[type="submit"]'
                );

            const original =
                saveButton.innerHTML;

            saveButton.disabled = true;

            saveButton.innerHTML =
                "Čuvanje...";

            setTimeout(() => {

                saveButton.disabled = false;
                saveButton.innerHTML = original;

                closeExpenseModal();

                showToast(
                    "Trošak evidentiran",
                    "UI unos je uspešno dodat. API povezivanje radimo kasnije."
                );

                expenseForm.reset();

                updateExpenseFields();

            }, 650);

        }
    );


    /* =========================================================
       FILTER TABLE
    ========================================================== */

    function filterTransactions() {

        const query =
            (searchInput.value || "")
                .trim()
                .toLowerCase();

        const category =
            categoryFilter.value;

        const status =
            statusFilter.value;

        const rows =
            [...table.querySelectorAll("tr")];

        let visible = 0;

        rows.forEach(row => {

            const searchable =
                (
                    row.dataset.search ||
                    row.textContent ||
                    ""
                ).toLowerCase();

            const rowCategory =
                row.dataset.category;

            const rowStatus =
                row.dataset.status;

            const matchesSearch =
                !query ||
                searchable.includes(query);

            const matchesCategory =
                category === "all" ||
                rowCategory === category;

            const matchesStatus =
                status === "all" ||
                rowStatus === status;

            const shouldShow =
                matchesSearch &&
                matchesCategory &&
                matchesStatus;

            row.style.display =
                shouldShow ? "" : "none";

            if (shouldShow) {
                visible++;
            }

        });

        emptyState.style.display =
            visible === 0
                ? "block"
                : "none";

    }

    searchInput?.addEventListener(
        "input",
        filterTransactions
    );

    categoryFilter?.addEventListener(
        "change",
        filterTransactions
    );

    statusFilter?.addEventListener(
        "change",
        filterTransactions
    );


    /* =========================================================
       MODE SWITCH
    ========================================================== */

    modeButtons.forEach(button => {

        button.addEventListener(
            "click",
            () => {

                modeButtons.forEach(item =>
                    item.classList.remove("active")
                );

                button.classList.add("active");

                const mode =
                    button.dataset.financeMode;

                if (mode === "dispatch") {

                    page.classList.add(
                        "finance-dispatch-mode"
                    );

                    contextTitle.textContent =
                        "Dispatch · Marko Petrović";

                    showToast(
                        "Dispatch pregled",
                        "Prikazan je operativni finansijski kontekst vozača i ture."
                    );

                }
                else {

                    page.classList.remove(
                        "finance-dispatch-mode"
                    );

                    contextTitle.textContent =
                        "Marko Petrović";

                    showToast(
                        "Pregled vozača",
                        "Prikazane su finansije trenutno izabranog vozača."
                    );

                }

            }
        );

    });


    /* =========================================================
       REFRESH
    ========================================================== */

    refreshButton?.addEventListener(
        "click",
        () => {

            refreshButton.disabled = true;

            const original =
                refreshButton.innerHTML;

            refreshButton.innerHTML =
                "<span>↻</span> Osvežavanje...";

            setTimeout(() => {

                refreshButton.disabled = false;

                refreshButton.innerHTML =
                    original;

                animateFinanceValues();
                animateProgressBars();

                showToast(
                    "Finansije osvežene",
                    "Prikaz je uspešno osvežen."
                );

            }, 650);

        }
    );


    /* =========================================================
       EXPORT
    ========================================================== */

    exportButton?.addEventListener(
        "click",
        () => {

            showToast(
                "Izvoz",
                "UI za izvoz je spreman. Backend izvoz povezujemo kasnije."
            );

        }
    );


    /* =========================================================
       PREVIOUS TRIP
    ========================================================== */

    document
        .getElementById("previousTripDetails")
        ?.addEventListener(
            "click",
            () => {

                showToast(
                    "TR-2026-00887",
                    "Detaljni obračun prethodne ture biće otvoren iz API podataka."
                );

            }
        );


    /* =========================================================
       TOAST
    ========================================================== */

    let toastTimeout = null;

    function showToast(title, text) {

        toastTitle.textContent =
            title;

        toastText.textContent =
            text;

        toast.classList.add("show");

        if (toastTimeout) {
            clearTimeout(toastTimeout);
        }

        toastTimeout =
            setTimeout(
                () => toast.classList.remove("show"),
                3200
            );

    }


    /* =========================================================
       INITIALIZE
    ========================================================== */

    animateFinanceValues();

    animateProgressBars();

    updateExpenseFields();

})();

</script>

}