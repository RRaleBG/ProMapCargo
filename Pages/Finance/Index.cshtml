                    </div>

                </div>

                <div class="finance-trip-stats">
                    <div>
                        <span>Gorivo</span>
                        <strong>911,69 €</strong>
                    </div>

                    <div>
                        <span>Putarine</span>
                        <strong>133,40 €</strong>
                    </div>

