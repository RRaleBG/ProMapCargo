@page "/monitoring"
@{
    ViewData["Title"] = "Monitoring · ProMap Cargo";
}

<div class="pm-page pm-monitoring-page" data-module="monitoring">

    <style>
        .pm-monitoring-page {
            --monitor-green: #10b981;
            --monitor-teal: #2dd4bf;
            --monitor-cyan: #22d3ee;
            --monitor-warning: #fbbf24;
            --monitor-danger: #fb7185;
            --monitor-info: #38bdf8;
            --monitor-surface: rgba(4, 31, 26, 0.82);
            --monitor-surface-strong: rgba(5, 39, 32, 0.94);
            --monitor-border: rgba(79, 209, 169, 0.16);
            --monitor-border-strong: rgba(45, 212, 191, 0.34);
            --monitor-muted: #8eb8aa;
            --monitor-dim: #638b80;
            width: 100%;
        }

        .monitoring-shell {
            width: 100%;
            max-width: 1800px;
            margin: 0 auto;
            padding: 28px 30px 38px;
        }

        .monitoring-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 24px;
        }

        .monitoring-kicker {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--monitor-teal);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .monitoring-kicker::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--monitor-green);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, .45);
            animation: monitoringPulse 2s infinite;
        }

        .monitoring-title {
            margin: 0;
            color: var(--pm-text);
            font-size: clamp(28px, 3vw, 42px);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -.035em;
        }

        .monitoring-subtitle {
            margin: 10px 0 0;
            color: var(--monitor-muted);
            max-width: 780px;
            font-size: 14px;
            line-height: 1.65;
        }

        .monitoring-header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .monitoring-live {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            min-height: 42px;
            padding: 0 15px;
            border: 1px solid var(--monitor-border);
            border-radius: 12px;
            background: rgba(3, 28, 24, .7);
            color: var(--pm-text-soft);
            font-size: 12px;
            font-weight: 750;
        }

        .monitoring-live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--monitor-green);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, .55);
            animation: monitoringPulse 1.8s infinite;
        }

        .monitoring-live.offline .monitoring-live-dot {
            background: var(--monitor-warning);
            animation: none;
        }

        .monitoring-btn {
            min-height: 42px;
            padding: 0 16px;
            border: 1px solid var(--monitor-border);
            border-radius: 12px;
            background: rgba(5, 39, 32, .82);
            color: var(--pm-text);
            font: inherit;
            font-size: 12px;
            font-weight: 750;
            cursor: pointer;
            transition:
                transform .18s ease,
                border-color .18s ease,
                background .18s ease,
                box-shadow .18s ease;
        }

        .monitoring-btn:hover {
            transform: translateY(-2px);
            border-color: var(--monitor-border-strong);
            background: rgba(7, 52, 43, .95);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .18);
        }

        .monitoring-btn.primary {
            background: linear-gradient(135deg, #059669, #10b981);
            border-color: rgba(110, 231, 183, .3);
            color: #ecfdf5;
        }

        .monitoring-kpis {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .monitoring-kpi {
            position: relative;
            overflow: hidden;
            min-height: 126px;
            padding: 18px;
            border: 1px solid var(--monitor-border);
            border-radius: 17px;
            background:
                radial-gradient(circle at 90% 10%, rgba(45, 212, 191, .08), transparent 35%),
                var(--monitor-surface);
            box-shadow: 0 16px 45px rgba(0, 0, 0, .14);
            animation: monitoringCardIn .55s both;
        }

        .monitoring-kpi:nth-child(2) {
            animation-delay: .06s;
        }

        .monitoring-kpi:nth-child(3) {
            animation-delay: .12s;
        }

        .monitoring-kpi:nth-child(4) {
            animation-delay: .18s;
        }

        .monitoring-kpi:nth-child(5) {
            animation-delay: .24s;
        }

        .monitoring-kpi::after {
            content: "";
            position: absolute;
            left: -35%;
            right: -35%;
            bottom: -80px;
            height: 120px;
            background: rgba(16, 185, 129, .055);
            filter: blur(25px);
            pointer-events: none;
        }

        .monitoring-kpi-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: var(--monitor-muted);
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        .monitoring-kpi-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            border: 1px solid var(--monitor-border);
            background: rgba(16, 185, 129, .08);
            color: var(--monitor-teal);
            font-size: 18px;
        }

        .monitoring-kpi-value {
            margin-top: 13px;
            color: var(--pm-text);
            font-size: 30px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: -.035em;
        }

        .monitoring-kpi-meta {
            margin-top: 8px;
            color: var(--monitor-dim);
            font-size: 11px;
        }

        .monitoring-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            gap: 18px;
            min-height: 650px;
        }

        .monitoring-map-card,
        .monitoring-side-card {
            border: 1px solid var(--monitor-border);
            border-radius: 18px;
            background: var(--monitor-surface);
            box-shadow: 0 18px 50px rgba(0, 0, 0, .18);
            overflow: hidden;
        }

        .monitoring-map-card {
            position: relative;
            min-height: 650px;
        }

        .monitoring-card-header {
            position: absolute;
            z-index: 900;
            top: 16px;
            left: 16px;
            right: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            pointer-events: none;
        }

        .monitoring-map-title {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 13px;
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 12px;
            background: rgba(2, 21, 18, .88);
            backdrop-filter: blur(16px);
            color: var(--pm-text);
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .22);
        }

        .monitoring-map-title span {
            color: var(--monitor-muted);
            font-weight: 600;
        }

        .monitoring-map-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid rgba(16, 185, 129, .2);
            border-radius: 12px;
            background: rgba(2, 21, 18, .88);
            backdrop-filter: blur(16px);
            color: var(--monitor-green);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .monitoring-map-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
            animation: monitoringPulse 1.5s infinite;
        }

        #monitoringMap {
            width: 100%;
            min-height: 650px;
            background: #061a16;
        }

        .monitoring-map-controls {
            position: absolute;
            z-index: 900;
            left: 16px;
            bottom: 16px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .monitoring-map-control {
            min-height: 38px;
            padding: 0 12px;
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 10px;
            background: rgba(2, 21, 18, .9);
            backdrop-filter: blur(14px);
            color: var(--pm-text-soft);
            cursor: pointer;
            font: inherit;
            font-size: 11px;
            font-weight: 750;
            transition: all .18s ease;
        }

        .monitoring-map-control:hover {
            border-color: var(--monitor-border-strong);
            transform: translateY(-1px);
        }

        .monitoring-map-legend {
            position: absolute;
            z-index: 900;
            right: 16px;
            bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 9px 12px;
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 10px;
            background: rgba(2, 21, 18, .9);
            backdrop-filter: blur(14px);
            color: var(--monitor-muted);
            font-size: 10px;
        }

        .monitoring-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .monitoring-legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .monitoring-legend-dot.online {
            background: var(--monitor-green);
            box-shadow: 0 0 10px rgba(16, 185, 129, .65);
        }

        .monitoring-legend-dot.idle {
            background: var(--monitor-warning);
        }

        .monitoring-legend-dot.offline {
            background: var(--monitor-danger);
        }

        .monitoring-side {
            display: flex;
            flex-direction: column;
            gap: 18px;
            min-width: 0;
        }

        .monitoring-side-card {
            padding: 18px;
        }

        .monitoring-side-card:first-child {
            flex: 1;
        }

        .monitoring-section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 15px;
        }

        .monitoring-section-title {
            margin: 0;
            color: var(--pm-text);
            font-size: 14px;
            font-weight: 800;
        }

        .monitoring-section-meta {
            color: var(--monitor-dim);
            font-size: 10px;
            font-weight: 700;
        }

        .monitoring-filters {
            display: flex;
            gap: 7px;
            margin-bottom: 14px;
        }

        .monitoring-filter {
            flex: 1;
            min-height: 34px;
            padding: 0 8px;
            border: 1px solid var(--monitor-border);
            border-radius: 9px;
            background: rgba(2, 21, 18, .65);
            color: var(--monitor-muted);
            font: inherit;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
        }

        .monitoring-filter.active {
            border-color: rgba(45, 212, 191, .35);
            background: rgba(45, 212, 191, .08);
            color: var(--monitor-teal);
        }

        .monitoring-vehicle-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 465px;
            overflow-y: auto;
            padding-right: 3px;
        }

        .monitoring-vehicle-list::-webkit-scrollbar {
            width: 5px;
        }

        .monitoring-vehicle-list::-webkit-scrollbar-thumb {
            background: rgba(45, 212, 191, .2);
            border-radius: 999px;
        }

        .monitoring-vehicle {
            position: relative;
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr) auto;
            gap: 11px;
            align-items: center;
            padding: 11px;
            border: 1px solid transparent;
            border-radius: 12px;
            background: rgba(3, 28, 24, .54);
            cursor: pointer;
            transition:
                background .2s ease,
                border-color .2s ease,
                transform .2s ease;
            animation: monitoringRowIn .35s both;
        }

        .monitoring-vehicle:hover {
            transform: translateX(2px);
            border-color: var(--monitor-border);
            background: rgba(7, 52, 43, .72);
        }

        .monitoring-vehicle.selected {
            border-color: rgba(45, 212, 191, .36);
            background: rgba(7, 70, 57, .62);
            box-shadow: inset 3px 0 0 var(--monitor-teal);
        }

        .monitoring-vehicle-icon {
            position: relative;
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            border: 1px solid var(--monitor-border);
            background: rgba(16, 185, 129, .08);
            color: var(--monitor-teal);
            font-size: 19px;
        }

        .monitoring-vehicle-icon::after {
            content: "";
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 9px;
            height: 9px;
            border: 2px solid #031c18;
            border-radius: 50%;
            background: var(--monitor-green);
        }

        .monitoring-vehicle.idle .monitoring-vehicle-icon::after {
            background: var(--monitor-warning);
        }

        .monitoring-vehicle.offline .monitoring-vehicle-icon::after {
            background: var(--monitor-danger);
        }

        .monitoring-vehicle-main {
            min-width: 0;
        }

        .monitoring-vehicle-name {
            overflow: hidden;
            color: var(--pm-text);
            font-size: 12px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .monitoring-vehicle-driver {
            margin-top: 4px;
            overflow: hidden;
            color: var(--monitor-dim);
            font-size: 10px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .monitoring-vehicle-right {
            text-align: right;
        }

        .monitoring-speed {
            color: var(--pm-text);
            font-size: 15px;
            font-weight: 800;
        }

        .monitoring-speed small {
            color: var(--monitor-dim);
            font-size: 9px;
            font-weight: 600;
        }

        .monitoring-status-text {
            margin-top: 3px;
            color: var(--monitor-green);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .monitoring-vehicle.idle .monitoring-status-text {
            color: var(--monitor-warning);
        }

        .monitoring-vehicle.offline .monitoring-status-text {
            color: var(--monitor-danger);
        }

        .monitoring-detail-card {
            min-height: 245px;
        }

        .monitoring-detail-empty {
            display: grid;
            min-height: 190px;
            place-items: center;
            text-align: center;
            color: var(--monitor-dim);
            font-size: 11px;
            line-height: 1.6;
        }

        .monitoring-detail-empty-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            margin: 0 auto 10px;
            border: 1px solid var(--monitor-border);
            border-radius: 14px;
            color: var(--monitor-teal);
            background: rgba(16, 185, 129, .07);
            font-size: 20px;
        }

        .monitoring-detail-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 17px;
        }

        .monitoring-detail-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border: 1px solid var(--monitor-border);
            border-radius: 13px;
            background: rgba(16, 185, 129, .08);
            color: var(--monitor-teal);
            font-size: 21px;
        }

        .monitoring-detail-name {
            color: var(--pm-text);
            font-size: 14px;
            font-weight: 800;
        }

        .monitoring-detail-status {
            margin-top: 4px;
            color: var(--monitor-green);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .monitoring-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .monitoring-detail-stat {
            padding: 10px;
            border: 1px solid var(--monitor-border);
            border-radius: 10px;
            background: rgba(2, 21, 18, .5);
        }

        .monitoring-detail-label {
            color: var(--monitor-dim);
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .monitoring-detail-value {
            margin-top: 5px;
            overflow: hidden;
            color: var(--pm-text-soft);
            font-size: 12px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .monitoring-alert-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .monitoring-alert {
            display: grid;
            grid-template-columns: 30px minmax(0, 1fr);
            gap: 9px;
            padding: 10px;
            border: 1px solid rgba(251, 191, 36, .14);
            border-radius: 10px;
            background: rgba(245, 158, 11, .055);
            animation: monitoringAlertIn .4s both;
        }

        .monitoring-alert-icon {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: rgba(245, 158, 11, .1);
            color: var(--monitor-warning);
        }

        .monitoring-alert-title {
            color: var(--pm-text-soft);
            font-size: 10px;
            font-weight: 800;
        }

        .monitoring-alert-meta {
            margin-top: 3px;
            color: var(--monitor-dim);
            font-size: 9px;
        }

        .monitoring-empty {
            padding: 28px 14px;
            text-align: center;
            color: var(--monitor-dim);
            font-size: 11px;
        }

        .monitoring-loading {
            position: absolute;
            z-index: 1000;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(1, 13, 11, .42);
            backdrop-filter: blur(2px);
            transition: opacity .25s ease;
        }

        .monitoring-loading.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .monitoring-loader {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 15px;
            border: 1px solid var(--monitor-border);
            border-radius: 12px;
            background: rgba(2, 21, 18, .9);
            color: var(--monitor-text-soft);
            font-size: 11px;
            font-weight: 750;
        }

        .monitoring-loader-ring {
            width: 17px;
            height: 17px;
            border: 2px solid rgba(45, 212, 191, .2);
            border-top-color: var(--monitor-teal);
            border-radius: 50%;
            animation: monitoringSpin .8s linear infinite;
        }

        .monitoring-toast {
            position: fixed;
            z-index: 3000;
            right: 24px;
            bottom: 24px;
            max-width: 360px;
            padding: 13px 16px;
            border: 1px solid var(--monitor-border);
            border-radius: 12px;
            background: rgba(2, 21, 18, .94);
            box-shadow: 0 18px 45px rgba(0, 0, 0, .3);
            color: var(--pm-text-soft);
            font-size: 11px;
            font-weight: 700;
            opacity: 0;
            transform: translateY(12px);
            pointer-events: none;
            transition: all .25s ease;
        }

        .monitoring-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .monitoring-map-card .leaflet-control-zoom {
            margin-top: 80px;
        }

        .monitoring-map-card .leaflet-control-zoom a {
            background: rgba(2, 21, 18, .9);
            color: var(--pm-text-soft);
            border-color: rgba(255, 255, 255, .08);
        }

        .monitoring-map-card .leaflet-control-attribution {
            background: rgba(2, 21, 18, .72);
            color: rgba(209, 250, 229, .55);
        }

        .monitoring-map-card .leaflet-control-attribution a {
            color: var(--monitor-teal);
        }

        .pm-monitor-vehicle-marker {
            position: relative;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
        }

        .pm-monitor-vehicle-marker::before {
            content: "";
            position: absolute;
            inset: 3px;
            border: 1px solid rgba(45, 212, 191, .25);
            border-radius: 50%;
            animation: monitoringMarkerPulse 2.2s infinite;
        }

        .pm-monitor-vehicle-marker-core {
            position: relative;
            z-index: 2;
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border: 2px solid #d1fae5;
            border-radius: 50%;
            background: #059669;
            color: #ecfdf5;
            box-shadow:
                0 5px 18px rgba(0, 0, 0, .4),
                0 0 18px rgba(16, 185, 129, .3);
            font-size: 13px;
        }

        .pm-monitor-vehicle-marker.idle .pm-monitor-vehicle-marker-core {
            background: #d97706;
        }

        .pm-monitor-vehicle-marker.offline .pm-monitor-vehicle-marker-core {
            background: #e11d48;
        }

        .pm-monitor-vehicle-marker-label {
            position: absolute;
            z-index: 3;
            left: 42px;
            top: 4px;
            padding: 4px 7px;
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 7px;
            background: rgba(2, 21, 18, .9);
            color: var(--pm-text);
            font-size: 9px;
            font-weight: 800;
            white-space: nowrap;
            box-shadow: 0 6px 15px rgba(0, 0, 0, .2);
        }

        .monitoring-route-pulse {
            stroke-dasharray: 12 10;
            animation: monitoringRouteDash 3s linear infinite;
        }

        @@keyframes monitoringPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, .45);
            }
            70% {
                box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        @@keyframes monitoringMarkerPulse {
            0%,
            100% {
                transform: scale(.9);
                opacity: .2;
            }
            50% {
                transform: scale(1.35);
                opacity: .8;
            }
        }

        @@keyframes monitoringCardIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes monitoringRowIn {
            from {
                opacity: 0;
                transform: translateX(8px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes monitoringAlertIn {
            from {
                opacity: 0;
                transform: translateX(12px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes monitoringSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes monitoringRouteDash {
            to {
                stroke-dashoffset: -44;
            }
        }

        @@media (max-width: 1250px) {
            .monitoring-kpis {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .monitoring-main {
                grid-template-columns: minmax(0, 1fr) 320px;
            }
        }

