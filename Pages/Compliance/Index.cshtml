    function showToast(title, message) {
        toastTitle.textContent = title;
        toastMessage.textContent = message;

        toast.classList.add("show");

        clearTimeout(toastTimer);

        toastTimer = setTimeout(function () {
            toast.classList.remove("show");
        }, 3200);
    }

    function updateVehicle() {
        const id = vehicleSelect.value;
        const data = vehicleData[id];

        if (!data) {
            return;
        }

        document.getElementById("vehicleRegistration").textContent = data.registration;
        document.getElementById("vehicleVin").textContent = data.vin;
        document.getElementById("vehicleDriver").textContent = data.driver;
        document.getElementById("vehicleLastCheck").textContent = data.lastCheck;
        document.getElementById("vehicleMeta").textContent = data.meta;

        const vehicleStatus = document.getElementById("vehicleStatus");

        vehicleStatus.textContent = data.status;
        vehicleStatus.className = "vehicle-status-chip " + data.statusClass;

        document.getElementById("complianceScore").textContent = data.score + "%";
        document.getElementById("healthGood").textContent = data.valid + " važećih";
        document.getElementById("healthWarning").textContent = data.warning + " uskoro ističe";
        document.getElementById("healthDanger").textContent = data.expired + " isteklih";

        document.getElementById("statDocuments").textContent = data.documents;
        document.getElementById("statAlerts").textContent = data.alerts;
        document.getElementById("statService").textContent = data.service;
        document.getElementById("statFaults").textContent = data.faults;
        document.getElementById("documentsCount").textContent = data.documents;
        document.getElementById("sideAlertCount").textContent = data.alerts;

        const healthTitle = document.getElementById("healthTitle");
        const healthDescription = document.getElementById("healthDescription");

        if (data.expired > 0) {
            healthTitle.textContent = "Potrebna je intervencija";
            healthDescription.textContent =
                "Za vozilo postoje dokumenti kojima je istekao rok ili zahtevaju hitno ažuriranje.";
        } else if (data.warning > 0) {
            healthTitle.textContent = "Dokumentacija je uglavnom uredna";
            healthDescription.textContent =
                "Postoje dokumenti kojima se približava rok kontrole ili isteka.";
        } else {
            healthTitle.textContent = "Dokumentacija je uredna";
            healthDescription.textContent =
                "Za izabrano vozilo trenutno nema otvorenih compliance problema.";
        }

        const circumference = 2 * Math.PI * 48;
        const offset = circumference - (data.score / 100) * circumference;
        const ring = document.getElementById("healthRing");

        ring.style.strokeDasharray = circumference;
        ring.style.strokeDashoffset = offset;
    }

    function openModal(mode, documentId) {
        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");

        if (mode === "edit" && documentId) {
            document.getElementById("modalKicker").textContent = "DOCUMENT · EDIT";
            document.getElementById("modalTitle").textContent = "Izmena dokumenta";
            document.getElementById("documentId").value = documentId;

            const card = document.querySelector(
                '.document-card[data-document-id="' + documentId + '"]'
            );

            if (card) {
                const title = card.querySelector("h3");

                if (title) {
                    document.getElementById("documentType").value = title.textContent.trim();
                }
            }
        } else {
            document.getElementById("modalKicker").textContent = "DOCUMENT · NEW";
            document.getElementById("modalTitle").textContent = "Novi dokument";
            document.getElementById("documentId").value = "";

            form.reset();
            selectedFile.textContent = "";
        }
    }

    function closeModal() {
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");
    }

    function filterDocuments() {
        const query = searchInput.value.trim().toLowerCase();
        const status = statusFilter.value;
        const category = categoryFilter.value;

        const cards = document.querySelectorAll(".document-card");

        cards.forEach(function (card) {
            const cardSearch = (card.dataset.search || "").toLowerCase();
            const cardStatus = card.dataset.status || "";
            const cardCategory = card.dataset.category || "";

            const matchesQuery =
                !query || cardSearch.includes(query);

            const matchesStatus =
                status === "all" || cardStatus === status;

            const matchesCategory =
                category === "all" || cardCategory === category;

            card.style.display =
                matchesQuery && matchesStatus && matchesCategory
                    ? ""
                    : "none";
        });
    }

    document.querySelectorAll(".compliance-tab").forEach(function (tab) {
