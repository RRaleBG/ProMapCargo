@page
@{
    ViewData["Title"] = "Compliance · ProMap Cargo";
}

<div class="pm-page pm-compliance-page" data-module="compliance">

    <header class="compliance-header">
        <div class="compliance-heading">
            <div class="compliance-kicker">FLEET CONTROL · DOCUMENTS · MAINTENANCE</div>
            <h1>Vehicle Compliance</h1>
            <p>
                Centralni pregled dokumentacije, rokova, tehničke ispravnosti,
                servisa, popravki i upozorenja za svako vozilo.
            </p>
        </div>

        <div class="compliance-header-actions">
            <button type="button" class="compliance-btn secondary" id="refreshCompliance">
                <span>↻</span>
                Osveži
            </button>

            <button type="button" class="compliance-btn primary" id="addDocumentBtn">
                <span>＋</span>
                Novi dokument
            </button>
        </div>
    </header>

    <section class="fleet-selector-card">

        <div class="fleet-selector-main">

            <div class="fleet-selector-icon">
                🚛
            </div>

            <div class="fleet-selector-info">
                <span class="fleet-selector-label">Izabrano vozilo</span>

                <div class="fleet-selector-row">
                    <select id="vehicleSelect" class="compliance-select vehicle-select">
                        <option value="BG-TR-001">BG-TR-001 · Mercedes-Benz Actros 1853</option>
                        <option value="BG-TR-002">BG-TR-002 · Volvo FH 500</option>
                        <option value="BG-TR-003">BG-TR-003 · Scania R 450</option>
                        <option value="BG-TR-004">BG-TR-004 · MAN TGX 18.510</option>
                        <option value="BG-TR-005">BG-TR-005 · DAF XF 480</option>
                        <option value="BG-TR-006">BG-TR-006 · Mercedes-Benz Actros 1848</option>
                        <option value="BG-TR-007">BG-TR-007 · Volvo FH 460</option>
                        <option value="BG-TR-008">BG-TR-008 · Scania R 500</option>
                    </select>

                    <span class="vehicle-status-chip good" id="vehicleStatus">
                        COMPLIANT
                    </span>
                </div>

                <div class="fleet-selector-meta" id="vehicleMeta">
                    BG · N3 · 40t · Euro 6 · 5 osovina · međunarodni transport
                </div>
            </div>

        </div>

        <div class="vehicle-quick-info">
            <div>
                <span>Reg. oznaka</span>
                <strong id="vehicleRegistration">BG-TR-001</strong>
            </div>

            <div>
                <span>VIN</span>
                <strong id="vehicleVin">WDB9634031L123456</strong>
            </div>

            <div>
                <span>Vozač</span>
                <strong id="vehicleDriver">Marko Petrović</strong>
            </div>

            <div>
                <span>Poslednja kontrola</span>
                <strong id="vehicleLastCheck">12.09.2026.</strong>
            </div>
        </div>

    </section>

    <section class="compliance-health">

        <div class="health-main">

            <div class="health-ring">
                <svg viewBox="0 0 120 120">
                    <circle class="health-ring-bg" cx="60" cy="60" r="48"></circle>
                    <circle class="health-ring-progress" id="healthRing" cx="60" cy="60" r="48"></circle>
                </svg>

                <div class="health-ring-value">
                    <strong id="complianceScore">91%</strong>
                    <span>compliance</span>
                </div>
            </div>

            <div class="health-copy">
                <span class="health-label">STATUS VOZILA</span>
                <h2 id="healthTitle">Dokumentacija je uglavnom uredna</h2>
                <p id="healthDescription">
                    Vozilo može da bude u operativnom statusu. Postoje dokumenti
                    kojima se približava rok kontrole ili isteka.
                </p>

                <div class="health-badges">
                    <span class="health-badge good" id="healthGood">12 važećih</span>
                    <span class="health-badge warning" id="healthWarning">2 uskoro ističu</span>
                    <span class="health-badge danger" id="healthDanger">0 isteklih</span>
                </div>
            </div>

        </div>

        <div class="health-stats">

            <div class="health-stat">
                <span class="health-stat-label">Dokumenti</span>
                <strong id="statDocuments">14</strong>
                <small>evidentirano</small>
            </div>

            <div class="health-stat">
                <span class="health-stat-label">Alerti</span>
                <strong id="statAlerts">2</strong>
                <small>otvorena</small>
            </div>

            <div class="health-stat">
                <span class="health-stat-label">Servis</span>
                <strong id="statService">8.420 km</strong>
                <small>do sledećeg</small>
            </div>

            <div class="health-stat">
                <span class="health-stat-label">Greške</span>
                <strong id="statFaults">1</strong>
                <small>otvorena</small>
            </div>

        </div>

    </section>

    <section class="compliance-toolbar">

        <div class="compliance-tabs" role="tablist">

            <button class="compliance-tab active" data-tab="documents">
                Dokumenti
                <span id="documentsCount">14</span>
            </button>

            <button class="compliance-tab" data-tab="maintenance">
                Održavanje
                <span>3</span>
            </button>

            <button class="compliance-tab" data-tab="repairs">
                Popravke
                <span>4</span>
            </button>

            <button class="compliance-tab" data-tab="faults">
                Greške
                <span>1</span>
            </button>

            <button class="compliance-tab" data-tab="notes">
                Napomene
                <span>5</span>
            </button>

            <button class="compliance-tab" data-tab="history">
                Istorija
            </button>

        </div>

        <div class="compliance-filters">

            <div class="search-box">
                <span>⌕</span>
                <input
                    type="search"
                    id="documentSearch"
                    placeholder="Pretraži dokumente..."
                    autocomplete="off">
            </div>

            <select id="statusFilter" class="compliance-select">
                <option value="all">Svi statusi</option>
                <option value="valid">Važeći</option>
                <option value="warning">Uskoro ističe</option>
                <option value="expired">Istekao</option>
                <option value="missing">Nedostaje</option>
                <option value="not-applicable">Nije primenljivo</option>
            </select>

            <select id="categoryFilter" class="compliance-select">
                <option value="all">Sve kategorije</option>
                <option value="vehicle">Vozilo</option>
                <option value="transport">Transport</option>
                <option value="safety">Bezbednost</option>
                <option value="maintenance">Održavanje</option>
            </select>

        </div>

    </section>

