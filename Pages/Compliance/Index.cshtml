        }

        .vehicle-list {
            max-height: 520px;
        }

    }


    @@media (max-width: 850px) {

        .pm-compliance-page {
            padding: 22px 17px 40px;
        }

        .compliance-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .compliance-header-actions {
            width: 100%;
        }

        .compliance-header-actions .compliance-btn {
            flex: 1;
        }

        .compliance-kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .compliance-critical-banner {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .critical-banner-action {
            margin-left: 50px;
        }

        .combination-card {
            grid-template-columns: 1fr;
        }

        .combination-connector {
            transform: rotate(90deg);
            justify-self: center;
        }

        .trailer-compliance-grid,
        .service-summary-grid {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 620px) {

        .compliance-kpi-grid {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .compliance-kpi {
            min-height: 105px;
            padding: 12px;
        }

        .compliance-kpi-value {
            font-size: 25px;
        }

        .compliance-filter-group {
            width: 100%;
            overflow-x: auto;
        }

        .compliance-select {
            width: 100%;
        }

        .detail-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .detail-header-status {
            align-self: flex-start;
        }

        .compliance-lock {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .lock-action {
            width: 100%;
            margin-left: 50px;
        }

        .detail-tab-content {
            padding: 15px;
        }

        .detail-section-header {
            flex-direction: column;
        }

        .detail-section-header .compliance-btn {
            width: 100%;
        }

        .document-row {
            align-items: flex-start;
        }

        .document-actions {
            flex-direction: column;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-field-full {
            grid-column: auto;
        }

        .vehicle-card-details {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 10px;
        }

        .compliance-modal {
            padding: 10px;
        }

        .compliance-modal-dialog {
            max-height: calc(100vh - 20px);
        }

    }


    @@media (prefers-reduced-motion: reduce) {

        .compliance-critical-banner,
        .detail-tab-content,
        .compliance-modal-dialog {
            animation: none !important;
        }

        .compliance-btn,
        .vehicle-card,
        .document-row,
        .compliance-toast {
            transition: none !important;
        }

    }

</style>


<script>

(function () {

    "use strict";


    const root = document.querySelector('[data-module="compliance"]');

    if (!root) {
        return;
    }


    const state = {
        activeStatus: "all",
        activeTab: "documents",
        selectedVehicle: "truck-001"
    };


    const vehicleCards = Array.from(
        root.querySelectorAll(".vehicle-card")
    );


    const filterButtons = Array.from(
        root.querySelectorAll("[data-status-filter]")
    );


    const searchInput = document.getElementById("vehicleSearch");

    const vehicleTypeFilter =
        document.getElementById("vehicleTypeFilter");

    const visibleVehicleCount =
        document.getElementById("visibleVehicleCount");


    const modal =
        document.getElementById("documentModal");

    const documentForm =
        document.getElementById("documentForm");


    const toast =
        document.getElementById("complianceToast");


    const toastTitle =
        document.getElementById("toastTitle");


    const toastText =
        document.getElementById("toastText");


    function showToast(title, message) {

        toastTitle.textContent = title || "Sačuvano";

        toastText.textContent =
            message || "Promena je uspešno evidentirana.";

        toast.classList.add("show");

        window.clearTimeout(
            showToast.timeout
        );

        showToast.timeout =
            window.setTimeout(function () {

                toast.classList.remove("show");

            }, 3200);
    }


    function openModal(documentType) {

        modal.classList.add("open");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        const title =
            document.getElementById("documentModalTitle");

        const select =
            document.getElementById("documentType");


        if (documentType) {

            select.value = documentType;

            title.textContent =
                "Ažuriranje dokumenta";

        } else {

            select.value = "";

            title.textContent =
                "Novi dokument";
        }


        document.body.classList.add(
            "pm-modal-open"
        );

        window.setTimeout(function () {

            select.focus();

        }, 50);
    }


    function closeModal() {

        modal.classList.remove("open");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.classList.remove(
            "pm-modal-open"
        );
    }


    document.querySelectorAll("[data-close-modal]")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                closeModal
            );

        });


    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("open")
            ) {
                closeModal();
            }

        }
    );


    function applyFilters() {

        const query =
            searchInput.value
                .trim()
                .toLowerCase();

        const type =
            vehicleTypeFilter.value;

        let visible = 0;


        vehicleCards.forEach(function (card) {

            const status =
                card.dataset.status || "all";

            const cardType =
                card.dataset.type || "truck";

            const searchable =
                card.dataset.search || "";

            const matchesStatus =
                state.activeStatus === "all" ||
                status === state.activeStatus;

            const matchesType =
                type === "all" ||
                cardType === type;

            const matchesSearch =
                !query ||
                searchable
                    .toLowerCase()
                    .includes(query);


            const visibleCard =
                matchesStatus &&
                matchesType &&
                matchesSearch;


            card.style.display =
                visibleCard
                    ? ""
                    : "none";


            if (visibleCard) {
                visible++;
            }

        });


        visibleVehicleCount.textContent =
            visible +
            (visible === 1
                ? " vozilo"
                : " vozila");
    }


    filterButtons.forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                state.activeStatus =
                    button.dataset.statusFilter;

                filterButtons.forEach(
                    function (item) {

                        item.classList.toggle(
                            "active",
                            item === button
                        );

                    }
                );

                applyFilters();

            }
        );

    });


    searchInput.addEventListener(
        "input",
        applyFilters
    );


    vehicleTypeFilter.addEventListener(
        "change",
        applyFilters
    );


    function selectVehicle(card) {

        vehicleCards.forEach(
            function (item) {

                item.classList.toggle(
                    "selected",
                    item === card
                );

            }
        );


        state.selectedVehicle =
            card.dataset.vehicleId;


        const title =
            card.querySelector(
                ".vehicle-identity strong"
            );

        const subtitle =
            card.querySelector(
                ".vehicle-identity span"
            );


        if (title) {

            document.getElementById(
                "detailVehicleTitle"
            ).textContent =
                title.textContent;

        }


        if (subtitle) {

            document.getElementById(
                "detailVehicleSubtitle"
            ).textContent =
                subtitle.textContent +
                " · VIN WDB123456789";

        }


        const isBlocked =
            card.dataset.status === "blocked";


        const lock =
            document.getElementById(
                "complianceLock"
            );


        if (lock) {

            lock.style.display =
                isBlocked
                    ? "flex"
                    : "none";

        }


        const detailStatus =
            document.getElementById(
                "detailStatus"
            );


        if (detailStatus) {

            detailStatus.innerHTML =
                isBlocked
                    ? '<span class="status-badge status-danger">BLOCKED</span>'
                    : card.dataset.status === "expiring"
                        ? '<span class="status-badge status-warning">EXPIRING</span>'
                        : '<span class="status-badge status-success">COMPLIANT</span>';

        }

    }


    vehicleCards.forEach(function (card) {

        card.addEventListener(
            "click",
            function () {

                selectVehicle(card);

            }
        );

    });


    const tabs =
        Array.from(
            root.querySelectorAll(".detail-tab")
        );


    const tabContents =
        Array.from(
            root.querySelectorAll(".detail-tab-content")
        );


    tabs.forEach(function (tab) {

        tab.addEventListener(
            "click",
            function () {

                const target =
                    tab.dataset.tab;


                state.activeTab =
                    target;


                tabs.forEach(
                    function (item) {

                        item.classList.toggle(
                            "active",
                            item === tab
                        );

                    }
                );


                tabContents.forEach(
                    function (content) {

                        content.classList.toggle(
                            "active",
                            content.dataset.content === target
                        );

                    }
                );

            }
        );

    });


    document
        .getElementById("addDocument")
        .addEventListener(
            "click",
            function () {

                openModal();

            }
        );


    document
        .getElementById("addDocumentTop")
        .addEventListener(
            "click",
            function () {

                openModal();

            }
        );


    document
        .getElementById("repairCompliance")
        .addEventListener(
            "click",
            function () {

                openModal("tir");

            }
        );


    document
        .querySelectorAll(".document-fix-button")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    openModal(
                        button.dataset.document
                    );

                }
            );

        });


    document
        .querySelectorAll(".icon-action")
        .forEach(function (button) {

            button.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    const documentType =
                        button.dataset.document;

                    if (documentType) {

                        openModal(
                            documentType
                        );

                    } else {

                        showToast(
                            "UI akcija",
                            "Editor je spreman za povezivanje sa backend modelom."
                        );

                    }

                }
            );

        });


    document
        .getElementById("changeTrailer")
        .addEventListener(
            "click",
            function () {

                showToast(
                    "Veza vozilo → prikolica",
                    "Editor prikolice je spreman za povezivanje sa modelom."
                );

            }
        );


    document
        .getElementById("addService")
        .addEventListener(
            "click",
            function () {

                showToast(
                    "Novi servis",
                    "Servisni editor je spreman za backend integraciju."
                );

            }
        );


    document
        .getElementById("addNote")
        .addEventListener(
            "click",
            function () {

                showToast(
                    "Nova napomena",
                    "Editor napomene je spreman za backend integraciju."
                );

            }
        );


    document
        .getElementById("showBlockedVehicles")
        .addEventListener(
            "click",
            function () {

                const blockedButton =
                    root.querySelector(
                        '[data-status-filter="blocked"]'
                    );

                if (blockedButton) {
                    blockedButton.click();
                }

                showToast(
                    "Compliance filter",
                    "Prikazana su samo blokirana vozila."
                );

            }
        );


    document
        .getElementById("refreshCompliance")
        .addEventListener(
            "click",
            function () {

                const button =
                    document.getElementById(
                        "refreshCompliance"
                    );

                const original =
                    button.innerHTML;

                button.innerHTML =
                    "<span>↻</span> Osvežavanje...";

                button.disabled = true;


                window.setTimeout(
                    function () {

                        button.innerHTML =
                            original;

                        button.disabled = false;

                        showToast(
                            "Compliance osvežen",
                            "Status dokumentacije je osvežen."
                        );

                    },
                    700
                );

            }
        );


    documentForm.addEventListener(
        "submit",
        function (event) {

            event.preventDefault();


            const expiry =
                document.getElementById(
                    "documentExpiryDate"
                ).value;


            if (!expiry) {

                showToast(
                    "Nedostaje datum",
                    "Unesite datum važenja dokumenta."
                );

                return;
            }


            closeModal();


            showToast(
                "Dokument sačuvan",
                "Novi važeći dokument je evidentiran u UI prototipu."
            );

        }
    );


    const fileInput =
        document.getElementById(
            "documentFile"
        );


    fileInput.addEventListener(
        "change",
        function () {

            const file =
                fileInput.files &&
                fileInput.files[0];


            if (!file) {
                return;
            }


            const content =
                document.querySelector(
                    ".file-upload-content"
                );


            if (content) {

                content.innerHTML =
                    "<strong>" +
                    file.name +
                    "</strong>" +
                    "<span>" +
                    Math.round(file.size / 1024) +
                    " KB · spremno za upload</span>";

            }

        }
    );


    selectVehicle(
        document.querySelector(
            '[data-vehicle-id="truck-001"]'
        )
    );


    applyFilters();


})();

</script>