        background: #38bdf8;
    }

    .audit-timeline strong,
    .audit-timeline span,
    .audit-timeline small {
        display: block;
    }

    .audit-timeline strong {
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .audit-timeline span {
        margin-top: 4px;
