    .compliance-modal {
        position: fixed;
        inset: 0;
        z-index: 5000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .compliance-modal.open {
        display: flex;
    }

    .compliance-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 8, 6, .78);
        backdrop-filter: blur(8px);
    }

    .compliance-modal-dialog {
        position: relative;
        z-index: 1;
        width: min(650px, 100%);
        max-height: calc(100vh - 40px);
        overflow: auto;
        border: 1px solid var(--pm-border-strong);
        border-radius: 17px;
        background:
            linear-gradient(145deg, rgba(5, 39, 32, .98), rgba(2, 21, 18, .99));
        box-shadow: 0 30px 90px rgba(0, 0, 0, .48);
        animation: modalIn .2s ease;
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .compliance-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
