                item.classList.remove("active");
            });

            document.querySelectorAll(".compliance-tab-panel").forEach(function (panel) {
                panel.classList.remove("active");
            });

            tab.classList.add("active");

            const panel = document.querySelector(
                '.compliance-tab-panel[data-panel="' + target + '"]'
            );

            if (panel) {
                panel.classList.add("active");
            }
        });
    });

    vehicleSelect.addEventListener("change", function () {
        updateVehicle();

        showToast(
            "Vozilo promenjeno",
            "Prikazana je compliance evidencija za " + vehicleSelect.value + "."
        );
    });

    searchInput.addEventListener("input", filterDocuments);
    statusFilter.addEventListener("change", filterDocuments);
    categoryFilter.addEventListener("change", filterDocuments);

    document.getElementById("addDocumentBtn").addEventListener("click", function () {
        openModal("new");
    });

    document.getElementById("uploadDocumentBtn").addEventListener("click", function () {
        openModal("new");
    });

    document.querySelectorAll(".edit-document").forEach(function (button) {
        button.addEventListener("click", function () {
            openModal("edit", button.dataset.id);
        });
    });

    document.querySelectorAll(".view-document").forEach(function (button) {
        button.addEventListener("click", function () {
            const card = document.querySelector(
                '.document-card[data-document-id="' + button.dataset.id + '"]'
            );

            const title = card
                ? card.querySelector("h3")
                : null;

            showToast(
                "Uvid u dokument",
                title
                    ? title.textContent.trim()
                    : "Dokument je otvoren."
            );
        });
    });

    document.querySelectorAll(".file-document").forEach(function (button) {
        button.addEventListener("click", function () {
            showToast(
                "Dokument",
                "UI je spreman za povezivanje sa skladištem dokumenata."
            );
        });
    });

    document.querySelectorAll("[data-close-modal]").forEach(function (element) {
        element.addEventListener("click", closeModal);
    });

    document.getElementById("chooseFile").addEventListener("click", function () {
        fileInput.click();
    });

    fileInput.addEventListener("change", function () {
        if (!fileInput.files.length) {
            selectedFile.textContent = "";
            return;
        }

        selectedFile.textContent =
            "Izabran fajl: " + fileInput.files[0].name;
    });

    document.getElementById("documentForm").addEventListener("submit", function (event) {
        event.preventDefault();

        const type = document.getElementById("documentType").value;

        if (!type) {
            showToast(
                "Nedostaje podatak",
                "Izaberi vrstu dokumenta."
            );

            return;
        }

        closeModal();

        showToast(
            "Dokument sačuvan",
            type + " je uspešno evidentiran za " + vehicleSelect.value + "."
        );
    });

    document.getElementById("refreshCompliance").addEventListener("click", function () {
        updateVehicle();

        showToast(
            "Compliance osvežen",
            "Podaci za " + vehicleSelect.value + " su osveženi."
        );
    });

    document.getElementById("showAllAlerts").addEventListener("click", function () {
        showToast(
            "Alert centar",
            "Ovde će biti prikazani svi aktivni compliance alerti."
        );
    });

    document.querySelectorAll(".quick-action").forEach(function (button) {
        button.addEventListener("click", function () {
            const action = button.dataset.action;

            if (action === "add") {
                openModal("new");
                return;
            }

            if (action === "service") {
                document.querySelector('[data-tab="maintenance"]').click();
                showToast(
                    "Održavanje",
                    "Otvoren je modul za servisnu evidenciju."
                );
                return;
            }

            if (action === "repair") {
                document.querySelector('[data-tab="repairs"]').click();
                showToast(
                    "Popravke",
                    "Otvoren je modul za popravke."
                );
                return;
            }

            if (action === "fault") {
                document.querySelector('[data-tab="faults"]').click();
                showToast(
                    "Greške",
                    "Otvoren je modul za greške vozila."
                );
                return;
            }

            if (action === "note") {
                document.querySelector('[data-tab="notes"]').click();
                showToast(
                    "Napomene",
                    "Otvoren je modul za napomene."
                );
            }
        });
    });

    document.getElementById("addMaintenanceBtn").addEventListener("click", function () {
        showToast(
            "Novi servis",
            "Forma za unos servisa je spremna za povezivanje sa modelom."
        );
    });

    document.getElementById("addRepairBtn").addEventListener("click", function () {
        showToast(
            "Nova popravka",
            "Forma za unos popravke je spremna za povezivanje sa modelom."
        );
    });

    document.getElementById("addFaultBtn").addEventListener("click", function () {
        showToast(
            "Nova greška",
            "Forma za prijavu greške je spremna za povezivanje sa modelom."
        );
    });

    document.getElementById("addNoteBtn").addEventListener("click", function () {
        showToast(
            "Nova napomena",
            "Forma za unos napomene je spremna za povezivanje sa modelom."
        );
    });

    updateVehicle();

})();
</script>