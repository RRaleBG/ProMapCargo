        font-size: 10px;
    }

    .compliance-filter:hover,
    .compliance-filter.active {
        background: rgba(16, 185, 129, .08);
        border-color: rgba(45, 212, 191, .15);
        color: var(--pm-text-soft);
    }

    .compliance-filter[data-status-filter="blocked"].active {
        background: rgba(244, 63, 94, .1);
        border-color: rgba(251, 113, 133, .2);
        color: #fecdd3;
    }

    .compliance-select {
        height: 40px;
        min-width: 145px;
        padding: 0 10px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 10px;
        background: rgba(0, 0, 0, .16);
        color: var(--pm-text-soft);
        outline: none;
        font-size: 12px;
    }

    .compliance-workspace {
        display: grid;
        grid-template-columns: minmax(340px, 410px) minmax(0, 1fr);
        gap: 15px;
        align-items: start;
    }

    .vehicle-list-panel,
    .vehicle-detail-panel {
        border: 1px solid var(--pm-border);
        border-radius: 17px;
        background:
            linear-gradient(145deg, rgba(5, 39, 32, .84), rgba(2, 21, 18, .9));
        box-shadow: var(--pm-shadow-sm);
    }

    .vehicle-list-panel {
        overflow: hidden;
    }

    .panel-heading {
        min-height: 74px;
        padding: 15px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--pm-border-soft);
    }

    .panel-kicker,
    .detail-kicker,
    .detail-section-kicker,
    .modal-kicker {
        color: var(--pm-text-dim);
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .panel-heading h2 {
        margin: 3px 0 0;
        color: var(--pm-text);
        font-size: 18px;
    }

    .vehicle-count {
        color: var(--pm-text-dim);
        font-size: 11px;
    }

    .vehicle-list {
        max-height: calc(100vh - 310px);
        overflow: auto;
    }

    .vehicle-card {
        position: relative;
        padding: 15px;
        border-bottom: 1px solid var(--pm-border-soft);
        cursor: pointer;
        transition: .18s ease;
    }

    .vehicle-card:last-child {
        border-bottom: 0;
    }

    .vehicle-card:hover {
        background: rgba(16, 185, 129, .035);
    }

    .vehicle-card.selected {
        background:
            linear-gradient(90deg, rgba(16, 185, 129, .1), rgba(16, 185, 129, .025));
        box-shadow: inset 3px 0 0 var(--pm-emerald-500);
    }

    .vehicle-card.vehicle-card-blocked {
        box-shadow: inset 3px 0 0 rgba(251, 113, 133, .72);
    }

    .vehicle-card.selected.vehicle-card-blocked {
        box-shadow: inset 3px 0 0 #fb7185;
    }

    .vehicle-card-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .vehicle-identity {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .vehicle-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: rgba(16, 185, 129, .08);
        border: 1px solid rgba(52, 211, 153, .14);
        font-size: 19px;
    }

    .vehicle-identity strong {
        display: block;
        color: var(--pm-text);
        font-size: 14px;
    }

    .vehicle-identity span {
        display: block;
        margin-top: 3px;
        color: var(--pm-text-dim);
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .06em;
        white-space: nowrap;
    }

    .status-success {
        background: rgba(16, 185, 129, .1);
        color: #6ee7b7;
        border: 1px solid rgba(52, 211, 153, .16);
    }

    .status-warning {
        background: rgba(245, 158, 11, .1);
        color: #fbbf24;
        border: 1px solid rgba(251, 191, 36, .16);
    }

    .status-danger {
        background: rgba(244, 63, 94, .11);
        color: #fb7185;
        border: 1px solid rgba(251, 113, 133, .18);
    }

    .vehicle-card-details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-top: 14px;
    }

    .vehicle-card-details > div {
        min-width: 0;
    }

    .vehicle-card-details span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 9px;
        margin-bottom: 4px;
    }

    .vehicle-card-details strong {
        display: block;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-good-text {
        color: #6ee7b7;
    }

    .status-warning-text {
        color: #fbbf24;
    }

    .status-danger-text {
        color: #fb7185;
    }

    .vehicle-trailer-line {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 13px;
        padding-top: 10px;
        border-top: 1px solid var(--pm-border-soft);
        font-size: 10px;
    }

    .vehicle-trailer-line span {
        color: var(--pm-text-dim);
    }

    .vehicle-trailer-line strong {
        color: var(--pm-text-muted);
        font-weight: 700;
    }

    .vehicle-card-alert,
    .vehicle-card-warning {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        padding: 7px 8px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 700;
    }

    .vehicle-card-alert {
        background: rgba(244, 63, 94, .08);
        color: #fda4af;
        border: 1px solid rgba(244, 63, 94, .12);
    }

    .vehicle-card-warning {
        background: rgba(245, 158, 11, .07);
        color: #fcd34d;
        border: 1px solid rgba(245, 158, 11, .12);
    }

    .vehicle-detail-panel {
        min-width: 0;
        overflow: hidden;
    }

    .detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 20px;
        border-bottom: 1px solid var(--pm-border-soft);
    }

    .detail-vehicle {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .detail-vehicle-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: rgba(16, 185, 129, .09);
        border: 1px solid rgba(52, 211, 153, .15);
        font-size: 25px;
    }

    .detail-vehicle h2 {
        margin: 4px 0 3px;
        color: var(--pm-text);
        font-size: 24px;
        letter-spacing: -.025em;
    }

    .detail-vehicle p {
        margin: 0;
        color: var(--pm-text-muted);
        font-size: 11px;
    }

    .compliance-lock {
        display: flex;
        align-items: center;
        gap: 13px;
        margin: 15px;
        padding: 13px;
        border-radius: 13px;
        border: 1px solid rgba(251, 113, 133, .34);
        background:
            linear-gradient(90deg, rgba(127, 29, 29, .25), rgba(244, 63, 94, .055)),
            rgba(45, 8, 13, .55);
    }

    .lock-icon {
        width: 37px;
        height: 37px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: rgba(244, 63, 94, .13);
        color: #fb7185;
        border: 1px solid rgba(251, 113, 133, .24);
        font-weight: 900;
    }

    .lock-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .lock-content strong {
        color: #ffe4e6;
        font-size: 12px;
        letter-spacing: .04em;
    }

    .lock-content span {
        color: #fda4af;
        font-size: 11px;
    }

    .lock-content small {
        color: #fb7185;
        font-size: 10px;
        margin-top: 2px;
    }

    .lock-action {
        margin-left: auto;
        flex-shrink: 0;
        min-height: 38px;
        padding: 0 12px;
        border: 1px solid rgba(251, 113, 133, .28);
        border-radius: 9px;
        background: rgba(244, 63, 94, .12);
        color: #ffe4e6;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .lock-action:hover {
        background: rgba(244, 63, 94, .19);
    }

    .detail-tabs {
        display: flex;
        gap: 3px;
        overflow-x: auto;
        padding: 0 15px;
        border-bottom: 1px solid var(--pm-border-soft);
    }

    .detail-tab {
        position: relative;
        height: 45px;
        padding: 0 10px;
        border: 0;
        background: transparent;
        color: var(--pm-text-dim);
        font-size: 10px;
        font-weight: 750;
        cursor: pointer;
        white-space: nowrap;
    }

    .detail-tab span {
        margin-left: 3px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .detail-tab::after {
        content: "";
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: -1px;
        height: 2px;
        border-radius: 999px;
        background: transparent;
    }

    .detail-tab:hover {
        color: var(--pm-text-soft);
    }

    .detail-tab.active {
        color: var(--pm-emerald-300);
    }

    .detail-tab.active::after {
        background: var(--pm-emerald-500);
        box-shadow: 0 0 10px rgba(16, 185, 129, .35);
    }

    .detail-tab-content {
        display: none;
        padding: 20px;
    }

    .detail-tab-content.active {
        display: block;
        animation: tabIn .18s ease;
    }

    @@keyframes tabIn {
        from {
            opacity: 0;
            transform: translateY(3px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .detail-section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 15px;
    }

    .detail-section-header h3 {
        margin: 4px 0 4px;
        color: var(--pm-text);
        font-size: 17px;
    }

    .detail-section-header p {
        margin: 0;
        color: var(--pm-text-dim);
        font-size: 11px;
    }

    .document-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .document-row {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 68px;
        padding: 10px 12px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 11px;
        background: rgba(0, 0, 0, .11);
        transition: .18s ease;
    }

    .document-row:hover {
        background: rgba(16, 185, 129, .035);
        border-color: var(--pm-border);
    }

    .document-expired {
        border-color: rgba(251, 113, 133, .28);
        background:
            linear-gradient(90deg, rgba(244, 63, 94, .075), rgba(244, 63, 94, .025)),
            rgba(0, 0, 0, .12);
    }

    .document-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .02em;
    }

    .document-icon-green {
        background: rgba(16, 185, 129, .1);
        color: #6ee7b7;
    }

    .document-icon-red {
        background: rgba(244, 63, 94, .12);
        color: #fb7185;
    }

    .document-icon-blue {
        background: rgba(56, 189, 248, .1);
        color: #7dd3fc;
    }

    .document-icon-cyan {
        background: rgba(34, 211, 238, .09);
        color: #67e8f9;
    }

    .document-icon-orange {
        background: rgba(245, 158, 11, .1);
        color: #fbbf24;
    }

    .document-icon-purple {
        background: rgba(168, 85, 247, .1);
        color: #c4b5fd;
    }

    .document-main {
        min-width: 0;
        flex: 1;
    }

    .document-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .document-title-row strong {
        color: var(--pm-text);
        font-size: 12px;
    }

    .document-status {
        height: 18px;
        padding: 0 6px;
        font-size: 8px;
    }

    .document-meta {
        display: block;
        margin-top: 4px;
        color: var(--pm-text-dim);
        font-size: 10px;
    }

    .document-expiry {
        display: block;
        margin-top: 4px;
        color: var(--pm-text-muted);
        font-size: 10px;
    }

    .document-expired-text {
        color: #fb7185;
    }

    .document-actions {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
    }

    .icon-action {
        width: 31px;
        height: 31px;
        display: grid;
        place-items: center;
        border: 1px solid var(--pm-border-soft);
        border-radius: 8px;
        background: rgba(255, 255, 255, .025);
        color: var(--pm-text-muted);
        cursor: pointer;
        transition: .16s ease;
    }

    .icon-action:hover {
        color: var(--pm-emerald-300);
        border-color: var(--pm-border-strong);
        background: rgba(16, 185, 129, .06);
    }

    .document-fix-button {
        min-height: 32px;
        padding: 0 10px;
        border: 1px solid rgba(251, 113, 133, .28);
        border-radius: 8px;
        background: rgba(244, 63, 94, .09);
        color: #fda4af;
        font-size: 9px;
        font-weight: 850;
        cursor: pointer;
    }

    .combination-card {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 18px;
        padding: 22px;
        border: 1px solid var(--pm-border);
        border-radius: 14px;
        background: rgba(0, 0, 0, .12);
    }

    .combination-vehicle {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .combination-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: rgba(16, 185, 129, .08);
        border: 1px solid rgba(52, 211, 153, .13);
        font-size: 23px;
    }

    .trailer-icon {
        background: rgba(56, 189, 248, .07);
        border-color: rgba(56, 189, 248, .13);
    }

    .combination-vehicle span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .12em;
    }

    .combination-vehicle strong {
        display: block;
        margin-top: 4px;
        color: var(--pm-text);
        font-size: 15px;
    }

    .combination-vehicle small {
        display: block;
        margin-top: 2px;
        color: var(--pm-text-muted);
        font-size: 10px;
    }

    .combination-connector {
        color: var(--pm-emerald-400);
        font-size: 25px;
    }

    .trailer-compliance-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
        margin-top: 11px;
    }

    .trailer-info-card {
        padding: 13px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 11px;
        background: rgba(0, 0, 0, .1);
    }

    .trailer-info-card span,
    .trailer-info-card small {
        display: block;
        color: var(--pm-text-dim);
        font-size: 10px;
    }

    .trailer-info-card strong {
        display: block;
        margin: 6px 0 2px;
        font-size: 13px;
    }

    .trailer-history {
        margin-top: 20px;
    }

    .subsection-heading h4 {
        margin: 0 0 11px;
        color: var(--pm-text-soft);
        font-size: 13px;
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .timeline-item {
        position: relative;
        display: flex;
        gap: 11px;
        padding: 0 0 17px 14px;
        border-left: 1px solid var(--pm-border);
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        width: 7px;
        height: 7px;
        left: -4px;
        top: 3px;
        border-radius: 50%;
        background: var(--pm-emerald-400);
        box-shadow: 0 0 10px rgba(52, 211, 153, .3);
    }

    .timeline-item strong,
    .timeline-item span {
        display: block;
    }

    .timeline-item strong {
        color: var(--pm-text-soft);
        font-size: 10px;
    }

    .timeline-item span {
        margin-top: 3px;
        color: var(--pm-text-dim);
        font-size: 10px;
    }

    .service-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
        margin-bottom: 14px;
    }

    .service-summary-grid article {
        padding: 14px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 11px;
        background: rgba(0, 0, 0, .1);
    }

    .service-summary-grid span,
    .service-summary-grid small {
        display: block;
        color: var(--pm-text-dim);
        font-size: 10px;
    }

    .service-summary-grid strong {
        display: block;
        margin: 6px 0 3px;
        color: var(--pm-text);
        font-size: 14px;
    }

    .service-list,
    .repair-list,
    .fault-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .service-row,
    .repair-row,
    .fault-row {
        display: flex;
        align-items: center;
        gap: 11px;
        min-height: 62px;
        padding: 10px 12px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 11px;
        background: rgba(0, 0, 0, .1);
    }

    .service-type {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 900;
    }

    .service-small {
        background: rgba(16, 185, 129, .1);
        color: #6ee7b7;
    }

    .service-large {
        background: rgba(56, 189, 248, .1);
        color: #7dd3fc;
    }

    .service-row > div:nth-child(2),
    .repair-main,
    .fault-main {
        min-width: 0;
        flex: 1;
    }

    .service-row strong,
    .repair-main strong,
    .fault-main strong {
        display: block;
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .service-row span,
    .repair-main span,
    .fault-main span {
        display: block;
        margin-top: 3px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .service-cost,
    .repair-cost {
        text-align: right;
        flex-shrink: 0;
    }

    .service-cost span,
    .repair-cost span {
        display: block;
        color: var(--pm-text-dim);
        font-size: 8px;
    }

    .service-cost strong,
    .repair-cost strong {
        display: block;
        margin-top: 3px;
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .repair-row {
        align-items: flex-start;
    }

    .repair-status-dot {
        width: 9px;
        height: 9px;
        margin-top: 5px;
        border-radius: 50%;
        background: var(--pm-emerald-400);
        box-shadow: 0 0 10px rgba(52, 211, 153, .25);
    }

    .repair-open .repair-status-dot {
        background: var(--pm-warning);
        box-shadow: 0 0 10px rgba(251, 191, 36, .25);
    }

    .repair-main small {
        display: block;
        margin-top: 5px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .fault-row {
        align-items: flex-start;
    }

    .fault-level {
        min-width: 67px;
        text-align: center;
        padding: 5px 6px;
        border-radius: 6px;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: .07em;
    }

    .fault-critical .fault-level {
        background: rgba(244, 63, 94, .11);
        color: #fb7185;
    }

    .fault-warning .fault-level {
        background: rgba(245, 158, 11, .11);
        color: #fbbf24;
    }

    .fault-resolved .fault-level {
        background: rgba(16, 185, 129, .1);
        color: #6ee7b7;
    }

    .fault-main small {
        display: block;
        margin-top: 5px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .fault-open-status,
    .fault-resolved-status {
        font-size: 8px;
        font-weight: 850;
    }

    .fault-open-status {
        color: #fb7185;
    }

    .fault-resolved-status {
        color: #6ee7b7;
    }

    .notes-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .note-card {
        padding: 14px;
        border: 1px solid var(--pm-border-soft);
        border-radius: 11px;
        background: rgba(0, 0, 0, .1);
    }

    .note-date {
        color: var(--pm-emerald-300);
        font-size: 9px;
        font-weight: 800;
    }

    .note-card strong {
        display: block;
        margin-top: 7px;
        color: var(--pm-text-soft);
        font-size: 11px;
        line-height: 1.45;
    }

    .note-card span {
        display: block;
        margin-top: 7px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .audit-timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .audit-timeline article {
        position: relative;
        display: flex;
        gap: 12px;
        padding: 0 0 20px 16px;
        border-left: 1px solid var(--pm-border);
    }

    .audit-timeline article:last-child {
        padding-bottom: 0;
    }

    .audit-dot {
        position: absolute;
        left: -5px;
        top: 2px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
    }

    .audit-green {
        background: var(--pm-emerald-400);
    }

