        color: var(--pm-text-muted);
        font-size: 22px;
        cursor: pointer;
    }

    .compliance-form {
        padding: 20px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-field-full {
        grid-column: 1 / -1;
    }

    .form-field > span {
        color: var(--pm-text-soft);
        font-size: 10px;
        font-weight: 750;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
        width: 100%;
        border: 1px solid var(--pm-border-soft);
        border-radius: 9px;
        outline: none;
        background: rgba(0, 0, 0, .18);
        color: var(--pm-text);
        font-family: inherit;
        font-size: 12px;
    }

    .form-field input,
    .form-field select {
        height: 40px;
        padding: 0 11px;
    }

    .form-field textarea {
        padding: 10px 11px;
        resize: vertical;
        min-height: 85px;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
        border-color: var(--pm-border-strong);
        box-shadow: 0 0 0 3px rgba(45, 212, 191, .06);
    }

    .form-field input::placeholder,
    .form-field textarea::placeholder {
        color: var(--pm-text-dim);
    }

    .file-upload {
        position: relative;
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed rgba(45, 212, 191, .28);
        border-radius: 11px;
        background: rgba(16, 185, 129, .025);
        overflow: hidden;
        cursor: pointer;
    }

    .file-upload input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .file-upload-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        pointer-events: none;
    }

    .file-upload-content strong {
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .file-upload-content span {
        color: var(--pm-text-dim);
        font-size: 9px;
    }

    .form-compliance-notice {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        padding: 11px;
        border-radius: 10px;
        background: rgba(56, 189, 248, .055);
        border: 1px solid rgba(56, 189, 248, .12);
    }

    .form-compliance-notice > span {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(56, 189, 248, .1);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 900;
    }

    .form-compliance-notice strong {
        color: #bae6fd;
        font-size: 10px;
    }

    .form-compliance-notice p {
        margin: 3px 0 0;
        color: #7dd3fc;
        font-size: 9px;
        line-height: 1.45;
    }

    .compliance-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid var(--pm-border-soft);
    }

    .compliance-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 6000;
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 270px;
        max-width: 380px;
        padding: 12px 14px;
        border: 1px solid rgba(52, 211, 153, .2);
        border-radius: 12px;
        background: rgba(3, 28, 24, .96);
        box-shadow: 0 20px 50px rgba(0, 0, 0, .35);
        opacity: 0;
        pointer-events: none;
        transform: translateY(10px);
        transition: .22s ease;
    }

    .compliance-toast.show {
        opacity: 1;
        transform: translateY(0);
    }

    .toast-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: rgba(16, 185, 129, .1);
        color: #6ee7b7;
        font-weight: 900;
    }

    .compliance-toast strong,
    .compliance-toast span {
        display: block;
    }

    .compliance-toast strong {
        color: var(--pm-text-soft);
        font-size: 11px;
    }

    .compliance-toast span {
        margin-top: 3px;
        color: var(--pm-text-dim);
        font-size: 9px;
    }


    @@media (max-width: 1500px) {

        .compliance-kpi-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .compliance-workspace {
            grid-template-columns: 350px minmax(0, 1fr);
        }

    }


    @@media (max-width: 1180px) {

        .compliance-toolbar {
            flex-wrap: wrap;
        }

        .compliance-search {
            flex-basis: 100%;
        }

        .compliance-workspace {
