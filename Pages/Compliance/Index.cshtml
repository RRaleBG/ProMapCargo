        box-shadow: 0 0 12px rgba(52, 211, 153, .65);
    }

    .compliance-heading h1 {
        margin: 0;
        color: var(--pm-text);
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1.05;
        letter-spacing: -.035em;
    }

    .compliance-heading p {
        max-width: 760px;
        margin: 10px 0 0;
        color: var(--pm-text-muted);
        font-size: 15px;
        line-height: 1.6;
    }

    .compliance-header-actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

    .compliance-btn {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 11px;
        border: 1px solid var(--pm-border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--pm-text);
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: .18s ease;
    }

    .compliance-btn:hover {
        transform: translateY(-1px);
        border-color: var(--pm-border-strong);
    }

    .compliance-btn-primary {
        background: linear-gradient(135deg, #10b981, #059669);
        border-color: rgba(110, 231, 183, .28);
        color: #021512;
        box-shadow: 0 9px 24px rgba(16, 185, 129, .12);
    }

    .compliance-btn-primary:hover {
        box-shadow: 0 13px 30px rgba(16, 185, 129, .2);
    }

    .compliance-btn-secondary {
        background: rgba(255, 255, 255, .035);
        color: var(--pm-text-soft);
    }

    .compliance-critical-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        margin-bottom: 18px;
        border: 1px solid rgba(251, 113, 133, .38);
        border-radius: 14px;
        background:
            linear-gradient(90deg, rgba(127, 29, 29, .28), rgba(244, 63, 94, .08)),
            rgba(45, 8, 13, .68);
        box-shadow: 0 0 35px rgba(244, 63, 94, .08);
        animation: compliancePulse 3s ease-in-out infinite;
    }

    @@keyframes compliancePulse {
        0%, 100% {
            box-shadow: 0 0 30px rgba(244, 63, 94, .05);
        }

        50% {
            box-shadow: 0 0 35px rgba(244, 63, 94, .15);
        }
