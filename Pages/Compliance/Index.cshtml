            </button>

        </div>


        <form id="documentForm" class="compliance-form">

            <div class="form-grid">

                <label class="form-field form-field-full">
                    <span>Tip dokumenta</span>

                    <select id="documentType" required>
                        <option value="">Izaberi dokument</option>
                        <option value="registration">Saobraćajna dozvola</option>
                        <option value="euro-truck">Euro 6 potvrda · kamion</option>
                        <option value="euro-trailer">Euro potvrda · prikolica</option>
                        <option value="technical">Tehnički pregled</option>
                        <option value="tir">TIR sertifikat</option>
                        <option value="license">Licenca / dozvola Republike Srbije</option>
                        <option value="tachograph">Tahograf</option>
                        <option value="fire">PP aparat / sertifikat</option>
                    </select>
                </label>


                <label class="form-field">
                    <span>Broj dokumenta</span>
                    <input id="documentNumber" type="text" placeholder="npr. TIR-2026-001" />
                </label>


                <label class="form-field">
                    <span>Datum izdavanja</span>
                    <input id="documentIssueDate" type="date" />
                </label>


                <label class="form-field">
                    <span>Datum važenja</span>
                    <input id="documentExpiryDate" type="date" required />
                </label>


                <label class="form-field">
                    <span>Organ / izdavalac</span>
                    <input id="documentIssuer" type="text" placeholder="Naziv organa ili organizacije" />
                </label>


                <label class="form-field form-field-full">
                    <span>Dokument</span>

                    <div class="file-upload">

                        <input
                            id="documentFile"
                            type="file"
                            accept=".pdf,.jpg,.jpeg,.png" />

                        <div class="file-upload-content">
                            <strong>Dodaj dokument</strong>
                            <span>PDF, JPG ili PNG</span>
                        </div>

                    </div>
                </label>


                <label class="form-field form-field-full">
                    <span>Napomena</span>
                    <textarea
                        id="documentNote"
                        rows="4"
                        placeholder="Dodatne informacije..."></textarea>
                </label>

            </div>


            <div class="form-compliance-notice">

                <span>i</span>

                <div>
                    <strong>Status se računa automatski.</strong>

                    <p>
                        Sistem će na osnovu datuma važenja odrediti da li je dokument
                        validan, pred istekom ili istekao.
                    </p>
                </div>

            </div>


            <div class="compliance-modal-actions">

                <button
                    type="button"
                    class="compliance-btn compliance-btn-secondary"
                    data-close-modal>
                    Otkaži
                </button>

                <button
                    type="submit"
                    class="compliance-btn compliance-btn-primary">
                    Sačuvaj dokument
                </button>

            </div>

        </form>

    </div>

</div>


