@page
@{
    ViewData["Title"] = "Vozila · ProMap Cargo";
}

<div class="pm-page pm-vehicles-page" data-module="vehicles">

    <style>
        .pm-vehicles-page {
            padding: 28px 30px 34px;
            min-width: 0;
        }

        .pm-vehicles-content {
            max-width: 1680px;
            margin: 0 auto;
        }

        .pm-vehicles-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 24px;
        }

        .pm-vehicles-heading {
            min-width: 0;
        }

        .pm-vehicles-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: var(--pm-teal);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .pm-vehicles-kicker-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--pm-emerald-400);
            box-shadow: 0 0 12px rgba(52, 211, 153, .55);
        }

        .pm-vehicles-title {
            margin: 0;
            color: var(--pm-text);
            font-size: clamp(28px, 3vw, 38px);
            line-height: 1.08;
            font-weight: 800;
            letter-spacing: -.035em;
        }

        .pm-vehicles-subtitle {
            max-width: 780px;
            margin: 10px 0 0;
            color: var(--pm-text-muted);
            font-size: 14px;
            line-height: 1.65;
        }

        .pm-vehicles-header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .pm-vehicles-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0 16px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-sm);
            background: var(--pm-surface);
            color: var(--pm-text-soft);
            font: inherit;
            font-size: 13px;
            font-weight: 750;
            cursor: pointer;
            transition: .18s ease;
        }

        .pm-vehicles-btn:hover {
            background: var(--pm-surface-hover);
            border-color: var(--pm-border-strong);
            transform: translateY(-1px);
        }

        .pm-vehicles-btn.primary {
            border-color: rgba(16, 185, 129, .45);
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ecfdf5;
            box-shadow: 0 10px 26px rgba(16, 185, 129, .16);
        }

        .pm-vehicles-btn.primary:hover {
            background: linear-gradient(135deg, #34d399, #059669);
        }

        .pm-vehicles-btn svg {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
        }

        .pm-vehicles-kpis {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .pm-vehicle-kpi {
            position: relative;
            overflow: hidden;
            min-height: 132px;
            padding: 18px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background:
                radial-gradient(circle at 100% 0%, rgba(45, 212, 191, .07), transparent 42%),
                var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
        }

        .pm-vehicle-kpi::after {
            content: "";
            position: absolute;
            right: -26px;
            bottom: -34px;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: rgba(16, 185, 129, .035);
            pointer-events: none;
        }

        .pm-vehicle-kpi-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .pm-vehicle-kpi-label {
            color: var(--pm-text-muted);
            font-size: 12px;
            font-weight: 700;
        }

        .pm-vehicle-kpi-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 12px;
            background: rgba(16, 185, 129, .08);
            color: var(--pm-emerald-300);
        }

        .pm-vehicle-kpi-icon svg {
            width: 22px;
            height: 22px;
        }

        .pm-vehicle-kpi-value {
            margin-top: 12px;
            color: var(--pm-text);
            font-size: 29px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: -.025em;
        }

        .pm-vehicle-kpi-note {
            margin-top: 8px;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-vehicles-toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px;
            margin-bottom: 18px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background: var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
        }

        .pm-vehicle-search {
            position: relative;
            flex: 1 1 auto;
            min-width: 240px;
        }

        .pm-vehicle-search svg {
            position: absolute;
            left: 14px;
            top: 50%;
            width: 19px;
            height: 19px;
            transform: translateY(-50%);
            color: var(--pm-text-dim);
            pointer-events: none;
        }

        .pm-vehicle-input,
        .pm-vehicle-select {
            width: 100%;
            min-height: 44px;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            outline: none;
            background: rgba(1, 13, 11, .52);
            color: var(--pm-text);
            font: inherit;
            font-size: 13px;
            transition: .18s ease;
        }

        .pm-vehicle-input {
            padding: 0 14px 0 44px;
        }

        .pm-vehicle-select {
            min-width: 170px;
            padding: 0 36px 0 13px;
        }

        .pm-vehicle-input::placeholder {
            color: var(--pm-text-dim);
        }

        .pm-vehicle-input:focus,
        .pm-vehicle-select:focus {
            border-color: var(--pm-border-strong);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, .08);
        }

        .pm-vehicle-results {
            margin-left: auto;
            padding: 0 8px;
            color: var(--pm-text-dim);
            font-size: 12px;
            white-space: nowrap;
        }

        .pm-vehicles-workspace {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 380px;
            gap: 18px;
            align-items: start;
        }

        .pm-vehicles-card {
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background: var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
            overflow: hidden;
        }

        .pm-vehicles-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px;
            border-bottom: 1px solid var(--pm-border-soft);
        }

        .pm-vehicles-card-title-wrap {
            min-width: 0;
        }

        .pm-vehicles-card-title {
            margin: 0;
            color: var(--pm-text);
            font-size: 15px;
            font-weight: 800;
        }

        .pm-vehicles-card-subtitle {
            margin: 4px 0 0;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-vehicles-refresh {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-soft);
            cursor: pointer;
            transition: .18s ease;
        }

        .pm-vehicles-refresh:hover {
            border-color: var(--pm-border-strong);
            background: var(--pm-surface-hover);
        }

        .pm-vehicles-refresh svg {
            width: 19px;
            height: 19px;
        }

        .pm-vehicles-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .pm-vehicles-table {
            width: 100%;
            min-width: 980px;
            border-collapse: collapse;
        }

        .pm-vehicles-table th {
            padding: 12px 18px;
            border-bottom: 1px solid var(--pm-border-soft);
            color: var(--pm-text-dim);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .pm-vehicles-table td {
            padding: 13px 18px;
            border-bottom: 1px solid rgba(255,255,255,.035);
            color: var(--pm-text-soft);
            font-size: 12px;
            vertical-align: middle;
        }

        .pm-vehicles-table tbody tr {
            cursor: pointer;
            transition: background .16s ease;
        }

        .pm-vehicles-table tbody tr:hover {
            background: rgba(16, 185, 129, .045);
        }

        .pm-vehicles-table tbody tr.selected {
            background: rgba(16, 185, 129, .075);
            box-shadow: inset 3px 0 0 var(--pm-emerald-400);
        }

        .pm-vehicle-identity {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 225px;
        }

        .pm-vehicle-icon {
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 44px;
            border: 1px solid rgba(45, 212, 191, .22);
            border-radius: 12px;
            background: linear-gradient(145deg, rgba(16,185,129,.18), rgba(45,212,191,.06));
            color: var(--pm-emerald-200);
        }

        .pm-vehicle-icon svg {
            width: 22px;
            height: 22px;
        }

        .pm-vehicle-registration {
            color: var(--pm-text);
            font-size: 13px;
            font-weight: 800;
        }

        .pm-vehicle-meta {
            margin-top: 4px;
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-vehicle-cell-main {
            color: var(--pm-text-soft);
            font-weight: 650;
        }

        .pm-vehicle-cell-sub {
            margin-top: 4px;
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-vehicle-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 28px;
            padding: 0 9px;
            border: 1px solid transparent;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .pm-vehicle-status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .pm-vehicle-status.active {
            border-color: rgba(52,211,153,.18);
            background: rgba(16,185,129,.10);
            color: #6ee7b7;
        }

        .pm-vehicle-status.available {
            border-color: rgba(45,212,191,.18);
            background: rgba(45,212,191,.08);
            color: #5eead4;
        }

        .pm-vehicle-status.maintenance {
            border-color: rgba(251,191,36,.18);
            background: rgba(245,158,11,.09);
            color: #fbbf24;
        }

        .pm-vehicle-status.inactive {
            border-color: rgba(148,163,184,.14);
            background: rgba(148,163,184,.07);
            color: #94a3b8;
        }

        .pm-vehicle-gps {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--pm-text-muted);
            font-size: 11px;
            white-space: nowrap;
        }

        .pm-vehicle-gps-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--pm-text-dim);
        }

        .pm-vehicle-gps.online .pm-vehicle-gps-dot {
            background: var(--pm-emerald-400);
            box-shadow: 0 0 9px rgba(52,211,153,.55);
        }

        .pm-vehicle-gps.stale .pm-vehicle-gps-dot {
            background: var(--pm-warning);
        }

        .pm-vehicle-gps.offline .pm-vehicle-gps-dot {
            background: var(--pm-danger);
        }

        .pm-vehicle-action {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 9px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-muted);
        }

        .pm-vehicle-action svg {
            width: 17px;
            height: 17px;
        }

        .pm-vehicle-empty,
        .pm-vehicle-loading,
        .pm-vehicle-error {
            padding: 48px 24px;
            text-align: center;
        }

        .pm-vehicle-state-icon {
            width: 52px;
            height: 52px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            border: 1px solid var(--pm-border);
            border-radius: 15px;
            background: rgba(16,185,129,.07);
            color: var(--pm-emerald-300);
        }

        .pm-vehicle-state-icon svg {
            width: 25px;
            height: 25px;
        }

        .pm-vehicle-state-title {
            color: var(--pm-text);
            font-size: 14px;
            font-weight: 800;
        }

        .pm-vehicle-state-text {
            max-width: 460px;
            margin: 7px auto 0;
            color: var(--pm-text-dim);
            font-size: 12px;
            line-height: 1.6;
        }

        .pm-vehicle-details {
            position: sticky;
            top: 90px;
        }

        .pm-vehicle-profile {
            padding: 22px;
        }

        .pm-vehicle-profile-top {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .pm-vehicle-profile-icon {
            width: 60px;
            height: 60px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 60px;
            border: 1px solid rgba(45,212,191,.24);
            border-radius: 16px;
            background: linear-gradient(145deg, rgba(16,185,129,.20), rgba(45,212,191,.06));
            color: var(--pm-emerald-200);
        }

        .pm-vehicle-profile-icon svg {
            width: 29px;
            height: 29px;
        }

        .pm-vehicle-profile-registration {
            margin: 2px 0 0;
            color: var(--pm-text);
            font-size: 19px;
            font-weight: 800;
            line-height: 1.2;
        }

        .pm-vehicle-profile-meta {
            margin-top: 6px;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-vehicle-profile-status {
            margin-top: 9px;
        }

        .pm-vehicle-detail-section {
            padding: 18px 20px;
            border-top: 1px solid var(--pm-border-soft);
        }

        .pm-vehicle-detail-heading {
            margin: 0 0 12px;
            color: var(--pm-text);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .pm-vehicle-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .pm-vehicle-detail-item {
            min-width: 0;
            padding: 12px;
            border: 1px solid var(--pm-border-soft);
            border-radius: 11px;
            background: rgba(255,255,255,.018);
        }

        .pm-vehicle-detail-label {
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-vehicle-detail-value {
            margin-top: 5px;
            color: var(--pm-text-soft);
            font-size: 12px;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .pm-vehicle-operational {
            display: grid;
            gap: 9px;
        }

        .pm-vehicle-operation-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid rgba(255,255,255,.035);
        }

        .pm-vehicle-operation-row:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .pm-vehicle-operation-label {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--pm-text-muted);
            font-size: 11px;
        }

        .pm-vehicle-operation-label svg {
            width: 18px;
            height: 18px;
            color: var(--pm-text-dim);
        }

        .pm-vehicle-operation-value {
            color: var(--pm-text-soft);
            font-size: 11px;
            font-weight: 750;
            text-align: right;
        }

        .pm-vehicle-detail-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .pm-vehicle-detail-action {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 12px;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-soft);
            font: inherit;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
        }

        .pm-vehicle-detail-action:hover {
            background: var(--pm-surface-hover);
            border-color: var(--pm-border-strong);
        }

        .pm-vehicle-detail-action svg {
            width: 17px;
            height: 17px;
        }

        .pm-vehicles-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-top: 14px;
            padding: 12px 14px;
            border: 1px solid var(--pm-border-soft);
            border-radius: 10px;
            background: rgba(255,255,255,.018);
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-vehicles-footer-info strong {
            color: var(--pm-text-muted);
            font-weight: 700;
        }

        .pm-vehicle-spin {
            animation: pmVehicleSpin 1s linear infinite;
        }

        @@keyframes pmVehicleSpin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 1280px) {
            .pm-vehicles-kpis {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .pm-vehicles-workspace {
                grid-template-columns: minmax(0, 1fr) 340px;
            }
        }

        @@media (max-width: 1050px) {
            .pm-vehicles-workspace {
                grid-template-columns: 1fr;
            }

            .pm-vehicle-details {
                position: static;
            }
        }

        @@media (max-width: 800px) {
            .pm-vehicles-page {
                padding: 20px 16px 28px;
            }

            .pm-vehicles-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .pm-vehicles-header-actions {
                width: 100%;
            }

            .pm-vehicles-header-actions .pm-vehicles-btn {
                flex: 1;
            }

            .pm-vehicles-kpis {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .pm-vehicles-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .pm-vehicle-search {
                min-width: 0;
            }

            .pm-vehicle-select {
                width: 100%;
            }

            .pm-vehicle-results {
                margin-left: 0;
                padding: 0 2px;
            }
        }

        @@media (max-width: 520px) {
            .pm-vehicles-kpis {
                grid-template-columns: 1fr;
            }

            .pm-vehicles-title {
                font-size: 27px;
            }

            .pm-vehicle-detail-grid {
                grid-template-columns: 1fr;
            }

            .pm-vehicle-detail-actions {
                grid-template-columns: 1fr;
            }

            .pm-vehicles-footer-info {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

    <div class="pm-vehicles-content">

        <header class="pm-vehicles-header">

            <div class="pm-vehicles-heading">

                <div class="pm-vehicles-kicker">
                    <span class="pm-vehicles-kicker-dot"></span>
                    Fleet · Vozila
                </div>

                <h1 class="pm-vehicles-title">
                    Vozila
                </h1>

                <p class="pm-vehicles-subtitle">
                    Pregled kompletnog voznog parka, statusa vozila, dodeljenih vozača,
                    aktivnih tura i GPS aktivnosti.
                </p>

            </div>

            <div class="pm-vehicles-header-actions">

                <button type="button" class="pm-vehicles-btn" id="refreshVehicles">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                        <path d="M3 4v6h6"></path>
                        <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                        <path d="M21 20v-6h-6"></path>
                    </svg>

                    Osveži

                </button>

                <button type="button" class="pm-vehicles-btn primary" id="addVehicle">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>

                    Novo vozilo

                </button>

            </div>

        </header>

        <section class="pm-vehicles-kpis" aria-label="Statistika vozila">

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Ukupno vozila</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
                            <path d="M18 17h3"></path>
                            <path d="M5 17V9h10l4 4v4"></path>
                            <circle cx="8" cy="17" r="2"></circle>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M15 9v4h4"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiTotal">—</div>
                <div class="pm-vehicle-kpi-note">registrovanih vozila</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Aktivna</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    </span>
                </div>

                <div class="pm-vehicle-kpi-value" id="kpiActive">—</div>
                <div class="pm-vehicle-kpi-note">u operativnom statusu</div>

            </article>

            <article class="pm-vehicle-kpi">

                <div class="pm-vehicle-kpi-head">
                    <span class="pm-vehicle-kpi-label">Na turi</span>

                    <span class="pm-vehicle-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
