@page "/profile"
@{
    ViewData["Title"] = "Profil · ProMap Cargo";
}

<div class="pm-profile-page" data-module="profile">

    <header class="pm-profile-header">

        <div class="pm-profile-heading">

            <div class="pm-profile-kicker">
                ACCOUNT · IDENTITY
            </div>

            <h1>Profil</h1>

            <p>
                Lični podaci, bezbednost naloga, Identity podešavanja i operativni kontekst korisnika.
            </p>

        </div>

        <div class="pm-profile-header-actions">

            <div class="pm-profile-status">
                <span class="pm-profile-status-dot"></span>
                <span>Nalog aktivan</span>
            </div>

            <button type="button"
                    class="pm-profile-btn pm-profile-btn-secondary"
                    data-action="discard">
                Poništi izmene
            </button>

            <button type="button"
                    class="pm-profile-btn pm-profile-btn-primary"
                    data-action="save">
                Sačuvaj profil
            </button>

        </div>

    </header>


    <div class="pm-profile-grid">


        <!-- =====================================================
             LEFT COLUMN
             ===================================================== -->

        <section class="pm-profile-main">


            <!-- PROFILE HERO -->

            <article class="pm-profile-card pm-profile-hero-card">

                <div class="pm-profile-hero-glow"></div>

                <div class="pm-profile-avatar-wrap">

                    <div class="pm-profile-avatar" id="profileAvatar">

                        <span class="pm-profile-avatar-initials"
                              id="avatarInitials">
                            MP
                        </span>

                        <img id="avatarImage"
                             alt="Profilna fotografija"
                             hidden />

                    </div>

                    <label class="pm-profile-avatar-edit"
                           for="avatarUpload"
                           title="Promeni profilnu fotografiju">
                        +
                    </label>

                    <input id="avatarUpload"
                           type="file"
                           accept="image/png,image/jpeg,image/webp"
                           hidden />

                </div>


                <div class="pm-profile-identity">

                    <div class="pm-profile-identity-top">

                        <div>

                            <div class="pm-profile-name"
                                 id="profileNamePreview">
                                Marko Petrović
                            </div>

                            <div class="pm-profile-username">
                                @@marko.petrovic
                            </div>

                        </div>

                        <span class="pm-profile-role-badge">
                            Dispatcher
                        </span>

                    </div>

                    <div class="pm-profile-company">
                        ProMap Cargo Demo · Fleet Operations
                    </div>

                    <div class="pm-profile-meta">

                        <span>
                            ●
                            Active
                        </span>

                        <span>
                            Identity verified
                        </span>

                        <span>
                            Tenant: PROMAP-DEMO
                        </span>

                    </div>

                </div>


                <div class="pm-profile-profile-score">

                    <div class="pm-profile-score-ring">

                        <svg viewBox="0 0 42 42">

                            <circle class="pm-score-track"
                                    cx="21"
                                    cy="21"
                                    r="16"></circle>

                            <circle class="pm-score-progress"
                                    cx="21"
                                    cy="21"
                                    r="16"></circle>

                        </svg>

                        <strong>92%</strong>

                    </div>

                    <div>

                        <strong>Profil kompletan</strong>

                        <span>
                            Dodajte recovery telefon za 100%.
                        </span>

                    </div>

                </div>

            </article>


            <!-- PERSONAL INFORMATION -->

            <article class="pm-profile-card">

                <div class="pm-profile-card-header">

                    <div>

                        <div class="pm-profile-eyebrow">
                            PERSONAL INFORMATION
                        </div>

                        <h2>Osnovni podaci</h2>

                        <p>
                            Podaci koji pripadaju Identity korisničkom nalogu.
                        </p>

                    </div>

                    <span class="pm-profile-section-icon">
                        ◯
                    </span>

                </div>


                <div class="pm-profile-form-grid">


                    <div class="pm-profile-field">

                        <label for="displayName">
                            Ime i prezime
                        </label>

                        <input id="displayName"
                               name="DisplayName"
                               type="text"
                               value="Marko Petrović"
                               autocomplete="name" />

                    </div>


                    <div class="pm-profile-field">

                        <label for="username">
                            Username
                        </label>

                        <input id="username"
                               name="UserName"
                               type="text"
                               value="marko.petrovic"
                               autocomplete="username" />

                        <small>
                            Username se koristi za prijavu na sistem.
                        </small>

                    </div>


                    <div class="pm-profile-field">

                        <label for="email">
                            Email adresa
                        </label>

                        <div class="pm-profile-input-status">

                            <input id="email"
                                   name="Email"
                                   type="email"
                                   value="marko.petrovic@promapcargo.local"
                                   autocomplete="email" />

                            <span class="pm-profile-verified">
                                ✓ Verified
                            </span>

                        </div>

                    </div>


                    <div class="pm-profile-field">

                        <label for="phone">
                            Telefon
                        </label>

                        <div class="pm-profile-input-status">

                            <input id="phone"
                                   name="PhoneNumber"
                                   type="tel"
                                   value="+381 64 123 4567"
                                   autocomplete="tel" />

                            <span class="pm-profile-unverified">
                                Verify
                            </span>

                        </div>

                    </div>


                    <div class="pm-profile-field">

                        <label for="language">
                            Jezik
                        </label>

                        <select id="language"
                                name="Language">

                            <option value="sr" selected>
                                Srpski
                            </option>

                            <option value="en">
                                English
                            </option>

                            <option value="de">
                                Deutsch
                            </option>

                        </select>

                    </div>


                    <div class="pm-profile-field">

                        <label for="timezone">
                            Vremenska zona
                        </label>

                        <select id="timezone"
                                name="Timezone">

                            <option value="Europe/Belgrade"
                                    selected>
                                Europe/Belgrade
                            </option>

                            <option value="Europe/Berlin">
                                Europe/Berlin
                            </option>

                            <option value="UTC">
                                UTC
                            </option>

                        </select>

                    </div>


                    <div class="pm-profile-field pm-profile-field-wide">

                        <label for="bio">
                            Kratak opis
                        </label>

                        <textarea id="bio"
                                  name="Bio"
                                  rows="4"
                                  placeholder="Kratak opis korisnika...">Fleet Operations · Dispatch</textarea>

                    </div>

                </div>

            </article>


            <!-- IDENTITY / TENANT -->

            <article class="pm-profile-card">

                <div class="pm-profile-card-header">

                    <div>

                        <div class="pm-profile-eyebrow">
                            ASP.NET CORE IDENTITY
                        </div>

                        <h2>Identity nalog</h2>

                        <p>
                            Sistem identiteta, tenant scope i korisničke privilegije.
                        </p>

                    </div>

                    <span class="pm-profile-live-badge">
                        IDENTITY READY
                    </span>

                </div>


                <div class="pm-profile-identity-grid">


                    <div class="pm-profile-identity-item">

                        <span>User ID</span>

                        <strong>
                            9c4e1b7a-••••-••••-••••-a812
                        </strong>

                        <button type="button"
                                class="pm-profile-copy"
                                data-copy="9c4e1b7a-demo-user">
                            Copy
                        </button>

                    </div>


                    <div class="pm-profile-identity-item">

                        <span>Authentication</span>

                        <strong>
                            ASP.NET Core Identity
                        </strong>

                        <em class="pm-profile-state-success">
                            ACTIVE
                        </em>

                    </div>


                    <div class="pm-profile-identity-item">

                        <span>Company / Tenant</span>

                        <strong>
                            ProMap Cargo Demo
                        </strong>

                        <em>
                            PROMAP-DEMO
                        </em>

                    </div>


                    <div class="pm-profile-identity-item">

                        <span>Role</span>

                        <strong>
                            Dispatcher
                        </strong>

                        <em>
                            Fleet Operations
                        </em>

                    </div>


                    <div class="pm-profile-identity-item">

                        <span>Email confirmation</span>

                        <strong>
                            Confirmed
                        </strong>

                        <em class="pm-profile-state-success">
                            VERIFIED
                        </em>

                    </div>


                    <div class="pm-profile-identity-item">

                        <span>Account created</span>

                        <strong>
                            12.09.2026
                        </strong>

                        <em>
                            7 days ago
                        </em>

                    </div>

                </div>

            </article>


            <!-- OPERATIONAL CONTEXT -->

            <article class="pm-profile-card">

                <div class="pm-profile-card-header">

                    <div>

                        <div class="pm-profile-eyebrow">
                            OPERATIONS
                        </div>

                        <h2>Operativni kontekst</h2>

                        <p>
                            Veza korisničkog naloga sa ProMap Cargo operacijama.
                        </p>

                    </div>

                    <span class="pm-profile-section-icon">
                        ◈
                    </span>

                </div>


                <div class="pm-profile-operation-grid">


                    <div class="pm-profile-operation-card">

                        <div class="pm-profile-operation-icon">
                            ◈
                        </div>

                        <div>

                            <span>Trenutna uloga</span>

                            <strong>
                                Dispatcher
                            </strong>

                            <small>
                                Dispatch & Fleet Operations
                            </small>

                        </div>

                    </div>


                    <div class="pm-profile-operation-card">

                        <div class="pm-profile-operation-icon">
                            ↗
                        </div>

                        <div>

                            <span>Aktivna tura</span>

                            <strong>
                                TR-2026-00887
                            </strong>

                            <small>
                                Novi Sad → Beograd
                            </small>

                        </div>

                    </div>


                    <div class="pm-profile-operation-card">

                        <div class="pm-profile-operation-icon">
                            ▣
                        </div>

                        <div>

                            <span>Vozilo</span>

                            <strong>
                                BG-123-AB
                            </strong>

                            <small>
                                Mercedes-Benz Actros
                            </small>

                        </div>

                    </div>


                    <div class="pm-profile-operation-card">

                        <div class="pm-profile-operation-icon">
                            $
                        </div>

                        <div>

                            <span>Finansijski pristup</span>

                            <strong>
                                Dispatch Finance
                            </strong>

                            <small>
                                Read / Submit expenses
                            </small>

                        </div>

                    </div>

                </div>

            </article>


            <!-- PREFERENCES -->

            <article class="pm-profile-card">

                <div class="pm-profile-card-header">

                    <div>

                        <div class="pm-profile-eyebrow">
                            PREFERENCES
                        </div>

                        <h2>Obaveštenja i preferencije</h2>

                        <p>
                            Kontrola načina na koji ProMap Cargo komunicira sa korisnikom.
                        </p>

                    </div>

                </div>


                <div class="pm-profile-preferences">


                    <label class="pm-profile-toggle-row">

                        <span>

                            <strong>
                                Dispatch obaveštenja
                            </strong>

                            <small>
                                Promene statusa tura i transportnih naloga.
                            </small>

                        </span>

                        <input type="checkbox"
                               checked
                               data-preference="dispatch" />

                        <i></i>

                    </label>


                    <label class="pm-profile-toggle-row">

                        <span>

                            <strong>
                                GPS / Navigation alerts
                            </strong>

                            <small>
                                Off-route, GPS i routing upozorenja.
                            </small>

                        </span>

                        <input type="checkbox"
                               checked
                               data-preference="gps" />

                        <i></i>

                    </label>


                    <label class="pm-profile-toggle-row">

                        <span>

                            <strong>
                                Finansijska obaveštenja
                            </strong>

                            <small>
                                Putni troškovi, gorivo, kartice i odobrenja.
                            </small>

                        </span>

                        <input type="checkbox"
                               checked
                               data-preference="finance" />

                        <i></i>

                    </label>


                    <label class="pm-profile-toggle-row">

                        <span>

                            <strong>
                                Email notifications
                            </strong>

                            <small>
                                Slanje važnih sistemskih događaja na email.
                            </small>

                        </span>

                        <input type="checkbox"
                               checked
                               data-preference="email" />

                        <i></i>

                    </label>


                    <label class="pm-profile-toggle-row">

                        <span>

                            <strong>
                                Mobile / Push
                            </strong>

                            <small>
                                Push obaveštenja za mobilni uređaj.
                            </small>

                        </span>

                        <input type="checkbox"
                               data-preference="push" />

                        <i></i>

                    </label>

                </div>

            </article>


        </section>


        <!-- =====================================================
             RIGHT COLUMN
             ===================================================== -->

        <aside class="pm-profile-side">


            <!-- SECURITY -->

            <article class="pm-profile-card pm-profile-security-card">

                <div class="pm-profile-card-header">

                    <div>

                        <div class="pm-profile-eyebrow">
                            SECURITY
                        </div>

                        <h2>Bezbednost</h2>

                        <p>
                            Zaštitite Identity nalog.
                        </p>

                    </div>

                    <span class="pm-profile-security-shield">
                        ◇
                    </span>

                </div>


                <div class="pm-profile-security-list">


                    <div class="pm-profile-security-item">

                        <div class="pm-profile-security-icon success">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Lozinka
                            </strong>

                            <span>
                                Promenjena pre 21 dan
                            </span>

                        </div>

                        <button type="button"
                                class="pm-profile-link-btn"
                                data-action="password">
                            Promeni
                        </button>

                    </div>


                    <div class="pm-profile-security-item">

                        <div class="pm-profile-security-icon success">
                            ✓
                        </div>

                        <div>

                            <strong>
                                Two-factor authentication
                            </strong>

                            <span>
                                Authenticator aktivan
                            </span>

                        </div>

                        <button type="button"
                                class="pm-profile-link-btn"
                                data-action="twofa">
                            Manage
                        </button>

                    </div>


                    <div class="pm-profile-security-item">

                        <div class="pm-profile-security-icon warning">
                            !
                        </div>

                        <div>

                            <strong>
                                Recovery codes
                            </strong>

                            <span>
                                7 kodova dostupno
                            </span>

                        </div>

                        <button type="button"
                                class="pm-profile-link-btn"
                                data-action="recovery">
                            Prikaži
                        </button>

                    </div>

                </div>


                <div class="pm-profile-security-footer">

                    <span>
                        Security score
                    </span>

                    <strong>
                        88 / 100
                    </strong>

                </div>

                <div class="pm-profile-progress">
                    <span style="width:88%"></span>
                </div>

            </article>


            <!-- SESSIONS -->

            <article class="pm-profile-card">

                <div class="pm-profile-card-header compact">

                    <div>

                        <div class="pm-profile-eyebrow">
