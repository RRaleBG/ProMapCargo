</div>


<style>

.pm-profile-page
{
    position: relative;
    width: 100%;
    min-height: 100%;
    color: var(--pm-text);
}

.pm-profile-header
{
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
    padding: 4px 2px 0;
}

.pm-profile-heading
{
    min-width: 0;
}

.pm-profile-kicker
{
    margin-bottom: 6px;
    color: var(--pm-teal);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.pm-profile-heading h1
{
    margin: 0;
    color: var(--pm-text);
    font-size: 30px;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -.035em;
}

.pm-profile-heading p
{
    margin: 7px 0 0;
    color: var(--pm-text-muted);
    font-size: 13px;
}

.pm-profile-header-actions
{
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.pm-profile-status
{
    height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    border: 1px solid rgba(52,211,153,.12);
    border-radius: 10px;
    background: rgba(16,185,129,.055);
    color: var(--pm-text-muted);
    font-size: 10px;
    font-weight: 600;
}

.pm-profile-status-dot
{
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pm-emerald-400);
    box-shadow:
        0 0 0 4px rgba(52,211,153,.08),
        0 0 14px rgba(52,211,153,.55);
    animation: profilePulse 2.4s ease-in-out infinite;
}

.pm-profile-btn
{
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 14px;
    border: 1px solid var(--pm-border);
    border-radius: 10px;
    color: var(--pm-text-soft);
    background: var(--pm-surface);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition:
        transform .18s ease,
        background .18s ease,
        border-color .18s ease,
        box-shadow .18s ease;
}

.pm-profile-btn:hover
{
    transform: translateY(-1px);
    border-color: var(--pm-border-strong);
    background: var(--pm-surface-hover);
}

.pm-profile-btn-primary
{
    border-color: rgba(52,211,153,.35);
    color: #021512;
    background: linear-gradient(
        135deg,
        var(--pm-emerald-400),
        var(--pm-emerald-500)
    );
    box-shadow: 0 8px 22px rgba(16,185,129,.16);
}

.pm-profile-btn-primary:hover
{
    color: #021512;
    box-shadow: 0 12px 30px rgba(16,185,129,.24);
}

.pm-profile-btn-secondary
{
    background: rgba(4,31,26,.66);
}


/* =========================================================
   GRID
   ========================================================= */

.pm-profile-grid
{
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(330px, .85fr);
    gap: 16px;
    align-items: start;
}

.pm-profile-main,
.pm-profile-side
{
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}


/* =========================================================
   CARD
   ========================================================= */

.pm-profile-card
{
    position: relative;
    overflow: hidden;
    border: 1px solid var(--pm-border);
    border-radius: var(--pm-radius-lg);
    background:
        linear-gradient(
            145deg,
            rgba(5,39,32,.82),
            rgba(2,22,18,.84)
        );
    box-shadow: var(--pm-shadow-sm);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: profileCardIn .48s ease both;
}

.pm-profile-card:nth-child(2)
{
    animation-delay: .04s;
}

.pm-profile-card:nth-child(3)
{
    animation-delay: .08s;
}

.pm-profile-card:nth-child(4)
{
    animation-delay: .12s;
}

.pm-profile-card:nth-child(5)
{
    animation-delay: .16s;
}

.pm-profile-card::after
{
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
        linear-gradient(
            115deg,
            rgba(255,255,255,.025),
            transparent 28%
        );
}

.pm-profile-card-header
{
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 15px;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-card-header.compact
{
    padding-bottom: 13px;
}

.pm-profile-card-header h2
{
    margin: 3px 0 0;
    color: var(--pm-text);
    font-size: 16px;
    font-weight: 750;
    letter-spacing: -.015em;
}

.pm-profile-card-header p
{
    margin: 5px 0 0;
    color: var(--pm-text-muted);
    font-size: 11px;
}

.pm-profile-eyebrow
{
    color: var(--pm-teal);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .17em;
}

.pm-profile-eyebrow.danger
{
    color: var(--pm-danger);
}

.pm-profile-section-icon,
.pm-profile-security-shield
{
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(45,212,191,.15);
    border-radius: 10px;
    background: rgba(45,212,191,.055);
    color: var(--pm-teal);
    font-size: 15px;
}


/* =========================================================
   PROFILE HERO
   ========================================================= */

.pm-profile-hero-card
{
    min-height: 170px;
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 23px;
}

.pm-profile-hero-glow
{
    position: absolute;
    width: 280px;
    height: 180px;
    left: 8%;
    top: -80px;
    pointer-events: none;
    background: radial-gradient(
        circle,
        rgba(16,185,129,.14),
        transparent 68%
    );
    filter: blur(10px);
}

.pm-profile-avatar-wrap
{
    position: relative;
    z-index: 2;
}

.pm-profile-avatar
{
    position: relative;
    width: 92px;
    height: 92px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(45,212,191,.35);
    border-radius: 50%;
    background:
        radial-gradient(
            circle at 35% 25%,
            rgba(45,212,191,.28),
            rgba(16,185,129,.08) 48%,
            rgba(2,21,18,.9)
        );
    box-shadow:
        0 0 0 7px rgba(16,185,129,.045),
        0 0 35px rgba(16,185,129,.13);
}

.pm-profile-avatar img
{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.pm-profile-avatar-initials
{
    color: var(--pm-emerald-100);
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -.05em;
}

.pm-profile-avatar-edit
{
    position: absolute;
    right: -2px;
    bottom: 2px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #021512;
    border-radius: 50%;
    background: var(--pm-emerald-500);
    color: #021512;
    font-size: 19px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 5px 15px rgba(16,185,129,.28);
    transition: transform .18s ease;
}

.pm-profile-avatar-edit:hover
{
    transform: scale(1.1) rotate(8deg);
}

.pm-profile-identity
{
    position: relative;
    z-index: 2;
    min-width: 0;
}

.pm-profile-identity-top
{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.pm-profile-name
{
    color: var(--pm-text);
    font-size: 23px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -.035em;
}

.pm-profile-username
{
    margin-top: 4px;
    color: var(--pm-text-muted);
    font-size: 11px;
}

.pm-profile-role-badge
{
    flex: 0 0 auto;
    padding: 5px 9px;
    border: 1px solid rgba(45,212,191,.15);
    border-radius: 999px;
    background: rgba(45,212,191,.07);
    color: var(--pm-teal);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.pm-profile-company
{
    margin-top: 11px;
    color: var(--pm-text-soft);
    font-size: 11px;
    font-weight: 600;
}

.pm-profile-meta
{
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    margin-top: 8px;
    color: var(--pm-text-dim);
    font-size: 9px;
}

.pm-profile-meta span:first-child
{
    color: var(--pm-emerald-400);
}

.pm-profile-profile-score
{
    position: relative;
    z-index: 2;
    min-width: 160px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px;
    border: 1px solid var(--pm-border-soft);
    border-radius: 12px;
    background: rgba(1,13,11,.32);
}

.pm-profile-score-ring
{
    position: relative;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
}

.pm-profile-score-ring svg
{
    width: 48px;
    height: 48px;
    transform: rotate(-90deg);
}

.pm-score-track,
.pm-score-progress
{
    fill: none;
    stroke-width: 4;
}

.pm-score-track
{
    stroke: rgba(255,255,255,.06);
}

.pm-score-progress
{
    stroke: var(--pm-emerald-400);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 8;
}

.pm-profile-score-ring strong
{
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pm-emerald-300);
    font-size: 11px;
    font-weight: 800;
}

.pm-profile-profile-score > div:last-child
{
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.pm-profile-profile-score strong
{
    color: var(--pm-text-soft);
    font-size: 9px;
}

.pm-profile-profile-score span
{
    color: var(--pm-text-dim);
    font-size: 8px;
    line-height: 1.4;
}


/* =========================================================
   FORM
   ========================================================= */

.pm-profile-form-grid
{
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 15px;
    padding: 20px;
}

.pm-profile-field
{
    min-width: 0;
}

.pm-profile-field-wide
{
    grid-column: 1 / -1;
}

.pm-profile-field label,
.pm-profile-modal-form label
{
    display: block;
    margin-bottom: 6px;
    color: var(--pm-text-soft);
    font-size: 10px;
    font-weight: 650;
}

.pm-profile-field input,
.pm-profile-field select,
.pm-profile-field textarea,
.pm-profile-modal-form input
{
    width: 100%;
    border: 1px solid var(--pm-border);
    outline: none;
    border-radius: 10px;
    padding: 11px 12px;
    background: rgba(1,18,15,.66);
    color: var(--pm-text);
    font-size: 11px;
    transition:
        border-color .18s ease,
        box-shadow .18s ease,
        background .18s ease;
}

.pm-profile-field input,
.pm-profile-field select
{
    height: 42px;
}

.pm-profile-field textarea
{
    min-height: 92px;
    resize: vertical;
}

.pm-profile-field input:hover,
.pm-profile-field select:hover,
.pm-profile-field textarea:hover
{
    border-color: rgba(45,212,191,.22);
}

.pm-profile-field input:focus,
.pm-profile-field select:focus,
.pm-profile-field textarea:focus
{
    border-color: rgba(45,212,191,.5);
    background: rgba(3,28,24,.88);
    box-shadow: 0 0 0 3px rgba(45,212,191,.06);
}

.pm-profile-field small
{
    display: block;
    margin-top: 5px;
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-input-status
{
    position: relative;
}

.pm-profile-input-status input
{
    padding-right: 76px;
}

.pm-profile-verified,
.pm-profile-unverified
{
    position: absolute;
    top: 50%;
    right: 9px;
    transform: translateY(-50%);
    padding: 4px 6px;
    border-radius: 5px;
    font-size: 7px;
    font-weight: 800;
    text-transform: uppercase;
}

.pm-profile-verified
{
    background: rgba(16,185,129,.1);
    color: var(--pm-emerald-400);
}

.pm-profile-unverified
{
    background: rgba(251,191,36,.1);
    color: var(--pm-warning);
}


/* =========================================================
   IDENTITY
   ========================================================= */

.pm-profile-live-badge
{
    padding: 5px 8px;
    border: 1px solid rgba(16,185,129,.16);
    border-radius: 6px;
    background: rgba(16,185,129,.07);
    color: var(--pm-emerald-400);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .1em;
}

.pm-profile-identity-grid
{
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
}

.pm-profile-identity-item
{
    position: relative;
    min-width: 0;
    min-height: 82px;
    padding: 15px 18px;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-identity-item:nth-child(odd)
{
    border-right: 1px solid var(--pm-border-soft);
}

.pm-profile-identity-item span
{
    display: block;
    margin-bottom: 5px;
    color: var(--pm-text-dim);
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
}

.pm-profile-identity-item strong
{
    display: block;
    overflow: hidden;
    color: var(--pm-text-soft);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pm-profile-identity-item em
{
    display: block;
    margin-top: 4px;
    color: var(--pm-text-dim);
    font-size: 8px;
    font-style: normal;
}

.pm-profile-state-success
{
    color: var(--pm-emerald-400) !important;
}

.pm-profile-copy
{
    position: absolute;
    right: 15px;
    top: 34px;
    border: 0;
    background: transparent;
    color: var(--pm-teal);
    font-size: 8px;
    font-weight: 800;
    cursor: pointer;
}


/* =========================================================
   OPERATIONS
   ========================================================= */

.pm-profile-operation-grid
{
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 9px;
    padding: 16px;
}

.pm-profile-operation-card
{
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px;
    border: 1px solid var(--pm-border-soft);
    border-radius: 11px;
    background: rgba(2,22,18,.44);
    transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease;
}

.pm-profile-operation-card:hover
{
    transform: translateY(-2px);
    border-color: rgba(45,212,191,.18);
    background: rgba(7,52,43,.42);
}

.pm-profile-operation-icon
{
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: rgba(16,185,129,.08);
    color: var(--pm-teal);
    font-size: 14px;
}

.pm-profile-operation-card span,
.pm-profile-operation-card small
{
    display: block;
}

.pm-profile-operation-card span
{
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-operation-card strong
{
    display: block;
    margin-top: 3px;
    color: var(--pm-text-soft);
    font-size: 11px;
}

.pm-profile-operation-card small
{
    margin-top: 2px;
    color: var(--pm-text-muted);
    font-size: 8px;
}


/* =========================================================
   PREFERENCES
   ========================================================= */

.pm-profile-preferences
{
    position: relative;
    z-index: 1;
}

.pm-profile-toggle-row
{
    min-height: 64px;
    display: grid;
    grid-template-columns: minmax(0,1fr) 44px;
    align-items: center;
    gap: 15px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--pm-border-soft);
    cursor: pointer;
}

.pm-profile-toggle-row:last-child
{
    border-bottom: 0;
}

.pm-profile-toggle-row > span
{
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.pm-profile-toggle-row strong
{
    color: var(--pm-text-soft);
    font-size: 10px;
}

.pm-profile-toggle-row small
{
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-toggle-row input
{
    display: none;
}

.pm-profile-toggle-row i
{
    position: relative;
    width: 39px;
    height: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    transition: background .2s ease, border-color .2s ease;
}

.pm-profile-toggle-row i::after
{
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #769087;
    transition:
        transform .2s ease,
        background .2s ease;
}

.pm-profile-toggle-row input:checked + i
{
    border-color: rgba(16,185,129,.22);
    background: rgba(16,185,129,.18);
}

.pm-profile-toggle-row input:checked + i::after
{
    transform: translateX(17px);
    background: var(--pm-emerald-400);
    box-shadow: 0 0 10px rgba(52,211,153,.4);
}


/* =========================================================
   SECURITY
   ========================================================= */

.pm-profile-security-list
{
    position: relative;
    z-index: 1;
    padding: 4px 18px;
}

.pm-profile-security-item
{
    display: grid;
    grid-template-columns: 30px minmax(0,1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 67px;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-security-item:last-child
{
    border-bottom: 0;
}

.pm-profile-security-icon
{
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 800;
}

.pm-profile-security-icon.success
{
    background: rgba(16,185,129,.09);
    color: var(--pm-emerald-400);
}

.pm-profile-security-icon.warning
{
    background: rgba(251,191,36,.09);
    color: var(--pm-warning);
}

.pm-profile-security-item strong,
.pm-profile-security-item span
{
    display: block;
}

.pm-profile-security-item strong
{
    color: var(--pm-text-soft);
    font-size: 10px;
}

.pm-profile-security-item span
{
    margin-top: 3px;
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-link-btn
{
    border: 0;
    background: transparent;
    color: var(--pm-teal);
    font-size: 8px;
    font-weight: 800;
    cursor: pointer;
}

.pm-profile-security-footer
{
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    margin: 11px 18px 6px;
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-security-footer strong
{
    color: var(--pm-emerald-400);
}

.pm-profile-progress
{
    height: 4px;
    margin: 0 18px 17px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255,255,255,.055);
}

.pm-profile-progress span
{
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
        90deg,
        var(--pm-emerald-600),
        var(--pm-teal)
    );
}


/* =========================================================
   SESSIONS
   ========================================================= */

.pm-profile-count
{
    min-width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(16,185,129,.08);
    color: var(--pm-emerald-400);
    font-size: 8px;
    font-weight: 800;
}

.pm-profile-sessions
{
    position: relative;
    z-index: 1;
    padding: 5px 16px;
}

.pm-profile-session
{
    position: relative;
    display: grid;
    grid-template-columns: 31px minmax(0,1fr) auto;
    align-items: center;
    gap: 9px;
    min-height: 62px;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-session:last-child
{
    border-bottom: 0;
}

.pm-profile-session-icon
{
    width: 29px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(45,212,191,.06);
    color: var(--pm-teal);
    font-size: 11px;
}

.pm-profile-session-main strong,
.pm-profile-session-main span,
.pm-profile-session-main small
{
    display: block;
}

.pm-profile-session-main strong
{
    color: var(--pm-text-soft);
    font-size: 9px;
}

.pm-profile-session-main span
{
    margin-top: 2px;
    color: var(--pm-text-dim);
    font-size: 8px;
}

.pm-profile-session-main small
{
    margin-top: 2px;
    color: var(--pm-text-muted);
    font-size: 7px;
}

.pm-profile-session-live
{
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pm-emerald-400);
    box-shadow: 0 0 8px rgba(52,211,153,.65);
}

.pm-profile-session-close
{
    width: 23px;
    height: 23px;
    border-radius: 6px;
    background: rgba(251,113,133,.055);
    color: var(--pm-danger);
    cursor: pointer;
}

.pm-profile-wide-btn
{
    width: calc(100% - 32px);
    height: 35px;
    margin: 10px 16px 16px;
    border: 1px solid var(--pm-border);
    border-radius: 8px;
    background: rgba(4,31,26,.62);
    color: var(--pm-text-soft);
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
    transition: background .18s ease, border-color .18s ease;
}

.pm-profile-wide-btn:hover
{
    border-color: var(--pm-border-strong);
    background: var(--pm-surface-hover);
}


/* =========================================================
   ACCESS
   ========================================================= */

.pm-profile-access-list
{
    position: relative;
    z-index: 1;
    padding: 5px 18px 13px;
}

.pm-profile-access-list > div
{
    min-height: 39px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-access-list > div:last-child
{
    border-bottom: 0;
}

.pm-profile-access-list span
{
    color: var(--pm-text-soft);
    font-size: 9px;
}

.pm-profile-access-list b
{
    padding: 4px 6px;
    border-radius: 5px;
    font-size: 6px;
    letter-spacing: .08em;
}

.pm-profile-access-list .allowed
{
    background: rgba(16,185,129,.08);
    color: var(--pm-emerald-400);
}

.pm-profile-access-list .restricted
{
    background: rgba(251,113,133,.07);
    color: var(--pm-danger);
}


/* =========================================================
   ACTIVITY
   ========================================================= */

.pm-profile-activity
{
    position: relative;
    z-index: 1;
    padding: 6px 18px 14px;
}

.pm-profile-activity-item
{
    position: relative;
    display: grid;
    grid-template-columns: 10px minmax(0,1fr);
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid var(--pm-border-soft);
}

.pm-profile-activity-item:last-child
{
    border-bottom: 0;
}

.pm-profile-activity-dot
{
    width: 7px;
    height: 7px;
    margin-top: 4px;
    border-radius: 50%;
    background: var(--pm-teal);
    box-shadow: 0 0 8px rgba(45,212,191,.25);
}

.pm-profile-activity-dot.success
{
    background: var(--pm-emerald-400);
}

.pm-profile-activity-dot.warning
{
    background: var(--pm-warning);
}

.pm-profile-activity-item strong,
.pm-profile-activity-item small
{
    display: block;
}

.pm-profile-activity-item strong
{
    color: var(--pm-text-soft);
    font-size: 9px;
}

.pm-profile-activity-item small
{
    margin-top: 3px;
    color: var(--pm-text-dim);
    font-size: 7px;
}


/* =========================================================
   DANGER
   ========================================================= */

.pm-profile-danger-card
{
    border-color: rgba(251,113,133,.12);
}

.pm-profile-danger-card p
{
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 18px 12px;
    color: var(--pm-text-dim);
    font-size: 9px;
    line-height: 1.6;
}

.pm-profile-danger-btn
{
    position: relative;
    z-index: 1;
    margin: 0 18px 18px;
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid rgba(251,113,133,.15);
    border-radius: 8px;
    background: rgba(244,63,94,.06);
    color: var(--pm-danger);
    font-size: 8px;
    font-weight: 700;
    cursor: pointer;
}


/* =========================================================
   MODAL
   ========================================================= */

.pm-profile-modal
{
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.pm-profile-modal[hidden]
{
    display: none;
}

.pm-profile-modal-backdrop
{
    position: absolute;
    inset: 0;
    background: rgba(0,7,5,.76);
    backdrop-filter: blur(8px);
}

.pm-profile-modal-panel
{
    position: relative;
    z-index: 1;
    width: min(470px,100%);
    padding: 23px;
    border: 1px solid var(--pm-border-strong);
    border-radius: 18px;
    background:
        linear-gradient(
            145deg,
            rgba(5,39,32,.98),
            rgba(1,18,15,.98)
        );
    box-shadow:
        0 30px 90px rgba(0,0,0,.48),
        0 0 45px rgba(16,185,129,.08);
    animation: profileModalIn .22s ease both;
}

.pm-profile-modal-close
{
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(255,255,255,.045);
    color: var(--pm-text-muted);
    font-size: 19px;
    cursor: pointer;
}

.pm-profile-modal-panel h2
{
    margin: 4px 0 4px;
    color: var(--pm-text);
    font-size: 19px;
}

.pm-profile-modal-panel > p
{
    margin: 0 0 18px;
    color: var(--pm-text-muted);
    font-size: 10px;
}

.pm-profile-modal-form
{
    display: grid;
    gap: 13px;
}

.pm-profile-modal-form label
{
    margin: 0;
}

.pm-profile-modal-actions
{
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 20px;
}


/* =========================================================
   TOAST
   ========================================================= */

.pm-profile-toast
{
    position: fixed;
    right: 26px;
    bottom: 25px;
    z-index: 2500;
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 190px;
    padding: 11px 13px;
    border: 1px solid rgba(52,211,153,.2);
    border-radius: 11px;
    background: rgba(2,21,18,.94);
    color: var(--pm-text-soft);
    box-shadow: 0 18px 50px rgba(0,0,0,.35);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
        opacity .2s ease,
        transform .2s ease;
}

.pm-profile-toast.show
{
    opacity: 1;
    transform: translateY(0);
}

.pm-profile-toast-icon
{
    width: 23px;
    height: 23px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(16,185,129,.1);
    color: var(--pm-emerald-400);
    font-size: 10px;
    font-weight: 800;
}

.pm-profile-toast span:last-child
{
    font-size: 9px;
    font-weight: 700;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@@keyframes profileCardIn
{
    from
    {
        opacity: 0;
        transform: translateY(8px);
    }

    to
    {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes profileModalIn
{
    from
    {
        opacity: 0;
        transform: translateY(8px) scale(.985);
    }

    to
    {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@@keyframes profilePulse
{
    0%,
    100%
    {
        opacity: 1;
        transform: scale(1);
    }

    50%
    {
        opacity: .55;
        transform: scale(.82);
    }
}


