        <div class="pm-profile-modal-backdrop"
             data-close-modal></div>

        <div class="pm-profile-modal-panel">

            <button type="button"
                    class="pm-profile-modal-close"
                    data-close-modal>
                ×
            </button>

            <div class="pm-profile-eyebrow">
                SECURITY
            </div>

            <h2>Promena lozinke</h2>

            <p>
                Nova lozinka mora zadovoljiti Identity password policy.
            </p>


            <div class="pm-profile-modal-form">

                <label>
                    Trenutna lozinka
                    <input type="password"
                           autocomplete="current-password" />
