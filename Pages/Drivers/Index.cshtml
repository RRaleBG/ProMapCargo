@page
@{
    ViewData["Title"] = "Vozači · ProMap Cargo";
}

<div class="pm-page pm-drivers-page" data-module="drivers">

    <style>
        .pm-drivers-page {
            padding: 28px 30px 34px;
            min-width: 0;
        }

        .pm-drivers-content {
            max-width: 1680px;
            margin: 0 auto;
        }

        .pm-drivers-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 24px;
        }

        .pm-drivers-heading {
            min-width: 0;
        }

        .pm-drivers-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: var(--pm-teal);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .pm-drivers-kicker-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--pm-emerald-400);
            box-shadow: 0 0 12px rgba(52, 211, 153, .55);
        }

        .pm-drivers-title {
            margin: 0;
            color: var(--pm-text);
            font-size: clamp(28px, 3vw, 38px);
            line-height: 1.08;
            font-weight: 800;
            letter-spacing: -.035em;
        }

        .pm-drivers-subtitle {
            max-width: 760px;
            margin: 10px 0 0;
            color: var(--pm-text-muted);
            font-size: 14px;
            line-height: 1.65;
        }

        .pm-drivers-header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .pm-drivers-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0 16px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-sm);
            background: var(--pm-surface);
            color: var(--pm-text-soft);
            font: inherit;
            font-size: 13px;
            font-weight: 750;
            cursor: pointer;
            transition: .18s ease;
        }

        .pm-drivers-btn:hover {
            background: var(--pm-surface-hover);
            border-color: var(--pm-border-strong);
            transform: translateY(-1px);
        }

        .pm-drivers-btn.primary {
            border-color: rgba(16, 185, 129, .45);
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ecfdf5;
            box-shadow: 0 10px 26px rgba(16, 185, 129, .16);
        }

        .pm-drivers-btn.primary:hover {
            background: linear-gradient(135deg, #34d399, #059669);
        }

        .pm-drivers-btn svg {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
        }

        .pm-drivers-kpis {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .pm-driver-kpi {
            position: relative;
            overflow: hidden;
            min-height: 132px;
            padding: 18px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background:
                radial-gradient(circle at 100% 0%, rgba(45, 212, 191, .07), transparent 42%),
                var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
        }

        .pm-driver-kpi::after {
            content: "";
            position: absolute;
            right: -26px;
            bottom: -34px;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: rgba(16, 185, 129, .035);
            pointer-events: none;
        }

        .pm-driver-kpi-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .pm-driver-kpi-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 12px;
            background: rgba(16, 185, 129, .08);
            color: var(--pm-emerald-300);
        }

        .pm-driver-kpi-icon svg {
            width: 21px;
            height: 21px;
        }

        .pm-driver-kpi-label {
            color: var(--pm-text-muted);
            font-size: 12px;
            font-weight: 700;
        }

        .pm-driver-kpi-value {
            margin-top: 12px;
            color: var(--pm-text);
            font-size: 29px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: -.025em;
        }

        .pm-driver-kpi-note {
            margin-top: 8px;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-drivers-toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px;
            margin-bottom: 18px;
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background: var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
        }

        .pm-driver-search {
            position: relative;
            flex: 1 1 auto;
            min-width: 240px;
        }

        .pm-driver-search svg {
            position: absolute;
            left: 14px;
            top: 50%;
            width: 19px;
            height: 19px;
            transform: translateY(-50%);
            color: var(--pm-text-dim);
            pointer-events: none;
        }

        .pm-driver-input,
        .pm-driver-select {
            width: 100%;
            min-height: 44px;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            outline: none;
            background: rgba(1, 13, 11, .52);
            color: var(--pm-text);
            font: inherit;
            font-size: 13px;
            transition: .18s ease;
        }

        .pm-driver-input {
            padding: 0 14px 0 44px;
        }

        .pm-driver-select {
            min-width: 170px;
            padding: 0 36px 0 13px;
        }

        .pm-driver-input::placeholder {
            color: var(--pm-text-dim);
        }

        .pm-driver-input:focus,
        .pm-driver-select:focus {
            border-color: var(--pm-border-strong);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, .08);
        }

        .pm-driver-results {
            margin-left: auto;
            padding: 0 8px;
            color: var(--pm-text-dim);
            font-size: 12px;
            white-space: nowrap;
        }

        .pm-drivers-workspace {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 370px;
            gap: 18px;
            align-items: start;
        }

        .pm-drivers-card {
            border: 1px solid var(--pm-border);
            border-radius: var(--pm-radius-lg);
            background: var(--pm-surface);
            box-shadow: var(--pm-shadow-sm);
            overflow: hidden;
        }

        .pm-drivers-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px;
            border-bottom: 1px solid var(--pm-border-soft);
        }

        .pm-drivers-card-title-wrap {
            min-width: 0;
        }

        .pm-drivers-card-title {
            margin: 0;
            color: var(--pm-text);
            font-size: 15px;
            font-weight: 800;
        }

        .pm-drivers-card-subtitle {
            margin: 4px 0 0;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-drivers-refresh {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-soft);
            cursor: pointer;
            transition: .18s ease;
        }

        .pm-drivers-refresh:hover {
            border-color: var(--pm-border-strong);
            background: var(--pm-surface-hover);
        }

        .pm-drivers-refresh svg {
            width: 19px;
            height: 19px;
        }

        .pm-drivers-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .pm-drivers-table {
            width: 100%;
            min-width: 940px;
            border-collapse: collapse;
        }

        .pm-drivers-table th {
            padding: 12px 18px;
            border-bottom: 1px solid var(--pm-border-soft);
            color: var(--pm-text-dim);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .pm-drivers-table td {
            padding: 13px 18px;
            border-bottom: 1px solid rgba(255,255,255,.035);
            color: var(--pm-text-soft);
            font-size: 12px;
            vertical-align: middle;
        }

        .pm-drivers-table tbody tr {
            cursor: pointer;
            transition: background .16s ease;
        }

        .pm-drivers-table tbody tr:hover {
            background: rgba(16, 185, 129, .045);
        }

        .pm-drivers-table tbody tr.selected {
            background: rgba(16, 185, 129, .075);
            box-shadow: inset 3px 0 0 var(--pm-emerald-400);
        }

        .pm-driver-person {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 210px;
        }

        .pm-driver-avatar {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 42px;
            border: 1px solid rgba(45, 212, 191, .22);
            border-radius: 12px;
            background: linear-gradient(145deg, rgba(16,185,129,.18), rgba(45,212,191,.06));
            color: var(--pm-emerald-200);
            font-size: 14px;
            font-weight: 800;
        }

        .pm-driver-name {
            color: var(--pm-text);
            font-size: 13px;
            font-weight: 750;
        }

        .pm-driver-meta {
            margin-top: 4px;
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-driver-cell-main {
            color: var(--pm-text-soft);
            font-weight: 650;
        }

        .pm-driver-cell-sub {
            margin-top: 4px;
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-driver-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 28px;
            padding: 0 9px;
            border: 1px solid transparent;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .pm-driver-status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .pm-driver-status.active {
            border-color: rgba(52,211,153,.18);
            background: rgba(16,185,129,.10);
            color: #6ee7b7;
        }

        .pm-driver-status.inactive {
            border-color: rgba(148,163,184,.14);
            background: rgba(148,163,184,.07);
            color: #94a3b8;
        }

        .pm-driver-status.leave {
            border-color: rgba(251,191,36,.18);
            background: rgba(245,158,11,.09);
            color: #fbbf24;
        }

        .pm-driver-status.suspended {
            border-color: rgba(251,113,133,.18);
            background: rgba(244,63,94,.09);
            color: #fb7185;
        }

        .pm-driver-gps {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--pm-text-muted);
            font-size: 11px;
            white-space: nowrap;
        }

        .pm-driver-gps-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--pm-text-dim);
        }

        .pm-driver-gps.online .pm-driver-gps-dot {
            background: var(--pm-emerald-400);
            box-shadow: 0 0 9px rgba(52,211,153,.55);
        }

        .pm-driver-gps.stale .pm-driver-gps-dot {
            background: var(--pm-warning);
        }

        .pm-driver-gps.offline .pm-driver-gps-dot {
            background: var(--pm-danger);
        }

        .pm-driver-action {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--pm-border);
            border-radius: 9px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-muted);
        }

        .pm-driver-action svg {
            width: 17px;
            height: 17px;
        }

        .pm-driver-empty,
        .pm-driver-loading,
        .pm-driver-error {
            padding: 48px 24px;
            text-align: center;
        }

        .pm-driver-empty-icon,
        .pm-driver-loading-icon,
        .pm-driver-error-icon {
            width: 52px;
            height: 52px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
            border: 1px solid var(--pm-border);
            border-radius: 15px;
            background: rgba(16,185,129,.07);
            color: var(--pm-emerald-300);
        }

        .pm-driver-empty-icon svg,
        .pm-driver-loading-icon svg,
        .pm-driver-error-icon svg {
            width: 25px;
            height: 25px;
        }

        .pm-driver-empty-title,
        .pm-driver-loading-title,
        .pm-driver-error-title {
            color: var(--pm-text);
            font-size: 14px;
            font-weight: 800;
        }

        .pm-driver-empty-text,
        .pm-driver-loading-text,
        .pm-driver-error-text {
            max-width: 440px;
            margin: 7px auto 0;
            color: var(--pm-text-dim);
            font-size: 12px;
            line-height: 1.6;
        }

        .pm-driver-details {
            position: sticky;
            top: 90px;
        }

        .pm-driver-profile {
            padding: 22px;
        }

        .pm-driver-profile-top {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .pm-driver-profile-avatar {
            width: 58px;
            height: 58px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 58px;
            border: 1px solid rgba(45,212,191,.24);
            border-radius: 16px;
            background: linear-gradient(145deg, rgba(16,185,129,.20), rgba(45,212,191,.06));
            color: var(--pm-emerald-200);
            font-size: 18px;
            font-weight: 800;
        }

        .pm-driver-profile-name {
            margin: 2px 0 0;
            color: var(--pm-text);
            font-size: 17px;
            font-weight: 800;
            line-height: 1.25;
        }

        .pm-driver-profile-meta {
            margin-top: 5px;
            color: var(--pm-text-dim);
            font-size: 11px;
        }

        .pm-driver-profile-status {
            margin-top: 9px;
        }

        .pm-driver-detail-section {
            padding: 18px 20px;
            border-top: 1px solid var(--pm-border-soft);
        }

        .pm-driver-detail-heading {
            margin: 0 0 12px;
            color: var(--pm-text);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .pm-driver-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .pm-driver-detail-item {
            min-width: 0;
            padding: 12px;
            border: 1px solid var(--pm-border-soft);
            border-radius: 11px;
            background: rgba(255,255,255,.018);
        }

        .pm-driver-detail-label {
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-driver-detail-value {
            margin-top: 5px;
            color: var(--pm-text-soft);
            font-size: 12px;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .pm-driver-operational {
            display: grid;
            gap: 9px;
        }

        .pm-driver-operation-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid rgba(255,255,255,.035);
        }

        .pm-driver-operation-row:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .pm-driver-operation-label {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--pm-text-muted);
            font-size: 11px;
        }

        .pm-driver-operation-label svg {
            width: 18px;
            height: 18px;
            color: var(--pm-text-dim);
        }

        .pm-driver-operation-value {
            color: var(--pm-text-soft);
            font-size: 11px;
            font-weight: 750;
            text-align: right;
        }

        .pm-driver-detail-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .pm-driver-detail-action {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 12px;
            border: 1px solid var(--pm-border);
            border-radius: 10px;
            background: rgba(255,255,255,.025);
            color: var(--pm-text-soft);
            font: inherit;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
        }

        .pm-driver-detail-action:hover {
            background: var(--pm-surface-hover);
            border-color: var(--pm-border-strong);
        }

        .pm-driver-detail-action svg {
            width: 17px;
            height: 17px;
        }

        .pm-drivers-footer-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-top: 14px;
            padding: 12px 14px;
            border: 1px solid var(--pm-border-soft);
            border-radius: 10px;
            background: rgba(255,255,255,.018);
            color: var(--pm-text-dim);
            font-size: 10px;
        }

        .pm-drivers-footer-info strong {
            color: var(--pm-text-muted);
            font-weight: 700;
        }

        .pm-driver-spin {
            animation: pmDriverSpin 1s linear infinite;
        }

        @@keyframes pmDriverSpin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 1250px) {
            .pm-drivers-kpis {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .pm-drivers-workspace {
                grid-template-columns: minmax(0, 1fr) 330px;
            }
        }

        @@media (max-width: 1050px) {
            .pm-drivers-workspace {
                grid-template-columns: 1fr;
            }

            .pm-driver-details {
                position: static;
            }
        }

        @@media (max-width: 800px) {
            .pm-drivers-page {
                padding: 20px 16px 28px;
            }

            .pm-drivers-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .pm-drivers-header-actions {
                width: 100%;
            }

            .pm-drivers-header-actions .pm-drivers-btn {
                flex: 1;
            }

            .pm-drivers-kpis {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .pm-drivers-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .pm-driver-search {
                min-width: 0;
            }

            .pm-driver-select {
                width: 100%;
            }

            .pm-driver-results {
                margin-left: 0;
                padding: 0 2px;
            }
        }

        @@media (max-width: 520px) {
            .pm-drivers-kpis {
                grid-template-columns: 1fr;
            }

            .pm-drivers-title {
                font-size: 27px;
            }

            .pm-driver-detail-grid {
                grid-template-columns: 1fr;
            }

            .pm-driver-detail-actions {
                grid-template-columns: 1fr;
            }

            .pm-drivers-footer-info {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

    <div class="pm-drivers-content">

        <header class="pm-drivers-header">
            <div class="pm-drivers-heading">
                <div class="pm-drivers-kicker">
                    <span class="pm-drivers-kicker-dot"></span>
                    Fleet · Vozači
                </div>

                <h1 class="pm-drivers-title">Vozači</h1>

                <p class="pm-drivers-subtitle">
                    Pregled vozača, statusa, dodeljenih vozila, aktivnih tura i poslednje GPS aktivnosti.
                </p>
            </div>

            <div class="pm-drivers-header-actions">
                <button type="button" class="pm-drivers-btn" id="refreshDrivers">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                        <path d="M3 4v6h6"></path>
                        <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                        <path d="M21 20v-6h-6"></path>
                    </svg>
                    Osveži
                </button>

                <button type="button" class="pm-drivers-btn primary" id="addDriver">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    Novi vozač
                </button>
            </div>
        </header>

        <section class="pm-drivers-kpis" aria-label="Statistika vozača">

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Ukupno vozača</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiTotal">—</div>
                <div class="pm-driver-kpi-note">registrovanih vozača</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Aktivni</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiActive">—</div>
                <div class="pm-driver-kpi-note">status Active</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Na turi</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M3 17h3"></path>
                            <path d="M18 17h3"></path>
                            <path d="M5 17V9h10l4 4v4"></path>
                            <circle cx="8" cy="17" r="2"></circle>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M15 9v4h4"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiTrips">—</div>
                <div class="pm-driver-kpi-note">imaju aktivnu turu</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">GPS online</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 2v4"></path>
                            <path d="M12 18v4"></path>
                            <path d="M2 12h4"></path>
                            <path d="M18 12h4"></path>
                            <circle cx="12" cy="12" r="4"></circle>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiGps">—</div>
                <div class="pm-driver-kpi-note">GPS signal ≤ 2 min</div>
            </article>

            <article class="pm-driver-kpi">
                <div class="pm-driver-kpi-head">
                    <span class="pm-driver-kpi-label">Van sistema</span>
                    <span class="pm-driver-kpi-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-3Z"></path>
                            <path d="M12 8v4"></path>
                            <path d="M12 16h.01"></path>
                        </svg>
                    </span>
                </div>
                <div class="pm-driver-kpi-value" id="kpiUnavailable">—</div>
                <div class="pm-driver-kpi-note">odmor ili suspendovan</div>
            </article>

        </section>

        <section class="pm-drivers-toolbar" aria-label="Filteri vozača">

            <div class="pm-driver-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                </svg>

                <input
                    id="driverSearch"
                    class="pm-driver-input"
                    type="search"
                    autocomplete="off"
                    placeholder="Pretraži ime, telefon ili broj licence..." />
            </div>

            <select id="driverStatusFilter" class="pm-driver-select" aria-label="Status vozača">
                <option value="">Svi statusi</option>
                <option value="Active">Aktivan</option>
                <option value="Inactive">Neaktivan</option>
                <option value="OnLeave">Na odmoru</option>
                <option value="Suspended">Suspendovan</option>
            </select>

            <select id="driverGpsFilter" class="pm-driver-select" aria-label="GPS status">
                <option value="">Svi GPS statusi</option>
                <option value="online">GPS online</option>
                <option value="stale">GPS zastareo</option>
                <option value="offline">GPS offline</option>
            </select>

            <div class="pm-driver-results" id="driverResults">
                Učitavanje...
            </div>

        </section>

        <section class="pm-drivers-workspace">

            <div class="pm-drivers-card">

                <div class="pm-drivers-card-head">
                    <div class="pm-drivers-card-title-wrap">
                        <h2 class="pm-drivers-card-title">Operativni spisak vozača</h2>
                        <p class="pm-drivers-card-subtitle">
                            Podaci se učitavaju iz Fleet API-ja.
                        </p>
                    </div>

                    <button
                        type="button"
                        class="pm-drivers-refresh"
                        id="refreshDriversSmall"
                        title="Osveži podatke"
                        aria-label="Osveži podatke">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M20 11a8.1 8.1 0 0 0-14.8-4L3 10"></path>
                            <path d="M3 4v6h6"></path>
                            <path d="M4 13a8.1 8.1 0 0 0 14.8 4L21 14"></path>
                            <path d="M21 20v-6h-6"></path>
                        </svg>
                    </button>
                </div>

                <div class="pm-drivers-table-wrap">

                    <table class="pm-drivers-table">
                        <thead>
                            <tr>
                                <th>Vozač</th>
                                <th>Status</th>
                                <th>Telefon</th>
                                <th>Vozilo</th>
                                <th>Tura</th>
                                <th>GPS</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="driversTableBody">
                            <tr>
                                <td colspan="7">
                                    <div class="pm-driver-loading">
                                        <div class="pm-driver-loading-icon">
                                            <svg class="pm-driver-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                <path d="M12 3a9 9 0 1 0 9 9"></path>
                                            </svg>
                                        </div>
                                        <div class="pm-driver-loading-title">Učitavanje vozača</div>
                                        <div class="pm-driver-loading-text">
                                            Preuzimanje podataka iz ProMap Cargo Fleet API-ja.
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

            <aside class="pm-drivers-card pm-driver-details" id="driverDetails">

                <div class="pm-driver-profile">
                    <div class="pm-driver-profile-top">

                        <div class="pm-driver-profile-avatar" id="detailAvatar">
                            —
                        </div>

                        <div>
                            <h2 class="pm-driver-profile-name" id="detailName">
                                Izaberite vozača
                            </h2>

                            <div class="pm-driver-profile-meta" id="detailLicense">
                                Detalji vozača će biti prikazani ovde.
                            </div>

                            <div class="pm-driver-profile-status" id="detailStatus"></div>
                        </div>

                    </div>
                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Osnovni podaci</h3>

                    <div class="pm-driver-detail-grid">

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Telefon</div>
                            <div class="pm-driver-detail-value" id="detailPhone">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Licenca</div>
                            <div class="pm-driver-detail-value" id="detailLicenseValue">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">Zemlja</div>
                            <div class="pm-driver-detail-value" id="detailCountry">—</div>
                        </div>

                        <div class="pm-driver-detail-item">
                            <div class="pm-driver-detail-label">GPS poslednji signal</div>
                            <div class="pm-driver-detail-value" id="detailGps">—</div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <h3 class="pm-driver-detail-heading">Operativni status</h3>

                    <div class="pm-driver-operational">

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M3 17h3"></path>
                                    <path d="M18 17h3"></path>
                                    <path d="M5 17V9h10l4 4v4"></path>
                                    <circle cx="8" cy="17" r="2"></circle>
                                    <circle cx="17" cy="17" r="2"></circle>
                                </svg>
                                Vozilo
                            </div>

                            <div class="pm-driver-operation-value" id="detailVehicle">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M5 4h14v16H5z"></path>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h8"></path>
                                    <path d="M8 16h5"></path>
                                </svg>
                                Aktivna tura
                            </div>

                            <div class="pm-driver-operation-value" id="detailTrip">
                                —
                            </div>
                        </div>

                        <div class="pm-driver-operation-row">
                            <div class="pm-driver-operation-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <circle cx="12" cy="12" r="8"></circle>
                                    <path d="M12 7v5l3 2"></path>
                                </svg>
                                GPS stanje
                            </div>

                            <div class="pm-driver-operation-value" id="detailGpsStatus">
                                —
                            </div>
                        </div>

                    </div>

                </div>

                <div class="pm-driver-detail-section">

                    <div class="pm-driver-detail-actions">

                        <button type="button" class="pm-driver-detail-action" id="callDriver">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.08 5.18 2 2 0 0 1 5.06 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8.96 10.73a16 16 0 0 0 4.31 4.31l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"></path>
                            </svg>
                            Pozovi
                        </button>

                        <button type="button" class="pm-driver-detail-action" id="showDriverRoute">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="6" cy="18" r="2"></circle>
                                <circle cx="18" cy="6" r="2"></circle>
                                <path d="M8 18c5 0 3-8 8-12"></path>
                            </svg>
                            Otvori turu
                        </button>

                    </div>

                </div>

            </aside>

        </section>

        <div class="pm-drivers-footer-info">
            <span>
                <strong id="lastRefreshLabel">Podaci još nisu osveženi</strong>
            </span>

            <span>
                ProMap Cargo · Fleet Management
            </span>
        </div>

    </div>

</div>

@section Scripts {
<script>
(function () {
    "use strict";

    var state = {
        drivers: [],
        vehicles: [],
        trips: [],
        selectedDriverId: null
    };

    var elements = {
        tableBody: document.getElementById("driversTableBody"),
        search: document.getElementById("driverSearch"),
        statusFilter: document.getElementById("driverStatusFilter"),
        gpsFilter: document.getElementById("driverGpsFilter"),
        results: document.getElementById("driverResults"),
        refresh: document.getElementById("refreshDrivers"),
        refreshSmall: document.getElementById("refreshDriversSmall"),
        addDriver: document.getElementById("addDriver"),

        kpiTotal: document.getElementById("kpiTotal"),
        kpiActive: document.getElementById("kpiActive"),
        kpiTrips: document.getElementById("kpiTrips"),
        kpiGps: document.getElementById("kpiGps"),
        kpiUnavailable: document.getElementById("kpiUnavailable"),

        detailAvatar: document.getElementById("detailAvatar"),
        detailName: document.getElementById("detailName"),
        detailLicense: document.getElementById("detailLicense"),
        detailLicenseValue: document.getElementById("detailLicenseValue"),
        detailStatus: document.getElementById("detailStatus"),
        detailPhone: document.getElementById("detailPhone"),
        detailCountry: document.getElementById("detailCountry"),
        detailGps: document.getElementById("detailGps"),
        detailGpsStatus: document.getElementById("detailGpsStatus"),
        detailVehicle: document.getElementById("detailVehicle"),
        detailTrip: document.getElementById("detailTrip"),

        callDriver: document.getElementById("callDriver"),
        showDriverRoute: document.getElementById("showDriverRoute"),
        lastRefreshLabel: document.getElementById("lastRefreshLabel")
    };

    function escapeHtml(value) {
        return String(value == null ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function normalizeId(value) {
        if (value == null) {
            return "";
        }

        return String(value).toLowerCase();
    }

    function getDriverStatus(driver) {
        var value = driver && driver.status;

        if (typeof value === "number") {
            return ["Active", "Inactive", "OnLeave", "Suspended"][value] || "Inactive";
        }

        return value || "Inactive";
    }

    function statusLabel(status) {
        var labels = {
            Active: "Aktivan",
            Inactive: "Neaktivan",
            OnLeave: "Na odmoru",
            Suspended: "Suspendovan"
        };

        return labels[status] || status || "Nepoznato";
    }

    function statusClass(status) {
        if (status === "Active") {
            return "active";
        }

        if (status === "OnLeave") {
            return "leave";
        }

        if (status === "Suspended") {
            return "suspended";
        }

        return "inactive";
    }

    function getGpsState(driver) {
        if (!driver || !driver.lastGpsAt) {
            return "offline";
        }

        var timestamp = new Date(driver.lastGpsAt).getTime();

        if (!Number.isFinite(timestamp)) {
            return "offline";
        }

        var ageMinutes = (Date.now() - timestamp) / 60000;

        if (ageMinutes <= 2) {
            return "online";
        }

        if (ageMinutes <= 15) {
            return "stale";
        }

        return "offline";
    }

    function gpsLabel(gpsState) {
        if (gpsState === "online") {
            return "Online";
        }

        if (gpsState === "stale") {
            return "Zastareo";
        }

        return "Offline";
    }

    function formatDate(value) {
        if (!value) {
            return "—";
        }

        var date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return "—";
        }

        return new Intl.DateTimeFormat("sr-Latn-RS", {
            dateStyle: "short",
            timeStyle: "short"
        }).format(date);
    }

    function getInitials(name) {
        var parts = String(name || "?")
            .trim()
            .split(/\s+/)
            .filter(Boolean);

        if (!parts.length) {
            return "?";
        }

        if (parts.length === 1) {
            return parts[0].substring(0, 2).toUpperCase();
        }

        return (
            parts[0].substring(0, 1) +
            parts[parts.length - 1].substring(0, 1)
        ).toUpperCase();
    }

    function getVehicle(driver) {
        var id = normalizeId(driver && driver.currentVehicleId);

        if (!id) {
            return null;
        }

        for (var i = 0; i < state.vehicles.length; i++) {
            if (normalizeId(state.vehicles[i].id) === id) {
                return state.vehicles[i];
            }
        }

        return null;
    }

    function getTrip(driver) {
        var id = normalizeId(driver && driver.currentTripId);

        if (!id) {
            return null;
        }

        for (var i = 0; i < state.trips.length; i++) {
            if (normalizeId(state.trips[i].id) === id) {
                return state.trips[i];
            }
        }

        return null;
    }

    function vehicleLabel(driver) {
        var vehicle = getVehicle(driver);

        if (!vehicle) {
            return "Nije dodeljeno";
        }

        var registration = vehicle.registration || "Bez registracije";
        var makeModel = [vehicle.make, vehicle.model]
            .filter(Boolean)
            .join(" ");

        if (makeModel) {
            return registration + " · " + makeModel;
        }

        return registration;
    }

    function tripLabel(driver) {
        var trip = getTrip(driver);

        if (!trip) {
            return "Nema aktivne ture";
        }

        var status = trip.executionState;

        if (typeof status === "number") {
            status = [
                "Planirano",
                "Dodeljeno",
                "Spremno",
                "Utovar",
                "Utovareno",
                "U transportu",
                "Prilaz stopu",
                "Na stopu",
                "Čekanje",
                "Prelaz granice",
                "Istovar",
                "Završeno",
                "Otkazano",
                "Suspendovano"
            ][status] || "Aktivna tura";
        }

        return status || "Aktivna tura";
    }

    function setLoading(isLoading) {
        if (!elements.refresh) {
            return;
        }

        if (isLoading) {
            elements.refresh.disabled = true;
            elements.refreshSmall.disabled = true;
        } else {
            elements.refresh.disabled = false;
            elements.refreshSmall.disabled = false;
        }
    }

    function updateKpis() {
        var total = state.drivers.length;
        var active = 0;
        var trips = 0;
        var gpsOnline = 0;
        var unavailable = 0;

        state.drivers.forEach(function (driver) {
            var status = getDriverStatus(driver);
            var gps = getGpsState(driver);

            if (status === "Active") {
                active++;
            }

            if (driver.currentTripId) {
                trips++;
            }

            if (gps === "online") {
                gpsOnline++;
            }

            if (status === "OnLeave" || status === "Suspended") {
                unavailable++;
            }
        });

        elements.kpiTotal.textContent = total;
        elements.kpiActive.textContent = active;
        elements.kpiTrips.textContent = trips;
        elements.kpiGps.textContent = gpsOnline;
        elements.kpiUnavailable.textContent = unavailable;
    }

    function filteredDrivers() {
        var search = String(elements.search.value || "")
            .trim()
            .toLowerCase();

        var status = elements.statusFilter.value;
        var gpsFilter = elements.gpsFilter.value;

        return state.drivers.filter(function (driver) {
            var driverStatus = getDriverStatus(driver);
            var gps = getGpsState(driver);

            if (status && driverStatus !== status) {
                return false;
            }

            if (gpsFilter && gps !== gpsFilter) {
                return false;
            }

            if (!search) {
                return true;
            }

            var haystack = [
                driver.fullName,
                driver.phone,
                driver.licenseNumber
            ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

            return haystack.indexOf(search) !== -1;
        });
    }

    function renderTable() {
        var drivers = filteredDrivers();

        elements.results.textContent =
            drivers.length +
            " od " +
            state.drivers.length +
            " vozača";

        if (!drivers.length) {
            elements.tableBody.innerHTML =
                '<tr>' +
                    '<td colspan="7">' +
                        '<div class="pm-driver-empty">' +
                            '<div class="pm-driver-empty-icon">' +
                                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">' +
                                    '<circle cx="11" cy="11" r="7"></circle>' +
                                    '<path d="m20 20-4-4"></path>' +
                                '</svg>' +
                            '</div>' +
                            '<div class="pm-driver-empty-title">Nema rezultata</div>' +
                            '<div class="pm-driver-empty-text">' +
                                'Nijedan vozač ne odgovara izabranim filterima.' +
                            '</div>' +
                        '</div>' +
                    '</td>' +
                '</tr>';

            return;
        }

        elements.tableBody.innerHTML = drivers.map(function (driver) {
            var id = normalizeId(driver.id);
            var status = getDriverStatus(driver);
            var gps = getGpsState(driver);
            var vehicle = getVehicle(driver);
            var trip = getTrip(driver);

            var vehicleText = vehicle
                ? escapeHtml(vehicle.registration || "Vozilo")
                : "Nije dodeljeno";

            var tripText = trip
                ? escapeHtml(tripLabel(driver))
                : "Nema aktivne ture";

            var selected = normalizeId(state.selectedDriverId) === id;

            return (
                '<tr class="' + (selected ? "selected" : "") + '" data-driver-id="' + escapeHtml(id) + '">' +

                    '<td>' +
                        '<div class="pm-driver-person">' +
                            '<div class="pm-driver-avatar">' +
                                escapeHtml(getInitials(driver.fullName)) +
                            '</div>' +
                            '<div>' +
                                '<div class="pm-driver-name">' +
                                    escapeHtml(driver.fullName || "Bez imena") +
                                '</div>' +
                                '<div class="pm-driver-meta">' +
                                    escapeHtml(driver.licenseNumber || "Licenca nije uneta") +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</td>' +

                    '<td>' +
                        '<span class="pm-driver-status ' + statusClass(status) + '">' +
                            '<span class="pm-driver-status-dot"></span>' +
                            escapeHtml(statusLabel(status)) +
                        '</span>' +
                    '</td>' +

                    '<td>' +
                        '<div class="pm-driver-cell-main">' +
                            escapeHtml(driver.phone || "—") +
                        '</div>' +
                    '</td>' +

                    '<td>' +
                        '<div class="pm-driver-cell-main">' +
                            vehicleText +
                        '</div>' +
                        '<div class="pm-driver-cell-sub">' +
                            (vehicle ? escapeHtml(vehicle.make || "") : "Bez dodele") +
                        '</div>' +
                    '</td>' +

                    '<td>' +
                        '<div class="pm-driver-cell-main">' +
                            tripText +
                        '</div>' +
                    '</td>' +

                    '<td>' +
                        '<span class="pm-driver-gps ' + gps + '">' +
                            '<span class="pm-driver-gps-dot"></span>' +
                            escapeHtml(gpsLabel(gps)) +
                        '</span>' +
                    '</td>' +

                    '<td>' +
                        '<span class="pm-driver-action">' +
                            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">' +
                                '<path d="m9 18 6-6-6-6"></path>' +
                            '</svg>' +
                        '</span>' +
                    '</td>' +

                '</tr>'
            );
        }).join("");

        Array.prototype.forEach.call(
            elements.tableBody.querySelectorAll("[data-driver-id]"),
            function (row) {
                row.addEventListener("click", function () {
                    selectDriver(row.getAttribute("data-driver-id"));
                });
            }
        );
    }

    function findDriver(id) {
        var normalized = normalizeId(id);

        for (var i = 0; i < state.drivers.length; i++) {
            if (normalizeId(state.drivers[i].id) === normalized) {
                return state.drivers[i];
            }
        }

        return null;
    }

    function selectDriver(id) {
        var driver = findDriver(id);

        if (!driver) {
            return;
        }

        state.selectedDriverId = driver.id;

        var status = getDriverStatus(driver);
        var gps = getGpsState(driver);
        var vehicle = getVehicle(driver);
        var trip = getTrip(driver);

        elements.detailAvatar.textContent = getInitials(driver.fullName);
        elements.detailName.textContent = driver.fullName || "Bez imena";

        elements.detailLicense.textContent =
            driver.licenseNumber
                ? "Vozačka licenca · " + driver.licenseNumber
                : "Vozačka licenca nije uneta";

        elements.detailLicenseValue.textContent =
            driver.licenseNumber || "Nije uneto";

        elements.detailPhone.textContent =
            driver.phone || "Nije uneto";

        elements.detailCountry.textContent =
            driver.currentCountryCode || "—";

        elements.detailGps.textContent =
            formatDate(driver.lastGpsAt);

        elements.detailStatus.innerHTML =
            '<span class="pm-driver-status ' +
                statusClass(status) +
            '">' +
                '<span class="pm-driver-status-dot"></span>' +
                escapeHtml(statusLabel(status)) +
            '</span>';

        elements.detailVehicle.textContent =
            vehicle
                ? (vehicle.registration || "Vozilo")
                : "Nije dodeljeno";

        elements.detailTrip.textContent =
            trip
                ? tripLabel(driver)
                : "Nema aktivne ture";

        elements.detailGpsStatus.textContent =
            gpsLabel(gps);

        elements.callDriver.disabled = !driver.phone;
        elements.showDriverRoute.disabled = !driver.currentTripId;

        renderTable();
    }

    function renderError(message) {
        elements.tableBody.innerHTML =
            '<tr>' +
                '<td colspan="7">' +
                    '<div class="pm-driver-error">' +
                        '<div class="pm-driver-error-icon">' +
                            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">' +
                                '<path d="M12 9v4"></path>' +
                                '<path d="M12 17h.01"></path>' +
                                '<path d="M10.3 3.8 2.8 17a2 2 0 0 0 1.75 3h14.9a2 2 0 0 0 1.75-3L13.7 3.8a2 2 0 0 0-3.4 0Z"></path>' +
                            '</svg>' +
                        '</div>' +
                        '<div class="pm-driver-error-title">Podaci nisu dostupni</div>' +
                        '<div class="pm-driver-error-text">' +
                            escapeHtml(message || "Fleet API nije vratio podatke.") +
                        '</div>' +
                    '</div>' +
                '</td>' +
            '</tr>';

        elements.results.textContent = "Greška";
    }

    async function fetchJson(url) {
        var response = await fetch(url, {
            method: "GET",
            headers: {
                "Accept": "application/json"
            },
            credentials: "same-origin",
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error(
                "HTTP " +
                response.status +
                " · " +
                url
            );
        }

        return await response.json();
    }

    async function loadDrivers() {
        setLoading(true);

        try {
            var result = await Promise.all([
                fetchJson("/api/business/drivers"),
                fetchJson("/api/business/vehicles"),
                fetchJson("/api/business/trips")
            ]);

            state.drivers = Array.isArray(result[0]) ? result[0] : [];
            state.vehicles = Array.isArray(result[1]) ? result[1] : [];
            state.trips = Array.isArray(result[2]) ? result[2] : [];

            updateKpis();

            if (
                !state.selectedDriverId ||
                !findDriver(state.selectedDriverId)
            ) {
                if (state.drivers.length) {
                    state.selectedDriverId = state.drivers[0].id;
                }
            }

            renderTable();

            if (state.selectedDriverId) {
                selectDriver(state.selectedDriverId);
            }

            elements.lastRefreshLabel.textContent =
                "Poslednje osvežavanje: " +
                formatDate(new Date().toISOString());

        } catch (error) {
            console.error("Drivers page error:", error);

            state.drivers = [];
            state.vehicles = [];
            state.trips = [];

            elements.kpiTotal.textContent = "—";
            elements.kpiActive.textContent = "—";
            elements.kpiTrips.textContent = "—";
            elements.kpiGps.textContent = "—";
            elements.kpiUnavailable.textContent = "—";

            renderError(
                "Nije moguće učitati podatke sa /api/business/drivers. " +
                "Proverite prijavu korisnika i dostupnost Fleet API-ja."
            );
        } finally {
            setLoading(false);
        }
    }

    elements.search.addEventListener("input", renderTable);
    elements.statusFilter.addEventListener("change", renderTable);
    elements.gpsFilter.addEventListener("change", renderTable);

    elements.refresh.addEventListener("click", loadDrivers);
    elements.refreshSmall.addEventListener("click", loadDrivers);

    elements.addDriver.addEventListener("click", function () {
        window.location.href = "/drivers/new";
    });

    elements.callDriver.addEventListener("click", function () {
        var driver = findDriver(state.selectedDriverId);

        if (!driver || !driver.phone) {
            return;
        }

        window.location.href = "tel:" + driver.phone;
    });

    elements.showDriverRoute.addEventListener("click", function () {
        var driver = findDriver(state.selectedDriverId);

        if (!driver || !driver.currentTripId) {
            return;
        }

        window.location.href =
            "/trips?tripId=" +
            encodeURIComponent(driver.currentTripId);
    });

    loadDrivers();

})();
</script>
}