@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? "ProMap Cargo";
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#031c18" />
    <meta name="application-name" content="ProMap Cargo" />
    <title>@pageTitle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/compat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="pm-body">
    <input type="checkbox" id="pm-sidebar-toggle" class="pm-sidebar-toggle-input" aria-hidden="true" />

    <div class="pm-app-shell">
        <label for="pm-sidebar-toggle" class="pm-mobile-backdrop" aria-label="Zatvori navigaciju"></label>

        <aside class="pm-sidebar">
            <div class="pm-sidebar-inner">
                <div class="pm-brand-block">
                    <a asp-page="/Dispatch/Index" class="pm-brand" aria-label="ProMap Cargo Command Center">
                        <span class="pm-brand-mark"><span></span><span></span><span></span></span>
                        <span class="pm-brand-copy">
                            <strong>ProMap</strong>
                            <b>Cargo</b>
                            <small>SMART FLEET OPERATIONS</small>
                        </span>
                    </a>
                    <label for="pm-sidebar-toggle" class="pm-sidebar-close" aria-label="Zatvori meni">×</label>
                </div>

                <div class="pm-sidebar-status">
                    <span class="pm-status-dot"></span>
                    <span>Sistem operativan</span>
                    <strong>LIVE</strong>
                </div>

                <nav class="pm-navigation" aria-label="Glavna navigacija">
                    <div class="pm-nav-section">
                        <div class="pm-nav-section-title">OPERACIJE</div>
                        <a asp-page="/Dispatch/Index" class="pm-nav-item @(currentPage == "/Dispatch/Index" ? "active" : "")"><span class="pm-nav-icon">◈</span><span class="pm-nav-label">Dispatch</span></a>
                        <a asp-page="/Orders/Index" class="pm-nav-item @(currentPage == "/Orders/Index" ? "active" : "")"><span class="pm-nav-icon">▤</span><span class="pm-nav-label">Transportni nalozi</span></a>
                        <a asp-page="/Trips/Index" class="pm-nav-item @(currentPage == "/Trips/Index" ? "active" : "")"><span class="pm-nav-icon">↗</span><span class="pm-nav-label">Ture</span></a>
                    </div>

                    <div class="pm-nav-section">
                        <div class="pm-nav-section-title">FLEET</div>
                        <a asp-page="/Vehicles/Index" class="pm-nav-item @(currentPage == "/Vehicles/Index" || currentPage == "/Vehicles/New" ? "active" : "")"><span class="pm-nav-icon">▣</span><span class="pm-nav-label">Vozila</span></a>
                        <a asp-page="/Drivers/Index" class="pm-nav-item @(currentPage == "/Drivers/Index" ? "active" : "")"><span class="pm-nav-icon">♙</span><span class="pm-nav-label">Vozači</span></a>
                        <a asp-page="/Navigation/Index" class="pm-nav-item @(currentPage == "/Navigation/Index" ? "active" : "")"><span class="pm-nav-icon">◎</span><span class="pm-nav-label">Navigacija</span><span class="pm-nav-live">GPS</span></a>
                    </div>

                    <div class="pm-nav-section">
                        <div class="pm-nav-section-title">KONTROLA</div>
                        <a asp-page="/Alerts/Index" class="pm-nav-item @(currentPage == "/Alerts/Index" ? "active" : "")"><span class="pm-nav-icon">△</span><span class="pm-nav-label">Alerts</span><span class="pm-nav-count danger" data-alert-count hidden>0</span></a>
                        <a asp-page="/Moderation/Index" class="pm-nav-item @(currentPage == "/Moderation/Index" ? "active" : "")"><span class="pm-nav-icon">◌</span><span class="pm-nav-label">Moderacija</span></a>
                        <a asp-page="/Audit/Index" class="pm-nav-item @(currentPage == "/Audit/Index" ? "active" : "")"><span class="pm-nav-icon">◇</span><span class="pm-nav-label">Audit</span></a>
                        <a asp-page="/Compliance/Index" class="pm-nav-item @(currentPage == "/Compliance/Index" ? "active" : "")"><span class="pm-nav-icon">◈</span><span class="pm-nav-label">Compliance</span></a>
                        <a asp-page="/Monitoring/Index" class="pm-nav-item @(currentPage == "/Monitoring/Index" ? "active" : "")"><span class="pm-nav-icon">◉</span><span class="pm-nav-label">Monitoring</span></a>
                    </div>

                    <div class="pm-nav-section">
                        <div class="pm-nav-section-title">ANALITIKA</div>
                        <a asp-page="/Finance/Index" class="pm-nav-item @(currentPage == "/Finance/Index" ? "active" : "")"><span class="pm-nav-icon">₿</span><span class="pm-nav-label">Finansije</span></a>
                        <a asp-page="/Reports/Index" class="pm-nav-item @(currentPage == "/Reports/Index" ? "active" : "")"><span class="pm-nav-icon">▥</span><span class="pm-nav-label">Izveštaji</span></a>
                    </div>

                    <div class="pm-nav-section">
                        <div class="pm-nav-section-title">SISTEM</div>
                        <a asp-page="/Settings/Index" class="pm-nav-item @(currentPage == "/Settings/Index" ? "active" : "")"><span class="pm-nav-icon">⚙</span><span class="pm-nav-label">Podešavanja</span></a>
                        <a asp-page="/Profile/Index" class="pm-nav-item @(currentPage == "/Profile/Index" ? "active" : "")"><span class="pm-nav-icon">◯</span><span class="pm-nav-label">Profil</span></a>
                        <a asp-page="/Admin/Index" class="pm-nav-item @(currentPage == "/Admin/Index" ? "active" : "")"><span class="pm-nav-icon">⚙</span><span class="pm-nav-label">Administracija</span></a>
                    </div>
                </nav>

                <div class="pm-sidebar-footer">
                    <div class="pm-sidebar-version">
                        <span class="pm-brand-mini"><span></span><span></span><span></span></span>
                        <div><strong>ProMap Cargo</strong><small>Fleet Intelligence Platform</small></div>
                    </div>
                    <div class="pm-sidebar-footer-line"><span>v1.0.0</span><span>·</span><span>PostGIS</span><span>·</span><span>OSM</span></div>
                </div>
            </div>
        </aside>

        <div class="pm-main">
            <header class="pm-topbar">
                <div class="pm-topbar-left">
                    <label for="pm-sidebar-toggle" class="pm-menu-button" aria-label="Otvori navigaciju"><span></span><span></span><span></span></label>
                    <div class="pm-breadcrumb"><span>ProMap Cargo</span><i>/</i><strong>@pageTitle</strong></div>
                </div>

                <div class="pm-topbar-center">
                    <div class="pm-global-search">
                        <span class="pm-search-icon">⌕</span>
                        <input type="search" placeholder="Pretraga vozila, vozača, naloga, lokacija..." aria-label="Globalna pretraga" />
                        <kbd>Ctrl K</kbd>
                    </div>
                </div>

                <div class="pm-topbar-right">
                    <div class="pm-system-indicator"><span class="pm-status-dot"></span><span>Sistem online</span></div>
                    <a asp-page="/Alerts/Index" class="pm-topbar-action pm-notification" aria-label="Obaveštenja">
                        <span class="pm-notification-icon">♢</span>
                        <span class="pm-notification-badge" data-alert-count hidden>0</span>
                    </a>
                    <a asp-page="/Profile/Index" class="pm-user">
                        <span class="pm-user-avatar">MP</span>
                        <span class="pm-user-copy"><strong>Administrator</strong><small>Fleet Operations</small></span>
                        <span class="pm-user-chevron">⌄</span>
                    </a>
                </div>
            </header>

            <main class="pm-content">
                <div class="pm-content-inner">@RenderBody()</div>
            </main>

            <footer class="pm-footer">
                <div class="pm-footer-left">
                    <span class="pm-footer-brand"><span class="pm-brand-mini"><span></span><span></span><span></span></span>ProMap Cargo</span>
                    <span class="pm-footer-separator">•</span><span>Smart Fleet Operations</span>
                </div>
                <div class="pm-footer-right">
                    <span><i></i>PostgreSQL</span><span><i></i>PostGIS</span><span><i></i>OSM</span><span><i></i>Routing</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" defer></script>

    <script src="~/js/core/dom.js" asp-append-version="true" defer></script>
    <script src="~/js/core/events.js" asp-append-version="true" defer></script>
    <script src="~/js/core/http.js" asp-append-version="true" defer></script>
    <script src="~/js/core/format.js" asp-append-version="true" defer></script>
    <script src="~/js/core/validation.js" asp-append-version="true" defer></script>
    <script src="~/js/core/toast.js" asp-append-version="true" defer></script>
    <script src="~/js/core/modal.js" asp-append-version="true" defer></script>
    <script src="~/js/core/compat.js" asp-append-version="true" defer></script>
    <script src="~/js/services/alerts.js" asp-append-version="true" defer></script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
